{
  "version": 1,
  "routes": [
    {
      "id": "workflow-evals",
      "include": ["scripts/run-workflow-evals.mjs", "scripts/lib/workflow-evals.mjs", "evals/**", "tests/workflow-evals.test.mjs"],
      "commands": [
        ["node", "--test", "tests/workflow-evals.test.mjs"],
        ["node", "scripts/run-workflow-evals.mjs", "--dry-run"]
      ]
    },
    {
      "id": "verification-router",
      "include": ["scripts/verify-affected.mjs", "tests/verify-affected.test.mjs", ".pi/verification.json"],
      "commands": [
        ["node", "--test", "tests/verify-affected.test.mjs"]
      ]
    },
    {
      "id": "safety-guard",
      "include": [".pi/extensions/safety-guard.js", ".mcp.json", "scripts/pi-sandbox.sh", "tests/safety-guard.test.mjs"],
      "commands": [
        ["node", "--test", "tests/safety-guard.test.mjs"]
      ]
    },
    {
      "id": "launcher",
      "include": ["p", "scripts/pi-sandbox.sh", "tests/launcher.test.mjs"],
      "commands": [
        ["node", "--test", "tests/launcher.test.mjs"]
      ]
    },
    {
      "id": "project-contract",
      "include": [
        "docs/PRODUCT.md",
        "docs/ARCHITECTURE.md",
        "docs/QUALITY.md",
        "docs/PLAN.md",
        "docs/DESIGN.md",
        "docs/Noveno_Website_Master_Spec.md",
        "docs/Noveno Business DNA.md",
        "branding_assests/**",
        ".env.example",
        "README.md",
        "scripts/project-verify.sh",
        "scripts/check-project-contract.mjs",
        "tests/project-contract.test.mjs"
      ],
      "commands": [
        ["bash", "scripts/project-verify.sh"],
        ["node", "--test", "tests/project-contract.test.mjs"]
      ]
    },
    {
      "id": "workflow-contract",
      "include": ["AGENTS.md", ".mcp.json", ".pi/**", ".github/**", "p", "package.json", "*.md", "docs/**", "scripts/*.sh", "scripts/verify-package-integrity.mjs", "Dockerfile.pi", ".dockerignore", "tests/gate-order.test.mjs"],
      "commands": [
        ["bash", "scripts/pi-doctor.sh", "--ci", "--static"],
        ["node", "--test", "tests/gate-order.test.mjs"]
      ]
    },
    {
      "id": "app",
      "include": ["src/**", "package.json", "package-lock.json", "astro.config.mjs", "tsconfig.json", "wrangler.jsonc", "public/**", "tests/structural.test.mjs", "tests/seo-contract.test.mjs", "tests/content.test.mjs", "tests/audit-retry.test.mjs", "tests/insights.test.mjs"],
      "commands": [
        ["npm", "run", "check"],
        ["npm", "run", "build"],
        ["node", "--test", "tests/structural.test.mjs"],
        ["node", "--test", "tests/seo-contract.test.mjs"],
        ["node", "--test", "tests/content.test.mjs"],
        ["node", "--test", "tests/audit-retry.test.mjs"],
        ["node", "--test", "tests/insights.test.mjs"]
      ]
    },
    {
      "id": "functions",
      "include": ["functions/**", "supabase/**", "tests/audit-function.test.mjs", "tests/supabase-contract.test.mjs"],
      "commands": [
        ["npm", "run", "check"],
        ["node", "--test", "tests/audit-function.test.mjs"],
        ["node", "--test", "tests/supabase-contract.test.mjs"],
        ["npm", "run", "build"]
      ]
    }
  ],
  "fallback": [
    ["bash", "scripts/verify.sh"]
  ]
}
