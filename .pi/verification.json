{
  "version": 1,
  "routes": [
    {
      "id": "pr-delivery",
      "include": ["scripts/ai-pr.mjs", "tests/ai-pr.test.mjs", "docs/GIT_POLICY.md"],
      "commands": [["node", "--test", "tests/ai-pr.test.mjs"]]
    },
    {
      "id": "workflow-evals",
      "include": ["scripts/run-workflow-evals.mjs", "scripts/lib/workflow-evals.mjs", "scripts/lib/eval-isolation.mjs", "tests/eval-isolation.test.mjs", "evals/**", "tests/workflow-evals.test.mjs"],
      "commands": [
        ["node", "--test", "tests/workflow-evals.test.mjs", "tests/eval-isolation.test.mjs"],
        ["node", "scripts/run-workflow-evals.mjs", "--dry-run"]
      ]
    },
    {
      "id": "verification-router",
      "include": ["scripts/verify-affected.mjs", "tests/verify-affected.test.mjs", ".pi/verification.json"],
      "commands": [
        ["node", "--test", "tests/verify-affected.test.mjs"]
      ]
    },
    {
      "id": "safety-guard",
      "include": [".pi/extensions/safety-guard.js", ".mcp.json", "scripts/pi-sandbox.sh", "tests/safety-guard.test.mjs"],
      "commands": [
        ["node", "--test", "tests/safety-guard.test.mjs"]
      ]
    },
    {
      "id": "harness-runtime",
      "include": [".pi/extensions/harness-runtime.js", ".pi/models.env", "tests/harness-runtime.test.mjs"],
      "commands": [
        ["node", "--test", "tests/harness-runtime.test.mjs"]
      ]
    },
    {
      "id": "launcher",
      "include": ["p", ".pi/models.env", "scripts/pi-sandbox.sh", "tests/launcher.test.mjs"],
      "commands": [
        ["node", "--test", "tests/launcher.test.mjs"]
      ]
    },
    {
      "id": "workflow-contract",
      "include": ["AGENTS.md", ".mcp.json", ".pi/**", ".github/**", "p", "*.md", "docs/**", "scripts/*.sh", "scripts/verify-package-integrity.mjs", "Dockerfile.pi", ".dockerignore", "tests/gate-order.test.mjs", "tests/lane-coverage.test.mjs"],
      "commands": [
        ["bash", "scripts/pi-doctor.sh", "--ci", "--static"],
        ["node", "--test", "tests/gate-order.test.mjs"],
        ["node", "--test", "tests/lane-coverage.test.mjs"]
      ]
    },
    {
      "id": "project-contract",
      "include": ["docs/PRODUCT.md", "docs/ARCHITECTURE.md", "docs/QUALITY.md", "docs/PLAN.md", "docs/DESIGN.md", "docs/Noveno_Website_Master_Spec.md", "docs/Noveno Business DNA.md", "branding_assests/**", ".env.example", "README.md", "scripts/project-verify.sh", "scripts/check-project-contract.mjs", "tests/project-contract.test.mjs"],
      "commands": [
        ["bash", "scripts/project-verify.sh"],
        ["node", "--test", "tests/project-contract.test.mjs"]
      ]
    },
    {
      "id": "project-context",
      "include": ["scripts/validate-project-context.mjs", "scripts/validate-skill-evals.mjs", "tests/context-readiness.test.mjs", "tests/skill-contract.test.mjs", "evals/skill-cases.json", "docs/PROJECT_CONTEXT.md", ".pi/skills/accessibility-audit/SKILL.md", ".pi/skills/web-performance/SKILL.md", ".pi/skills/technical-seo/SKILL.md", ".pi/skills/rtl-i18n/SKILL.md"],
      "commands": [
        ["node", "--test", "tests/context-readiness.test.mjs", "tests/skill-contract.test.mjs"],
        ["node", "scripts/validate-skill-evals.mjs"],
        ["node", "scripts/validate-project-context.mjs", "--static"]
      ]
    },
    {
      "id": "skill-contracts",
      "include": [".pi/skills/test-design/SKILL.md", ".pi/prompts/test.md", "tests/test-design-contract.test.mjs", ".pi/skills/quick-fix/SKILL.md", "tests/quick-fix-skill.test.mjs"],
      "commands": [
        ["node", "--test", "tests/test-design-contract.test.mjs", "tests/quick-fix-skill.test.mjs"]
      ]
    },
    {
      "id": "app",
      "include": ["src/**", "package.json", "package-lock.json", "astro.config.mjs", "tsconfig.json", "wrangler.jsonc", "public/**", "scripts/build-image-manifest.mjs", "scripts/generate-sitemap.mjs", "scripts/validate-og-assets.mjs", "tests/structural.test.mjs", "tests/seo-contract.test.mjs", "tests/content.test.mjs", "tests/audit-retry.test.mjs", "tests/blog.test.mjs", "tests/og-assets.test.mjs", "tests/site-data.test.mjs", "tests/client-modules.test.mjs", "tests/validation-equivalence.test.mjs", "tests/image-manifest.test.mjs", "tests/sitemap-parser.test.mjs", "tests/work-filter.test.mjs"],
      "commands": [
        ["npm", "run", "check"],
        ["npm", "run", "build"],
        ["node", "--test", "tests/structural.test.mjs"],
        ["node", "--test", "tests/seo-contract.test.mjs"],
        ["node", "--test", "tests/content.test.mjs"],
        ["node", "--test", "tests/audit-retry.test.mjs"],
        ["node", "--test", "tests/blog.test.mjs"],
        ["node", "--test", "tests/og-assets.test.mjs"],
        ["node", "--test", "tests/site-data.test.mjs"],
        ["node", "--test", "tests/client-modules.test.mjs"],
        ["node", "--test", "tests/validation-equivalence.test.mjs"],
        ["node", "--test", "tests/image-manifest.test.mjs"],
        ["node", "--test", "tests/sitemap-parser.test.mjs"],
        ["node", "--test", "tests/work-filter.test.mjs"]
      ]
    },
    {
      "id": "functions",
      "include": ["functions/**", "tests/audit-function.test.mjs", "tests/audit-email-spike.test.mjs"],
      "commands": [
        ["npm", "run", "check"],
        ["node", "--test", "tests/audit-function.test.mjs"],
        ["node", "--test", "tests/audit-email-spike.test.mjs"],
        ["npm", "run", "build"]
      ]
    }
  ],
  "fallback": [
    ["bash", "scripts/verify.sh"]
  ]
}
