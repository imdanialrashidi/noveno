---
/**
 * SystemArchitectureDiagram — how channels, pages, forms, tracking and
 * follow-up connect (DESIGN §15 screen 3, Spec §21.6 case-study
 * template; 2026-08-14 redesign). Replaced the small dot-grid SVG with
 * the large route grammar: a channel entry row (attention dots →
 * single gate square) + the JourneyLine route + the dashed learning
 * loop-back note. Informative → sr-only description; visual is
 * aria-hidden; all labels are HTML text at route scale.
 */

import JourneyLine, { type JourneyStation } from "./JourneyLine.astro";

interface Props {
  id: string;
  channels?: readonly string[];
  gate?: string;
  stations?: readonly string[];
  description?: string;
}

const {
  id,
  channels = ["اینستاگرام", "گوگل", "معرفی", "تبلیغ"],
  gate = "صفحه / فرم",
  stations = ["ثبت لید", "پیگیری", "گزارش"],
  description = "کانال‌های ورودی از یک صفحه یا فرم عبور می‌کنند، لید ثبت می‌شود، پیگیری می‌شود و گزارش به بهبود مسیر برمی‌گردد.",
} = Astro.props;

const routeStations: readonly JourneyStation[] = stations.map((s) => ({ label: s }));
---

<figure class="panel px-6 py-8 sm:px-10 lg:px-12 lg:py-10">
  <figcaption class="sr-only">{description}</figcaption>

  <!-- entry row: attention dots → single gate -->
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-line pb-5" aria-hidden="true">
    <span class="text-meta text-text-faint">ورودی:</span>
    {channels.map((channel) => (
      <span class="flex items-center gap-1.5 text-ui text-text-muted">
        <span class="h-2 w-2 rounded-full bg-accent-strong"></span>
        {channel}
      </span>
    ))}
    <svg viewBox="0 0 24 24" class="h-4 w-4 text-line-strong" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12h14" />
      <path d="m12 5 7 7-7 7" />
    </svg>
    <span class="flex items-center gap-1.5 text-ui font-semibold text-text">
      <span class="h-2.5 w-2.5 flex-none rounded-[1px] bg-primary"></span>
      {gate}
    </span>
  </div>

  <div class="mt-8">
    <JourneyLine stations={routeStations} label={description} />
  </div>

  <p class="mt-8 flex items-center gap-2 text-meta text-text-faint" aria-hidden="true">
    <span class="h-1.5 w-1.5 flex-none rounded-[1px] border border-dashed border-line-strong"></span>
    یادگیری ← بهبود: گزارش‌ها به اصلاح مسیر برمی‌گردند.
  </p>
</figure>
