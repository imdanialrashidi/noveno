---
/**
 * ChannelMap — نقشه کانالها (DESIGN §4.1 pattern 3).
 * Channels as labeled dots (attention, circles) converging through a
 * single gate (square = system) into the route. Inline SVG, static
 * markup, RTL flow (route runs right→left). Used in the hero diagram
 * and the system-model section (§11.5, §15 screens 1 + 3).
 *
 * Two static renderings so labels hold the §4.2 12–13px size at both
 * required viewports: a horizontal desktop composition (viewBox 500,
 * renders ≤ 500px → labels ≈ 12–13px) and a vertical mobile
 * composition (viewBox 340, renders ≈ 340px at 390/320 → ≥ 12px).
 * The hero variant draws the route once on load (pure CSS).
 *
 * Geometry (§4.2): 5px dots, 16px square gate, 2px monoline, hollow
 * stations transparent (the route line passes through them), 24px
 * dot-grid well. Informative diagram → aria-hidden + adjacent text
 * equivalent (the figure's sr-only paragraph is the single announcement).
 */

interface Props {
  id: string;
  channels: readonly string[];
  gate: string;
  /** Stations after the gate (route continues leftwards). */
  stations: readonly string[];
  /** Accessible description (read by assistive tech). */
  description: string;
  /** Hero variant: route draws itself once on load (§12.1), pure CSS. */
  animate?: boolean;
}

const { id, channels, gate, stations, description, animate = false } = Astro.props;

/* Desktop composition */
const DW = 420;
const DH = 300;
const DLINE_Y = 150;
const DGATE_X = 340;
// Station x positions derived from the station count (RTL: gate → left).
const dStationXs = Array.from(
  { length: stations.length },
  (_, i) => DGATE_X - 92 - i * (252 / Math.max(stations.length, 1)),
);

/* Mobile composition (vertical spine) */
const MW = 340;
const MH = 470;
const MGATE_X = 166;
const MGATE_Y = 168;
const mStationYs = Array.from(
  { length: stations.length },
  (_, i) => 206 + i * 68,
);
---

<figure>
  <p class="sr-only">{description}</p>

  <!-- Desktop: horizontal, right→left -->
  <svg
    viewBox={`0 0 ${DW} ${DH}`}
    class="hidden h-auto w-full max-w-[420px] lg:block"
    aria-hidden="true"
    focusable="false"
  >
    <!-- connector curves: dots → gate -->
    {channels.map((channel, i) => {
      const dotY = 40 + i * ((DH - 80) / Math.max(channels.length - 1, 1));
      const dotX = DW - 60;
      return (
        <path
          d={`M ${dotX - 10} ${dotY} C ${dotX - 60} ${dotY}, ${DGATE_X + 36} ${dotY}, ${DGATE_X + 14} ${DLINE_Y}`}
          fill="none"
          stroke="var(--line-strong)"
          stroke-width="1.5"
          class={animate ? "jl-fade" : undefined}
          style={animate ? { animationDelay: `${0.15 + i * 0.1}s` } : undefined}
        />
      );
    })}

    <!-- attention dots (circles = attention, §4.2) -->
    {channels.map((channel, i) => {
      const dotY = 40 + i * ((DH - 80) / Math.max(channels.length - 1, 1));
      const dotX = DW - 60;
      return (
        <g key={channel} class={animate ? "jl-fade" : undefined} style={animate ? { animationDelay: `${0.15 + i * 0.1}s` } : undefined}>
          <circle cx={dotX} cy={dotY} r="5" fill="var(--accent)" />
          <text
            x={dotX - 16}
            y={dotY + 4}
            text-anchor="end"
            font-size="13"
            font-family="var(--font-display)"
            font-weight="500"
            fill="var(--text-muted)"
          >
            {channel}
          </text>
        </g>
      );
    })}

    <!-- gate: single square the attention converges into -->
    <g class={animate ? "jl-fade" : undefined} style={animate ? { animationDelay: "0.55s" } : undefined}>
      <rect x={DGATE_X - 8} y={DLINE_Y - 8} width="16" height="16" rx="1" fill="var(--primary)" />
      <text
        x={DGATE_X - 20}
        y={DLINE_Y + 4}
        text-anchor="end"
        font-size="13"
        font-family="var(--font-display)"
        font-weight="600"
        fill="var(--text)"
      >
        {gate}
      </text>
    </g>

    <!-- the route: right→left monoline through square stations -->
    <path
      d={`M ${DGATE_X + 12} ${DLINE_Y} L ${dStationXs[dStationXs.length - 1] - 16} ${DLINE_Y}`}
      fill="none"
      stroke="var(--line-strong)"
      stroke-width="2"
      pathLength="1"
      class={animate ? "jl-draw" : undefined}
    />
    {dStationXs.map((x, i) => {
      const isLast = i === stations.length - 1;
      return (
        <g class={animate ? "jl-fade" : undefined} style={animate ? { animationDelay: `${0.55 + i * 0.15}s` } : undefined}>
          <rect
            x={x - 6}
            y={DLINE_Y - 6}
            width="12"
            height="12"
            rx="1"
            fill={isLast ? "var(--primary)" : "transparent"}
            stroke={isLast ? "none" : "var(--line-strong)"}
            stroke-width="1.5"
          />
          <text
            x={x}
            y={DLINE_Y + 30}
            text-anchor="middle"
            font-size="13"
            font-family="var(--font-display)"
            font-weight="500"
            fill={isLast ? "var(--text)" : "var(--text-muted)"}
          >
            {stations[i]}
          </text>
        </g>
      );
    })}
  </svg>

  <!-- Mobile: vertical spine -->
  <svg
    viewBox={`0 0 ${MW} ${MH}`}
    class="h-auto w-full max-w-[340px] lg:hidden"
    aria-hidden="true"
    focusable="false"
  >
    <!-- channels in two rows -->
    {channels.map((channel, i) => {
      const col = i % 2;
      const row = Math.floor(i / 2);
      const x = 60 + col * 170;
      const y = 40 + row * 40;
      return (
        <g class={animate ? "jl-fade" : undefined} style={animate ? { animationDelay: `${0.55 + i * 0.15}s` } : undefined}>
          <circle cx={x} cy={y} r="5" fill="var(--accent)" />
          <text
            x={x + 12}
            y={y + 4}
            text-anchor="start"
            font-size="14"
            font-family="var(--font-display)"
            font-weight="500"
            fill="var(--text-muted)"
          >
            {channel}
          </text>
        </g>
      );
    })}

    <!-- convergence into the gate -->
    <path d="M 104 66 C 104 110, 120 130, 156 142" fill="none" stroke="var(--line-strong)" stroke-width="1.5" class={animate ? "jl-fade" : undefined} style={animate ? { animationDelay: "0.35s" } : undefined} />
    <path d="M 240 50 C 230 96, 200 124, 164 138" fill="none" stroke="var(--line-strong)" stroke-width="1.5" class={animate ? "jl-fade" : undefined} style={animate ? { animationDelay: "0.45s" } : undefined} />
    <path d="M 94 106 C 110 130, 130 138, 152 144" fill="none" stroke="var(--line-strong)" stroke-width="1.5" class={animate ? "jl-fade" : undefined} style={animate ? { animationDelay: "0.35s" } : undefined} />
    <path d="M 268 90 C 240 110, 200 128, 170 140" fill="none" stroke="var(--line-strong)" stroke-width="1.5" class={animate ? "jl-fade" : undefined} style={animate ? { animationDelay: "0.45s" } : undefined} />

    <!-- gate -->
    <g class={animate ? "jl-fade" : undefined} style={animate ? { animationDelay: "0.55s" } : undefined}>
      <rect x={MGATE_X - 8} y={MGATE_Y - 8} width="16" height="16" rx="1" fill="var(--primary)" />
      <text
        x={MGATE_X - 18}
        y={MGATE_Y + 4}
        text-anchor="end"
        font-size="14"
        font-family="var(--font-display)"
        font-weight="600"
        fill="var(--text)"
      >
        {gate}
      </text>
    </g>

    <!-- vertical route -->
    <path
      d={`M ${MGATE_X} ${MGATE_Y + 10} L ${MGATE_X} ${mStationYs[mStationYs.length - 1] + 16}`}
      fill="none"
      stroke="var(--line-strong)"
      stroke-width="2"
      pathLength="1"
      class={animate ? "jl-draw" : undefined}
    />
    {mStationYs.map((y, i) => {
      const isLast = i === stations.length - 1;
      return (
        <g class={animate ? "jl-fade" : undefined} style={animate ? { animationDelay: `${0.55 + i * 0.15}s` } : undefined}>
          <rect
            x={MGATE_X - 6}
            y={y}
            width="12"
            height="12"
            rx="1"
            fill={isLast ? "var(--primary)" : "transparent"}
            stroke={isLast ? "none" : "var(--line-strong)"}
            stroke-width="1.5"
          />
          <text
            x={MGATE_X - 18}
            y={y + 10}
            text-anchor="end"
            font-size="14"
            font-family="var(--font-display)"
            font-weight="500"
            fill={isLast ? "var(--text)" : "var(--text-muted)"}
          >
            {stations[i]}
          </text>
        </g>
      );
    })}
  </svg>
</figure>
