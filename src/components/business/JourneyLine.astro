---
/**
 * JourneyLine — مسیر (DESIGN §4.1 pattern 1, 2026-08-14 redesign).
 * The signature route grammar at scale: a full-width monoline with
 * large square stations (22px nodes, 2px line, 15–18px HTML labels).
 * Desktop: horizontal route with the line passing through the nodes;
 * mobile: vertical spine with labels beside nodes. Square = system
 * station; solid = real/current, dashed = demo/future (§4.2–4.3).
 *
 * Accessible name via a visually-hidden ordered list; the visual route
 * is aria-hidden and mirrors that list. No SVG text anywhere — labels
 * are real HTML text at readable sizes on every viewport.
 */

export interface JourneyStation {
  label: string;
  description?: string;
  /** Filled (primary) station — current/active stage. */
  active?: boolean;
}

interface Props {
  stations: readonly JourneyStation[];
  /** solid = real/current; dashed = demo/recommended/future. */
  variant?: "solid" | "dashed";
  /** Process loop-back arrow after the last station. */
  loop?: boolean;
  /** Descriptive accessible name for the route. */
  label: string;
  /** Compact variant — small inline motif (footer mini route only). */
  compact?: boolean;
}

const { stations, variant = "solid", loop = false, label, compact = false } = Astro.props;

const lineClass =
  variant === "dashed"
    ? "border-dashed border-line-strong"
    : "border-solid border-line-strong";

const nodeClass = (active: boolean | undefined) =>
  active
    ? "route-node route-node--filled"
    : variant === "dashed"
      ? "route-node route-node--dashed"
      : "route-node";

const labelClass = (active: boolean | undefined) =>
  active ? "route-label text-text-action" : "route-label";
---

<div class={compact ? "" : "w-full"}>
  <ol class="sr-only">
    {stations.map((station) => (
      <li>{station.label}{station.description ? ` — ${station.description}` : ""}</li>
    ))}
    {loop && <li>بازگشت به ابتدای چرخه</li>}
  </ol>

  {compact ? (
    <div class="flex flex-wrap items-center gap-y-1.5" aria-hidden="true">
      {stations.map((station, index) => (
        <div class="contents">
          <div class="flex items-center gap-1.5">
            <span
              class:list={[
                "h-2.5 w-2.5 flex-none rounded-[1px]",
                station.active ? "bg-primary" : variant === "dashed" ? "border border-dashed border-line-strong" : "border border-line-strong",
              ]}
            ></span>
            <span class:list={["font-display font-medium leading-tight text-meta", station.active ? "text-text-action" : "text-text-muted"]}>
              {station.label}
            </span>
          </div>
          {index < stations.length - 1 && (
            <span class:list={["mx-2 h-0 w-6 border-t-2", lineClass]}></span>
          )}
        </div>
      ))}
      {loop && (
        <span class="ms-2 text-line-strong" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 3-6.7" />
            <path d="M3 4v5h5" />
          </svg>
        </span>
      )}
    </div>
  ) : (
    <>
      {/* Desktop — horizontal route, 22px nodes, line behind them */}
      <div class="hidden lg:block" aria-hidden="true">
        <div class="relative">
          <span
            class:list={[
              "absolute inset-x-0 top-[11px] h-0 border-t-2",
              lineClass,
            ]}
          ></span>
          <div class="relative flex items-start justify-between gap-4">
            {stations.map((station) => (
              <div class="route-station">
                <span class={nodeClass(station.active)}></span>
                <span class={labelClass(station.active)}>{station.label}</span>
              </div>
            ))}
            {loop && (
              <span class="mt-1 flex-none text-line-strong" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 12a9 9 0 1 0 3-6.7" />
                  <path d="M3 4v5h5" />
                </svg>
              </span>
            )}
          </div>
        </div>
      </div>

      {/* Mobile — vertical spine, segments between stations */}
      <div class="lg:hidden" aria-hidden="true">
        <div class="flex flex-col items-start">
          {stations.map((station, index) => (
            <div class="contents">
              <div class="flex items-center gap-3">
                <span class={nodeClass(station.active)}></span>
                <span class={labelClass(station.active)}>{station.label}</span>
              </div>
              {index < stations.length - 1 && (
                <span class:list={["ms-[10px] my-1.5 h-7 w-0 border-s-2", lineClass]}></span>
              )}
            </div>
          ))}
          {loop && (
            <span class="ms-[10px] mt-1.5 text-line-strong" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12a9 9 0 1 0 3-6.7" />
                <path d="M3 4v5h5" />
              </svg>
            </span>
          )}
        </div>
      </div>
    </>
  )}
</div>
