---
/**
 * NextStepsRail — what happens after a request (Spec §33, DESIGN §11
 * thank-you; 2026-08-14 redesign). Four steps as full-width horizontal
 * rows: numbered chip beside the text, hairline-separated — a clean
 * numbered sequence, no connectors. Used on /contact, the thank-you
 * page, and the final CTA section so the primary conversion has no
 * dead end.
 */

import { toFaDigits } from "../../data/site";

const STEPS = [
  "درخواست بررسی می‌شود.",
  "اگر همکاری مناسب باشد، Noveno تماس می‌گیرد.",
  "یک گفت‌وگوی کوتاه برای فهم دقیق‌تر مسئله انجام می‌شود.",
  "در صورت نیاز، Scope و پیشنهاد همکاری ارائه می‌شود.",
] as const;
---

<ol class="flex flex-col">
  {
    STEPS.map((step, index) => (
      <li class="flex items-center gap-4 border-t border-line py-4 sm:gap-5">
        <span
          class="flex h-7 w-7 flex-none items-center justify-center rounded-[1px] bg-primary-soft text-ui font-semibold text-accent-strong tnum"
          aria-hidden="true"
        >
          {toFaDigits(index + 1)}
        </span>
        <p class="text-body text-text-muted">{step}</p>
      </li>
    ))
  }
</ol>
