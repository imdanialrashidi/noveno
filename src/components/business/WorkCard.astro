---
/**
 * WorkRow — editorial work-list entry (2026-08-14 founder redesign).
 * Large real previews are the proof: the real project shows a real
 * screenshot of the delivered product; concepts show a designed mock
 * labeled «نمونه نمایشی». Rows alternate image/text alignment on
 * desktop. No stock imagery, no invented results.
 */

import ProofTag, { type ProofKind } from "../ui/ProofTag.astro";
import ConceptPreview from "./ConceptPreview.astro";

export interface WorkPreview {
  type: "image" | "concept";
  /** Image preview (real project screenshots only). */
  src?: string;
  srcset?: string;
  alt?: string;
  /** Concept mock layout id: "form" | "course". */
  layout?: "form" | "course";
  /** Concept scenario short description (sr-only). */
  scenario?: string;
}

interface Props {
  kind: ProofKind;
  title: string;
  summary: string;
  meta: string;
  href: string;
  /** Honest outcome line (project/concept semantics). */
  outcome?: string;
  preview: WorkPreview;
  /** Larger treatment for the featured entry. */
  featured?: boolean;
  /** Alternate image/text alignment (desktop). */
  flip?: boolean;
}

const { kind, title, summary, meta, href, outcome, preview, featured = false, flip = false } = Astro.props;

const openEvent =
  kind === "case-study" ? "case_study_opened" : kind === "project" ? "project_opened" : null;
const slug = href.split("/").filter(Boolean).pop() ?? "";

const textOrder = flip ? "lg:order-2" : "lg:order-1";
const mediaOrder = flip ? "lg:order-1" : "lg:order-2";
/* RTL: the first grid track is the RIGHT column. DOM is text-first, so
   with flip=false the text sits right (track 1) and media left (track 2);
   the featured row gives the 7fr track to the media. */
const cols = featured
  ? flip
    ? "lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]"
    : "lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]"
  : "lg:grid-cols-[minmax(0,6fr)_minmax(0,6fr)]";
---

<article class="group border-t border-line py-10 lg:py-14">
  <div class:list={["grid items-center gap-8 lg:gap-14", cols]}>
    <!-- text -->
    <div class:list={["flex flex-col items-start gap-3", textOrder]}>
      <div class="flex flex-wrap items-center gap-3">
        <ProofTag kind={kind} />
        <span class="text-meta text-text-faint">{meta}</span>
      </div>
      <h3 class:list={["text-text", featured ? "text-h2" : "text-h3"]}>{title}</h3>
      <p class="text-body text-text-muted measure-prose">{summary}</p>
      {outcome && (
        <span class="mt-1 inline-flex items-center gap-2 text-meta text-text-faint">
          <span class="h-1.5 w-1.5 flex-none rounded-full bg-line-strong" aria-hidden="true"></span>
          {outcome}
        </span>
      )}
      <a
        href={href}
        class="mt-3 inline-flex min-h-11 items-center gap-1.5 text-ui font-medium text-accent-strong transition-colors duration-150 hover:text-text-action"
        {...(openEvent
          ? {
              "data-event": openEvent,
              "data-event-payload": JSON.stringify({ slug }),
            }
          : {})}
      >
        مشاهده کار
        <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform duration-150 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5" />
          <path d="m12 19-7-7 7-7" />
        </svg>
      </a>
    </div>

    <!-- preview -->
    <div class:list={["preview-stage", mediaOrder]}>
      {preview.type === "image" && preview.src && (
        <img
          src={preview.src}
          srcset={preview.srcset}
          sizes="(min-width: 1024px) 660px, 92vw"
          width="1440"
          height="900"
          loading="lazy"
          decoding="async"
          alt={preview.alt ?? title}
          class="transition-transform duration-300 ease-standard group-hover:scale-[1.015]"
        />
      )}
      {preview.type === "concept" && (
        <>
          <p class="sr-only">
            {preview.scenario ?? "نمایش طراحی سناریوی مفهومی — بدون اجرا و بدون داده عملکردی"}
          </p>
          <ConceptPreview layout={preview.layout ?? "form"} />
          <span class="preview-tag">نمونه نمایشی — سناریوی مفهومی</span>
        </>
      )}
    </div>
  </div>
</article>
