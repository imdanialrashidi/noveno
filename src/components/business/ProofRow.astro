---
/**
 * ProofRow — the work-list row with its line-style code (DESIGN §4.3,
 * §8: "proof is a list of rows with line-style codes").
 *  case-study → solid line + filled square + «مطالعه موردی»
 *  project    → solid line + hollow square + «پروژه»
 *  concept    → dashed line + hollow square + «نمونه نمایشی»
 * The code column is a vertical route segment that fills on hover —
 * meaning carried by line style + label, never color alone.
 */

import ProofTag, { type ProofKind } from "../ui/ProofTag.astro";

interface Props {
  kind: ProofKind;
  title: string;
  summary: string;
  meta: string;
  href: string;
  /** Honest outcome line (project/concept semantics). */
  outcome?: string;
}

const { kind, title, summary, meta, href, outcome } = Astro.props;

// Acquisition-event wiring (Spec §36): real work types map to their
// event; concepts are labeled demos and fire nothing.
const openEvent =
  kind === "case-study" ? "case_study_opened" : kind === "project" ? "project_opened" : null;
const slug = href.split("/").filter(Boolean).pop() ?? "";

const code = {
  "case-study": {
    node: "bg-primary",
    line: "bg-primary",
  },
  project: {
    node: "bg-transparent border border-line-strong group-hover:border-primary",
    line: "bg-line-strong group-hover:bg-primary",
  },
  concept: {
    node: "bg-transparent border border-dashed border-line-strong group-hover:border-primary",
    line: "[background-image:repeating-linear-gradient(to_bottom,var(--line-strong)_0_6px,transparent_6px_10px)]",
  },
}[kind];
---

<a
  href={href}
  class="group grid grid-cols-[24px_1fr] gap-x-4 gap-y-2 border-t border-line py-6 transition-colors duration-150 hover:bg-surface-soft/40 focus-visible:bg-surface-soft/40 sm:grid-cols-[24px_1fr_auto] sm:items-start lg:gap-x-6 lg:py-8"
  {...(openEvent
    ? {
        "data-event": openEvent,
        "data-event-payload": JSON.stringify({ slug }),
      }
    : {})}
>
  <!-- line-style code column -->
  <span class="relative flex h-full min-h-16 w-6 justify-center" aria-hidden="true">
    <span class:list={["absolute inset-y-0 w-[2px]", code.line]}></span>
    <span class:list={["absolute top-1 mt-0 h-3 w-3 rounded-[1px]", code.node]}></span>
  </span>

  <span class="flex flex-col gap-2">
    <span class="flex flex-wrap items-center gap-3">
      <ProofTag kind={kind} />
      <span class="text-caption text-text-faint">{meta}</span>
    </span>
    <span class="text-h3 text-text transition-colors duration-150 group-hover:text-text-action">
      {title}
    </span>
    <span class="text-body text-text-muted">{summary}</span>
    {outcome && (
      <span class="flex items-center gap-2 text-caption text-text-faint">
        <span class="h-1.5 w-1.5 flex-none rounded-[1px] border border-dashed border-line-strong" aria-hidden="true"></span>
        {outcome}
      </span>
    )}
  </span>

  <span class="col-start-2 flex items-center gap-1.5 text-ui font-medium text-accent-strong sm:col-start-3">
    مشاهده
    <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform duration-150 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 12H5" />
      <path d="m12 19-7-7 7-7" />
    </svg>
  </span>
</a>
