---
/**
 * OfferRow — one of the three core offers as a hairline-separated route
 * row (DESIGN §8: "offers are three hairline-separated route rows").
 * Square node = system station; hover fills the node. No cards, no pills.
 */

import type { Offer } from "../../data/site";

interface Props {
  offer: Offer;
  href: string;
}

const { offer, href } = Astro.props;
---

<article class="group border-t border-line py-8 lg:py-10">
  <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,4fr)_minmax(0,3fr)] lg:gap-10">
    <div class="flex flex-col gap-3">
      <div class="flex items-center gap-3">
        <span
          class="h-2 w-2 flex-none rounded-[1px] border border-line-strong bg-transparent transition-colors duration-150 group-hover:bg-primary"
          aria-hidden="true"
        ></span>
        <h3 class="text-h3 text-text">{offer.name}</h3>
      </div>
      <p class="text-body text-text-muted measure-prose">{offer.summary}</p>
    </div>

    <ul class="flex flex-col gap-2">
      {offer.points.map((point) => (
        <li class="flex items-start gap-2.5 text-body text-text">
          <span class="mt-2.5 h-1 w-1 flex-none rounded-[1px] bg-line-strong" aria-hidden="true"></span>
          {point}
        </li>
      ))}
    </ul>

    <div class="flex flex-col items-start gap-4 lg:pt-1">
      <p class="text-caption text-text-faint">{offer.framing}</p>
      <a
        href={href}
        class="inline-flex min-h-11 items-center gap-1.5 text-ui font-medium text-accent-strong transition-colors duration-150 hover:text-text-action"
        data-event="service_opened"
        data-event-payload={JSON.stringify({ service: offer.id })}
      >
        مشاهده جزئیات
        <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform duration-150 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5" />
          <path d="m12 19-7-7 7-7" />
        </svg>
      </a>
    </div>
  </div>
</article>
