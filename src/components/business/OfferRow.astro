---
/**
 * OfferRow — one of the three core offers as an editorial row
 * (2026-08-14 founder redesign): large numeral ۰۱–۰۳, offer name,
 * summary, points, framing + CTA. No cards, no pills, no graph marks.
 */

import type { Offer } from "../../data/site";
import { toFaDigits } from "../../data/site";
import ArrowLink from "../ui/ArrowLink.astro";

interface Props {
  offer: Offer;
  href: string;
  index: number;
}

const { offer, href, index } = Astro.props;
---

<article class="group border-t border-line py-8 lg:py-12" data-reveal-item={index}>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,4fr)_minmax(0,3fr)] lg:gap-10">
    <div class="flex flex-col gap-3">
      <span class="editorial-num" aria-hidden="true">{toFaDigits(String(index + 1).padStart(2, "0"))}</span>
      <h3 class="text-h3 text-text">{offer.name}</h3>
      <p class="text-body text-text-muted measure-prose">{offer.summary}</p>
    </div>

    <ul class="flex flex-col gap-2">
      {offer.points.map((point) => (
        <li class="flex items-start gap-2.5 text-body text-text">
          <span class="mt-2.5 h-1 w-1 flex-none rounded-full bg-line-strong" aria-hidden="true"></span>
          {point}
        </li>
      ))}
    </ul>

    <div class="flex flex-col items-start gap-4 lg:pt-1">
      <p class="text-meta text-text-faint">{offer.framing}</p>
      <ArrowLink
        href={href}
        label={offer.id === "audit" ? "شروع با بررسی مسیر جذب" : "جزئیات همکاری"}
        data={{ "data-event": "service_opened", "data-event-payload": JSON.stringify({ service: offer.id }) }}
      />
    </div>
  </div>
</article>
