---
/**
 * OfferRow — one of the three core offers as an editorial row
 * (2026-08-14 founder redesign; 2026-10 focus pass adds the public
 * تومان starting price). Large numeral ۰۱–۰۳, offer name, starting
 * price, summary, scope points, framing + CTA. No cards, no pills, no
 * fake scarcity: the recommended tier is marked with one quiet
 * typographic label only (docs/DESIGN.md §0).
 */

import type { Offer } from "../../data/site";
import { toFaDigits } from "../../data/site";
import ArrowLink from "../ui/ArrowLink.astro";

interface Props {
  offer: Offer;
  href: string;
  index: number;
  /** Link label; defaults to a short, action-shaped phrase per offer. */
  ctaLabel?: string;
  /** Hide the price when the surrounding page already shows it. */
  showPrice?: boolean;
  /**
   * Compact row — numeral, name, starting price, framing and the link.
   * The scope points and the price note are `/pricing` detail, so the
   * homepage (which keeps the founder-accepted starting prices) does not
   * repeat them (DESIGN §16.1 item 6).
   */
  compact?: boolean;
}

const { offer, href, index, ctaLabel, showPrice = true, compact = false } = Astro.props;
const label = ctaLabel ?? (offer.id === "landing" ? "شروع با یک صفحه" : "جزئیات این بسته");
---

<!-- Registration layer (DESIGN §12): the row's opening rule is drawn in
     from the inline start; the recommended tier keeps its 2px primary
     rule. The `--sweep-weight` is presentation-only — the rule itself is
     plain markup. -->
<article
  class:list={["group border-t border-line py-8 lg:py-10", offer.recommended && "border-t-2 border-primary"]}
  style={offer.recommended ? "--sweep-weight: 2px" : undefined}
  data-reveal-item={index}
  data-sweep
>
  <div
    class:list={[
      "grid gap-6",
      compact
        ? "lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-baseline lg:gap-10"
        : "lg:grid-cols-[minmax(0,5fr)_minmax(0,4fr)_minmax(0,3fr)] lg:gap-10",
    ]}
  >
    <div class="flex flex-col gap-3">
      <div class="flex items-baseline gap-3">
        <span class="editorial-num" aria-hidden="true">{toFaDigits(String(index + 1).padStart(2, "0"))}</span>
        {offer.recommended && <span class="text-caption font-semibold text-text-action">پیشنهاد نوونو</span>}
      </div>
      <h3 class="text-h3 text-text">{offer.name}</h3>
      {
        showPrice && (
          <p class="text-data text-xl text-text tnum lg:text-2xl">
            <span class="sr-only">قیمت: </span>
            {offer.price}
          </p>
        )
      }
      {!compact && <p class="text-body text-text-muted measure-prose">{offer.summary}</p>}
    </div>

    {
      !compact && (
        <div class="flex flex-col gap-4">
          <ul class="flex flex-col gap-2">
            {offer.points.map((point) => (
              <li class="flex items-start gap-2.5 text-body text-text">
                <span class="mt-2.5 h-1 w-1 flex-none rounded-full bg-line-strong" aria-hidden="true" />
                {point}
              </li>
            ))}
          </ul>
          {showPrice && offer.priceNote && (
            <p class="border-t border-line pt-3 text-meta text-text-faint">{offer.priceNote}</p>
          )}
        </div>
      )
    }

    <div class="flex flex-col items-start gap-4 lg:pt-1">
      <p class="text-meta text-text-faint">{offer.framing}</p>
      <ArrowLink
        href={href}
        label={label}
        data={{ "data-event": "service_opened", "data-event-payload": JSON.stringify({ service: offer.id }) }}
      />
    </div>
  </div>
</article>
