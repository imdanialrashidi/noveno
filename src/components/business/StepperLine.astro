---
import { toFaDigits } from "../../data/site";

/**
 * AuditProgress — audit progress (2026-08-14 founder redesign).
 * The station/rail diagram was removed by founder decision; progress
 * is now a clean typographic system: «مرحله ۳ از ۶» + the current step
 * name + a simple horizontal progress bar. No connectors, no nodes.
 *
 * The component renders the build-time `current` state; the /audit
 * page script (src/scripts/audit.ts) re-drives state through the
 * `data-stepper-counter` / `data-stepper-current` / `data-stepper-bar`
 * hooks (names kept for script compatibility). The bar fills by
 * completed steps; the live step name sits beside the counter.
 */

export interface Step {
  id: string;
  label: string;
}

interface Props {
  steps: readonly Step[];
  current: number; // 1-based index of the current step
  totalLabel?: string;
}

const { steps, current, totalLabel = "مرحله" } = Astro.props;
const progress = Math.round(((current - 1) / steps.length) * 100);
---

<div class="w-full">
  <p class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <span class="text-ui font-semibold text-text">
      <span data-stepper-counter>
        {totalLabel}
        {toFaDigits(current)} از {toFaDigits(steps.length)}
      </span>
    </span>
    <span class="text-caption text-text-faint" data-stepper-current>{steps[current - 1]?.label}</span>
  </p>
  <span class="progress-track mt-2.5" aria-hidden="true">
    <span class="progress-fill" data-stepper-bar style={`width: ${progress}%`}></span>
  </span>
</div>
