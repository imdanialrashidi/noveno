---
import { toFaDigits } from "../../data/site";

/**
 * StepperLine — audit progress (DESIGN §11, Spec §31).
 * Stations ۱–۶ with names, RTL. Desktop: horizontal line with
 * complete = filled square + check, current = primary outline,
 * upcoming = dashed. Mobile: compact «مرحله ۳ از ۶» + thin progress
 * bar (no tiny tap targets).
 *
 * The component renders the build-time `current` state; the /audit
 * page script (src/scripts/audit.ts) re-drives state by flipping the
 * `data-state` attribute on each station (complete|current|upcoming)
 * and the mobile counter/bar. State styling lives in global.css
 * (`.stepper-*`), keeping one visual contract for both renderers.
 */

export interface Step {
  id: string;
  label: string;
}

interface Props {
  steps: readonly Step[];
  current: number; // 1-based index of the current step
  totalLabel?: string;
}

const { steps, current, totalLabel = "مرحله" } = Astro.props;
const progress = Math.round(((current - 1) / steps.length) * 100);
---

<div class="w-full">
  <!-- Desktop: horizontal route with station names -->
  <ol class="hidden items-center lg:flex" aria-label="مراحل بررسی مسیر جذب">
    {steps.map((step, index) => {
      const number = index + 1;
      const state = number < current ? "complete" : number === current ? "current" : "upcoming";
      return (
        <li
          class="stepper-station flex flex-1 items-center"
          data-stepper-station={number}
          data-state={state}
        >
          <span class="flex flex-col items-center gap-1.5">
            <span class="stepper-node flex h-6 w-6 items-center justify-center rounded-[1px]" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="stepper-check h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5" />
              </svg>
            </span>
            <span class="stepper-label text-caption font-medium">{step.label}</span>
          </span>
          {index < steps.length - 1 && (
            <span class="stepper-connector mx-2 h-0 flex-1 border-t-2 border-dashed border-line-strong" aria-hidden="true"></span>
          )}
        </li>
      );
    })}
  </ol>

  <!-- Mobile: compact stage counter + thin progress bar.
       No role=status here: the page owns the single aria-live step
       announcement (#step-announce) so mobile users are not double-
       announced (reviewer finding). -->
  <div class="lg:hidden">
    <p class="mb-2 flex items-baseline justify-between text-caption">
      <span class="font-medium text-text-muted">
        <span data-stepper-counter>
          {totalLabel} {toFaDigits(current)} از {toFaDigits(steps.length)}
        </span>
      </span>
      <span class="text-text-faint" data-stepper-current>{steps[current - 1]?.label}</span>
    </p>
    <span class="block h-0.5 w-full overflow-hidden rounded-[1px] bg-line" aria-hidden="true">
      <span class="block h-full rounded-[1px] bg-primary transition-[width] duration-250" data-stepper-bar style={`width: ${progress}%`}></span>
    </span>
  </div>
</div>
