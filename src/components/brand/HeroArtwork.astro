<style>
  /* The artwork is the hero's visual field: it owns the left column at
     full width, no margin bleed, no raster. The ambient grid lives on
     the hero section (global.css `.hero-field`). */
  .hero-art {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Rotations and settle transforms are CSS-only (transform-box: fill-box
     makes rotate() pivot on each mark's own center — not the viewBox
     origin). Values live in inline custom properties per mark. */
  .hero-art-mark {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Signals quietly finding structure: from scattered offset to the
     aligned final position (one shot, staggered). The final frame IS
     the natural state — no-JS and reduced-motion see it instantly. */
  .hero-art-settle {
    transform-box: fill-box;
    transform-origin: center;
    animation: hero-settle 1000ms var(--ease-standard) var(--d, 200ms) both;
  }
  @keyframes hero-settle {
    from {
      transform: translate(var(--dx, 0px), var(--dy, 0px)) rotate(var(--dr, 0deg));
    }
    to {
      transform: translate(0, 0) rotate(0deg);
    }
  }

  /* The plate materializes once, quietly (structure already exists in
     the frame; only its surface settles in). */
  .hero-art-plate {
    animation: hero-plate 700ms var(--ease-standard) 250ms both;
  }
  @keyframes hero-plate {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
