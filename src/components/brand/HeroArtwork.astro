  <g mask="url(#hp-mask)" opacity="0.45">
    <rect x="0" y="0" width="600" height="600" fill="url(#hp-grid)"></rect>
  </g>

  <!-- 2. Core layer (structure) — subtle pointer parallax, same direction -->
