         would dim the mask in dark mode and change the grid's fade. -->
    <linearGradient id="hp-fade" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="1"></stop>
      <stop offset="0.52" stop-color="#fff" stop-opacity="0.85"></stop>
      <stop offset="0.78" stop-color="#fff" stop-opacity="0"></stop>
