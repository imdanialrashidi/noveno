---
/**
 * Footer (2026-08-14 founder redesign) — contact facts always visible
 * (click-to-call, WhatsApp/Telegram/email — redundancy is a
 * requirement, Spec §64.1); privacy/terms links. The miniature route
 * motif was removed with the flowchart grammar.
 */

import Logo from "../brand/Logo.astro";
import ChannelLink from "../ui/ChannelLink.astro";
import { CONTACT, jalaliYear } from "../../data/site";

const year = jalaliYear();
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-[1200px] px-5 py-12 sm:px-8 lg:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
      <div class="flex flex-col gap-6">
        <a href="/" class="inline-flex w-fit text-text" aria-label="نوونو NOVENO — صفحه اصلی">
          <Logo size="lg" />
        </a>
        <p class="text-body text-text-muted measure-prose">
          نوونو برای کسب‌وکارهای خدماتی، مسیر مشتری را از دیدن شما تا تماس، ثبت درخواست و پیگیری طراحی و اجرا
          می‌کند.
        </p>
        <p class="text-meta text-text-faint">سیستم جذب مشتری — با شواهد، بدون وعده فروش تضمینی.</p>
      </div>

      <div class="grid gap-8 sm:grid-cols-2">
        <nav aria-label="دسترسی سریع">
          <p class="mb-3 text-caption text-text-faint">صفحات</p>
          <ul class="flex flex-col">
            {
              [
                { href: "/services", label: "خدمات" },
                { href: "/work", label: "پروژه‌ها" },
                { href: "/blog", label: "وبلاگ" },
                { href: "/process", label: "فرآیند" },
                { href: "/about", label: "درباره" },
                { href: "/contact", label: "تماس" },
              ].map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-flex min-h-10 items-center text-ui text-text-muted transition-colors duration-150 hover:text-text-action"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div>
          <p class="mb-3 text-caption text-text-faint">تماس مستقیم</p>
          <ul class="flex flex-col gap-0.5">
            <li>
              <ChannelLink
                icon="phone"
                label={CONTACT.phone}
                href={CONTACT.phoneHref}
                variant="row"
                event={{ name: "phone_click", payload: { section: "footer" } }}
              />
            </li>
            <li>
              <ChannelLink
                icon="whatsapp"
                label="واتساپ"
                href={CONTACT.whatsappHref}
                external
                variant="row"
                event={{ name: "messaging_click", payload: { section: "footer", channel: "whatsapp" } }}
              />
            </li>
            <li>
              <ChannelLink
                icon="telegram"
                label="تلگرام"
                href={CONTACT.telegramHref}
                external
                variant="row"
                event={{ name: "messaging_click", payload: { section: "footer", channel: "telegram" } }}
              />
            </li>
            <li>
              <ChannelLink icon="email" label={CONTACT.email} href={CONTACT.emailHref} variant="row" />
            </li>
            <li>
              <ChannelLink
                icon="instagram"
                label={CONTACT.instagramHandle}
                href={CONTACT.instagramHref}
                external
                variant="row"
              />
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-caption text-text-faint">© {year} نوونو</p>
      <ul class="flex gap-6">
        <li>
          <a
            href="/privacy"
            class="text-caption text-text-muted transition-colors duration-150 hover:text-text-action"
            >حریم خصوصی</a
          >
        </li>
        <li>
          <a
            href="/terms"
            class="text-caption text-text-muted transition-colors duration-150 hover:text-text-action"
            >شرایط استفاده</a
          >
        </li>
      </ul>
    </div>
  </div>
</footer>
