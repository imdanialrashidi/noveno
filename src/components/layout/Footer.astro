---
/**
 * Footer (DESIGN §8) — contact facts always visible (click-to-call,
 * WhatsApp/Telegram/email — redundancy is a requirement, Spec §64.1),
 * mini JourneyLine motif, privacy/terms links.
 */

import Logo from "../brand/Logo.astro";
import JourneyLine from "../business/JourneyLine.astro";
import { CONTACT, HERO_JOURNEY, jalaliYear } from "../../data/site";

const year = jalaliYear();
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-[1200px] px-5 py-12 sm:px-8 lg:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
      <div class="flex flex-col gap-6">
        <a href="/" class="inline-flex w-fit text-text" aria-label="نوونو — صفحه اصلی">
          <Logo size="lg" />
        </a>
        <p class="text-body text-text-muted measure-prose">
          نوونو برای کسب‌وکارهای خدماتی، مسیر مشتری را از دیدن شما تا تماس، ثبت درخواست و پیگیری طراحی و اجرا می‌کند.
        </p>
        <div class="max-w-md">
          <p class="mb-3 text-caption text-text-faint">مسیری که می‌سازیم</p>
          <JourneyLine stations={HERO_JOURNEY} label="مسیر جذب مشتری: توجه، اقدام، ثبت، پیگیری، نتیجه" compact />
        </div>
      </div>

      <div class="grid gap-8 sm:grid-cols-2">
        <nav aria-label="دسترسی سریع">
          <p class="mb-3 text-caption text-text-faint">صفحات</p>
          <ul class="flex flex-col">
            {[
              { href: "/services", label: "خدمات" },
              { href: "/work", label: "پروژه‌ها" },
              { href: "/process", label: "فرآیند" },
              { href: "/about", label: "درباره" },
              { href: "/contact", label: "تماس" },
            ].map((link) => (
              <li>
                <a href={link.href} class="inline-flex min-h-10 items-center text-ui text-text-muted transition-colors duration-150 hover:text-primary-active">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div>
          <p class="mb-3 text-caption text-text-faint">تماس مستقیم</p>
          <ul class="flex flex-col gap-1">
            <li>
              <a href={CONTACT.phoneHref} class="inline-flex min-h-10 items-center gap-2 text-ui font-medium text-text transition-colors duration-150 hover:text-primary-active">
                <span class="tnum" dir="ltr">{CONTACT.phone}</span>
              </a>
            </li>
            <li>
              <a href={CONTACT.whatsappHref} class="inline-flex min-h-10 items-center text-ui text-text-muted transition-colors duration-150 hover:text-primary-active" target="_blank" rel="noopener noreferrer">
                واتساپ
              </a>
            </li>
            <li>
              <a href={CONTACT.telegramHref} class="inline-flex min-h-10 items-center text-ui text-text-muted transition-colors duration-150 hover:text-primary-active" target="_blank" rel="noopener noreferrer">
                تلگرام
              </a>
            </li>
            <li>
              <a href={CONTACT.emailHref} class="inline-flex min-h-10 items-center text-ui text-text-muted transition-colors duration-150 hover:text-primary-active">
                {CONTACT.email}
              </a>
            </li>
            <li>
              <a href={CONTACT.instagramHref} class="inline-flex min-h-10 items-center text-ui text-text-muted transition-colors duration-150 hover:text-primary-active" target="_blank" rel="noopener noreferrer">
                {CONTACT.instagramHandle}
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-caption text-text-faint">© {year} نوونو</p>
      <ul class="flex gap-6">
        <li>
          <a href="/privacy" class="text-caption text-text-muted transition-colors duration-150 hover:text-primary-active">حریم خصوصی</a>
        </li>
        <li>
          <a href="/terms" class="text-caption text-text-muted transition-colors duration-150 hover:text-primary-active">شرایط استفاده</a>
        </li>
      </ul>
    </div>
  </div>
</footer>
