---
/**
 * CTASection — recurring final CTA (Spec §29; 2026-08-14 founder
 * redesign). Closing band: strong heading + support + dual CTA +
 * microcopy. Default: the next-steps rail on a raised panel. Homepage
 * variant: a strong cropped photograph gives the page a memorable
 * finish (media prop) — photography is contextual/editorial, clearly
 * captioned, never fabricated proof.
 */

import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import NextStepsRail from "../business/NextStepsRail.astro";
import { CTA_URL, PRIMARY_CTA_LABEL, CONTACT } from "../../data/site";

interface Media {
  src: string;
  srcset?: string;
  /** Optional AVIF srcset — rendered as the first <picture> source. */
  avifSrcset?: string;
  alt: string;
  caption: string;
  /** Intrinsic dimensions of the source image (w/h). */
  width: number;
  height: number;
}

interface Props {
  title?: string;
  support?: string;
  /** Override the primary CTA target (e.g. on /contact itself). */
  primaryHref?: string;
  primaryLabel?: string;
  /** Hide the next-steps rail (used where the rail already appears). */
  hideRail?: boolean;
  /** Homepage finish: a strong cropped photograph beside the CTA. */
  media?: Media;
}

const {
  title = "ببینیم مسیر فعلی جذب مشتری شما کجا می‌تواند بهتر شود.",
  support = "چند سؤال کوتاه درباره کسب‌وکارتان پاسخ دهید تا قبل از تماس، تصویر دقیق‌تری از وضعیت فعلی داشته باشیم.",
  primaryHref = CTA_URL,
  primaryLabel = PRIMARY_CTA_LABEL,
  hideRail = false,
  media,
} = Astro.props;
---

<section class="border-t border-line bg-surface-soft" aria-labelledby="cta-title">
  <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24" data-reveal>
    <div class:list={["grid gap-12", media ? "lg:grid-cols-2 lg:items-center lg:gap-20" : hideRail ? "" : "lg:grid-cols-2 lg:gap-20"]}>
      <div class="flex flex-col items-start gap-6">
        <h2 id="cta-title" class="text-h2 max-w-2xl text-text">{title}</h2>
        <p class="text-lead text-text-muted measure-prose">{support}</p>
        <div class="flex flex-wrap items-center gap-4">
          <Button
            href={primaryHref}
            size="lg"
            data={{ "data-event": "primary_cta_click", "data-event-payload": '{"section":"cta-section"}' }}
          >{primaryLabel}</Button>
          <Button
            href={CONTACT.phoneHref}
            variant="secondary"
            size="lg"
            data={{ "data-event": "phone_click", "data-event-payload": '{"section":"cta-section"}' }}
          >
            <Icon name="phone" class="h-4.5 w-4.5" />
            تماس مستقیم
            <span class="text-caption tnum" dir="ltr">{CONTACT.phone}</span>
          </Button>
        </div>
        <p class="text-meta text-text-faint">
          بدون وعده فروش تضمینی؛ ابتدا مسیر فعلی کسب‌وکار بررسی می‌شود.
        </p>
      </div>

      {media ? (
        <figure class="media-figure">
          <div class="media-frame aspect-[16/9]">
            <picture>
              {media.avifSrcset && (
                <source
                  type="image/avif"
                  srcset={media.avifSrcset}
                  sizes="(min-width: 1024px) 560px, 92vw"
                />
              )}
              <img
                src={media.src}
                srcset={media.srcset}
                sizes="(min-width: 1024px) 560px, 92vw"
                width={media.width}
                height={media.height}
                loading="lazy"
                decoding="async"
                alt={media.alt}
                class="transition-transform duration-300 ease-standard group-hover:scale-[1.015]"
              />
            </picture>
          </div>
          <figcaption class="media-caption">{media.caption}</figcaption>
        </figure>
      ) : (
        !hideRail && (
          <div class="panel bg-canvas p-6 sm:p-8 lg:p-10">
            <p class="mb-5 text-ui font-semibold text-text">پس از درخواست چه اتفاقی می‌افتد؟</p>
            <NextStepsRail />
          </div>
        )
      )}
    </div>
  </div>
</section>
