---
/**
 * MobileMenu (DESIGN §9.2, 2026-08-14 redesign) — panel toggled by the
 * header trigger. Composition is hierarchy-first:
 *   1. full-width primary CTA (the audit request — the single conversion),
 *   2. nav links (large ≥48px targets, square node markers),
 *   3. direct contact row (redundancy per Spec §64.1).
 * Theme toggle lives in the always-visible header row, so it is not
 * duplicated here. Focus moves into the panel on open, Escape closes,
 * focus returns to the trigger (src/scripts/menu.ts).
 */

import Button from "../ui/Button.astro";
import ChannelLink from "../ui/ChannelLink.astro";
import { NAV_LINKS, CTA_URL, PRIMARY_CTA_LABEL, CONTACT } from "../../data/site";
import { isCurrent } from "./nav";

const pathname = Astro.url.pathname;
---

<div
  id="mobile-menu"
  hidden
  class="border-b border-line bg-canvas lg:hidden"
>
  <nav class="mx-auto max-w-[1200px] px-5 py-5 sm:px-8" aria-label="منوی موبایل">
    <Button
      href={CTA_URL}
      class="w-full"
      size="lg"
      data={{ "data-event": "primary_cta_click", "data-event-payload": '{"section":"mobile-menu"}' }}
    >{PRIMARY_CTA_LABEL}</Button>

    <ul class="mt-6 flex flex-col">
      {NAV_LINKS.map((link) => (
        <li class="border-t border-line">
          <a
            href={link.href}
            aria-current={isCurrent(link.href, pathname) ? "page" : undefined}
            class:list={[
              "flex min-h-13 items-center gap-3 py-3 text-lg font-medium transition-colors duration-150",
              isCurrent(link.href, pathname) ? "text-text-action" : "text-text hover:text-text-action",
            ]}
          >
            <span
              class:list={[
                "h-2 w-2 flex-none rounded-[1px]",
                isCurrent(link.href, pathname) ? "bg-primary" : "border border-line-strong",
              ]}
              aria-hidden="true"
            ></span>
            {link.label}
          </a>
        </li>
      ))}
      {/* فرآیند is a supporting page: not in the primary desktop nav, but
          stays reachable here and in the footer. */}
      <li class="border-t border-line">
        <a
          href="/process"
          class:list={[
            "flex min-h-13 items-center gap-3 py-3 text-lg font-medium transition-colors duration-150",
            isCurrent("/process", pathname) ? "text-text-action" : "text-text hover:text-text-action",
          ]}
        >
          <span
            class:list={[
              "h-2 w-2 flex-none rounded-[1px]",
              isCurrent("/process", pathname) ? "bg-primary" : "border border-line-strong",
            ]}
            aria-hidden="true"
          ></span>
          فرآیند
        </a>
      </li>
    </ul>

    <p class="mt-6 mb-2 text-meta text-text-faint">تماس مستقیم</p>
    <div class="flex flex-col gap-2 border-t border-line pt-3">
      <ChannelLink
        icon="phone"
        label={CONTACT.phone}
        value="تماس"
        href={CONTACT.phoneHref}
        variant="tile"
        class="w-full"
        event={{ name: "phone_click", payload: { section: "mobile-menu" } }}
      />
      <ul class="grid grid-cols-2 gap-2">
        <li>
          <ChannelLink
            icon="whatsapp"
            label="واتساپ"
            href={CONTACT.whatsappHref}
            external
            variant="tile"
            event={{ name: "messaging_click", payload: { section: "mobile-menu", channel: "whatsapp" } }}
          />
        </li>
        <li>
          <ChannelLink
            icon="telegram"
            label="تلگرام"
            href={CONTACT.telegramHref}
            external
            variant="tile"
            event={{ name: "messaging_click", payload: { section: "mobile-menu", channel: "telegram" } }}
          />
        </li>
        <li>
          <ChannelLink
            icon="email"
            label="ایمیل"
            href={CONTACT.emailHref}
            variant="tile"
          />
        </li>
        <li>
          <ChannelLink
            icon="instagram"
            label={CONTACT.instagramHandle}
            href={CONTACT.instagramHref}
            external
            variant="tile"
          />
        </li>
      </ul>
    </div>
  </nav>
</div>
