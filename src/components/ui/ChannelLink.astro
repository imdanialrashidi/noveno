---
/**
 * ChannelLink — adapter over the SiteLink channel intent.
 * Preserved import path; the interface lives behind SiteLink's seam.
 */
import SiteLink from "./SiteLink.astro";
import type { IconName } from "./Icon.astro";

interface Props {
  icon: IconName;
  label: string;
  href: string;
  external?: boolean;
  value?: string;
  event?: { name: string; payload: Record<string, string> };
  variant?: "inline" | "row" | "tile";
  class?: string;
}

const { icon, label, href, external = false, value, event, variant = "inline" } = Astro.props;
const className = Astro.props["class"] ?? "";
---

<SiteLink
  intent="channel"
  icon={icon}
  label={label}
  href={href}
  external={external}
  value={value}
  event={event}
  variant={variant}
  class={className}
/>
