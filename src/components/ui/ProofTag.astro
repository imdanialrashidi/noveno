---
import { CONCEPT_DISCLAIMER } from "../../data/site";

export type ProofKind = "case-study" | "project" | "concept";

interface Props {
  kind: ProofKind;
}

/**
 * ProofTag — the only badge in the system (2026-08-14 redesign).
 * Plain typographic tag; the line-style code was removed with the
 * flowchart grammar. Label + surface tone only: «مطالعه موردی» /
 * «پروژه» / «نمونه نمایشی — سناریوی مفهومی».
 */
const config: Record<ProofKind, { label: string; classes: string }> = {
  "case-study": {
    label: "مطالعه موردی",
    classes: "text-accent-strong border-line",
  },
  project: {
    label: "پروژه",
    classes: "text-text-muted border-line",
  },
  concept: {
    label: CONCEPT_DISCLAIMER,
    classes: "text-text-faint border-dashed border-line-strong",
  },
};

const c = config[Astro.props.kind];
---

<span class:list={["inline-flex items-center rounded-[4px] border bg-surface px-2.5 py-1 text-caption", c.classes]}>
  {c.label}
</span>
