---
/**
 * MultiSelect — channel chips (DESIGN §11 step 2, Spec §31).
 * Square-ish 4px-radius chips, ≥44px targets, checkbox semantics
 * (role="checkbox" + aria-checked), RTL-aware arrow-key navigation
 * wired by the audit page script, selection = primary-soft fill +
 * on-primary-soft ink + check glyph (shape + check, never color alone).
 */

import type { AuditOption } from "../../data/audit";

interface Props {
  id: string;
  label: string;
  options: readonly AuditOption[];
  hint?: string;
}

const { id, label, options, hint } = Astro.props;
const errorId = `${id}-error`;
const labelId = `${id}-label`;
---

<div class="flex flex-col gap-2" data-save={id} data-multiselect>
  <span id={labelId} class="text-ui font-medium text-text">{label}</span>
  <div class="flex flex-wrap gap-2" role="group" aria-labelledby={labelId} data-chip-group>
    {
      options.map((option) => (
        <button
          type="button"
          role="checkbox"
          aria-checked="false"
          data-chip={option.id}
          data-group={id}
          tabindex={0}
          class="chip inline-flex min-h-11 items-center gap-2 rounded-[4px] border border-line-strong px-4 text-ui font-medium text-text transition-colors duration-150 hover:border-primary hover:text-text-action focus-visible:ring-2 focus-visible:ring-focus"
        >
          <span class="chip-check" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              class="h-3.5 w-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M20 6 9 17l-5-5" />
            </svg>
          </span>
          {option.label}
        </button>
      ))
    }
  </div>
  {
    hint && (
      <p id={`${id}-hint`} class="text-caption text-text-faint">
        {hint}
      </p>
    )
  }
  <p
    id={errorId}
    class="flex items-center gap-1.5 text-caption font-medium text-danger"
    data-field-error
    hidden
  >
    <svg
      viewBox="0 0 24 24"
      class="h-4 w-4 flex-none"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 8v5"></path>
      <path d="M12 16.5v.01"></path>
    </svg>
    <span data-error-text></span>
  </p>
</div>
