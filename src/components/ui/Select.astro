---
/**
 * Select — labeled single-choice select with placeholder, optional
 * marker and a linked error slot (DESIGN §11: selects for enums and
 * range picks; no free numbers on the economics step).
 */

import type { AuditOption } from "../../data/audit";

interface Props {
  id: string;
  label: string;
  options: readonly AuditOption[];
  placeholder?: string;
  value?: string;
  optional?: boolean;
  hint?: string;
}

const { id, label, options, placeholder = "انتخاب کنید", value = "", optional = false, hint } =
  Astro.props;
const errorId = `${id}-error`;
---

<div class="flex flex-col gap-1.5">
  <label for={id} class="text-ui font-medium text-text">
    {label}
    {optional && <span class="font-normal text-text-faint"> (اختیاری)</span>}
  </label>
  <select
    id={id}
    name={id}
    class="h-12 w-full appearance-none rounded-[4px] border border-line-strong bg-surface px-3.5 text-body text-text transition-colors duration-150 focus:border-focus focus:ring-2 focus:ring-focus/25"
    data-save={id}
  >
    <option value="" disabled={!optional} selected={value === ""}>
      {placeholder}
    </option>
    {options.map((option) => (
      <option value={option.id} selected={value === option.id}>
        {option.label}
      </option>
    ))}
  </select>
  {hint && (
    <p id={`${id}-hint`} class="text-caption text-text-faint">
      {hint}
    </p>
  )}
  <p
    id={errorId}
    class="flex items-center gap-1.5 text-caption font-medium text-danger"
    data-field-error
    hidden
  >
    <svg viewBox="0 0 24 24" class="h-4 w-4 flex-none" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M12 8v5" />
      <path d="M12 16.5v.01" />
    </svg>
    <span data-error-text></span>
  </p>
</div>
