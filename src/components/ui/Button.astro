---
interface Props {
  /** Render as a link when href is provided, otherwise a button. */
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "md" | "lg";
  type?: "button" | "submit";
  ariaLabel?: string;
  disabled?: boolean;
  class?: string;
  /** Arbitrary attributes (e.g. analytics data-event wiring). */
  data?: Record<string, string>;
}

const { href, variant = "primary", size = "md", type = "button", ariaLabel, disabled = false, data = {} } = Astro.props;
const className = Astro.props["class"] ?? "";

/**
 * Button — DESIGN §10.
 * primary: primary fill + dark ink (#06130d on green — white fails AA),
 * 4px radius, min-height 48px; secondary: 1px line-strong + text;
 * ghost: text link with visible focus.
 * States: hover (primary-hover) / focus-visible (2px focus ring) /
 * disabled (opacity 45%, never color-only) / pressed (primary-active).
 */
const variantClasses: Record<string, string> = {
  primary: "bg-primary text-on-primary hover:bg-primary-hover active:bg-primary-active",
  secondary:
    "border border-line-strong text-text hover:border-primary hover:text-primary-active bg-transparent",
  ghost: "text-accent-strong hover:text-primary-active underline-offset-4",
};

const sizeClasses: Record<string, string> = {
  md: "min-h-12 px-6",
  lg: "min-h-14 px-8",
};

const base =
  "inline-flex items-center justify-center gap-2 rounded-[4px] font-display font-medium text-ui transition-colors duration-150 ease-standard cursor-pointer select-none disabled:opacity-45 disabled:cursor-not-allowed";

const classes = [base, variantClasses[variant], sizeClasses[size], className].join(" ");
---

{href && (
  <a
    href={href}
    class={classes}
    aria-label={ariaLabel}
    aria-disabled={disabled ? "true" : undefined}
    {...data}
  >
    <slot />
  </a>
)}
{!href && (
  <button
    type={type}
    class={classes}
    aria-label={ariaLabel}
    disabled={disabled}
    {...data}
  >
    <slot />
  </button>
)}
