---
/**
 * Button — adapter over the SiteLink cta intent (DESIGN §10).
 * Preserved import path; the interface lives behind SiteLink's seam.
 */
import SiteLink from "./SiteLink.astro";

interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "md" | "lg";
  type?: "button" | "submit";
  ariaLabel?: string;
  disabled?: boolean;
  class?: string;
  data?: Record<string, string>;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  ariaLabel,
  disabled = false,
  data = {},
} = Astro.props;
const className = Astro.props["class"] ?? "";
---

<SiteLink
  intent="cta"
  href={href}
  label=""
  tone={variant}
  size={size}
  type={type}
  ariaLabel={ariaLabel}
  disabled={disabled}
  class={className}
  data={data}
>
  <slot />
</SiteLink>
