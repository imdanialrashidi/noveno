---
/**
 * ArrowLink — the "read more" arrow affordance (2026-08-14 redesign link
 * family), the single place the arrow glyph + hover direction live.
 * The `arrow-link` class is the registration layer's underline device
 * (DESIGN §12, device 5b): on the link's OWN hover/focus-visible the
 * underline grows from the inline start and the glyph nudges 4px — so
 * the feedback works outside a `.group` too, and keyboard users get
 * exactly what pointer users get.
 *
 * `as="span"` renders the identical affordance as a NON-interactive
 * label. It exists for rows whose whole area is already one anchor
 * (the homepage blog index, DESIGN §3.8): the reader still needs the
 * "read this" cue and its hover/focus feedback, but a second link inside
 * the row anchor would be invalid markup and two tab stops per article.
 */

interface Props {
  href?: string;
  label: string;
  /**
   * `a` (default) is the standalone "read more" link. `span` is the
   * non-interactive variant described above.
   */
  as?: "a" | "span";
  /** Extra leading class (prepended to the base, e.g. WorkCard's `mt-3`). */
  class?: string;
  /** Arbitrary attributes (e.g. analytics data-event wiring). */
  data?: Record<string, string>;
}

const { label, as = "a", data = {} } = Astro.props;
const href = Astro.props["href"];
const className = Astro.props["class"] ?? "";

const base =
  "arrow-link inline-flex min-h-11 items-center gap-1.5 text-ui font-medium text-accent-strong transition-colors duration-150 hover:text-text-action";

const classes = [className, as === "span" ? "arrow-link--inline" : "", base]
  .filter(Boolean)
  .join(" ");

/* One glyph, one definition — both variants render the same SVG. */
const GLYPH = `<svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform duration-150 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path></svg>`;
---

{
  as === "span" ? (
    <span class={classes}>
      {label}
      <Fragment set:html={GLYPH} />
    </span>
  ) : (
    <a href={href} class={classes} {...data}>
      {label}
      <Fragment set:html={GLYPH} />
    </a>
  )
}