---
/**
 * ArrowLink — the "read more" arrow anchor (2026-08-14 redesign link
 * family), the single place the arrow glyph + hover direction live.
 * The `arrow-link` class is the registration layer's underline device
 * (DESIGN §12, device 5b): on the link's OWN hover/focus-visible the
 * underline grows from the inline start and the glyph nudges 4px — so
 * the feedback works outside a `.group` too, and keyboard users get
 * exactly what pointer users get.
 */

interface Props {
  href: string;
  label: string;
  /** Extra leading class (prepended to the base, e.g. WorkCard's `mt-3`). */
  class?: string;
  /** Arbitrary attributes (e.g. analytics data-event wiring). */
  data?: Record<string, string>;
}

const { href, label, data = {} } = Astro.props;
const className = Astro.props["class"] ?? "";

const base =
  "arrow-link inline-flex min-h-11 items-center gap-1.5 text-ui font-medium text-accent-strong transition-colors duration-150 hover:text-text-action";

const classes = className ? `${className} ${base}` : base;
---

<a href={href} class={classes} {...data}>
  {label}
  <svg
    viewBox="0 0 24 24"
    class="h-4 w-4 transition-transform duration-150 group-hover:-translate-x-0.5"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M19 12H5"></path>
    <path d="m12 19-7-7 7-7"></path>
  </svg>
</a>
