---
/**
 * ArrowLink — adapter over the SiteLink readmore intent.
 * Preserved import path; the interface lives behind SiteLink's seam.
 */
import SiteLink from "./SiteLink.astro";

interface Props {
  href?: string;
  label: string;
  as?: "a" | "span";
  class?: string;
  data?: Record<string, string>;
}

const { label, as = "a", data = {} } = Astro.props;
const href = Astro.props["href"];
const className = Astro.props["class"] ?? "";
---

<SiteLink intent="readmore" href={href} label={label} as={as} class={className} data={data} />
