---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path: string;
  /** robots meta override (e.g. noindex for post-submission pages). */
  robots?: string;
}

const { title, description, path, robots } = Astro.props;
const site = Astro.site ?? new URL("https://noveno.ir/");
const canonical = new URL(path.replace(/\/index\.html$/, "/"), site).toString();
const ogImage = new URL("/og.png", site).toString();
// Brand once: a title that already contains «نوونو» is used as-is;
// otherwise the brand is appended once at the end (never duplicated).
const htmlTitle = title.includes("نوونو") ? title : `${title} — نوونو`;

// Build-time public values (names only in .env.example; no secrets).
// The Web Analytics token is public by design and only injects the
// beacon when a real token is configured.
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN ?? "";

// Structured data (Spec §43) — genuinely appropriate launch scope:
// Organization (identity + contact point) and WebSite identity.
const organizationJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "نوونو",
  alternateName: "NOVENO",
  url: site.toString(),
  logo: new URL("/favicon.svg", site).toString(),
  email: "imdanialrashidi@gmail.com",
  sameAs: ["https://instagram.com/noveno.ir"],
  contactPoint: {
    "@type": "ContactPoint",
    telephone: "+98-935-359-8620",
    contactType: "customer service",
    availableLanguage: ["fa"],
  },
});
const websiteJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "نوونو",
  alternateName: "NOVENO",
  url: site.toString(),
  inLanguage: "fa-IR",
});
---

<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{htmlTitle}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph + Twitter metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="نوونو" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:title" content={htmlTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="نوونو — سیستم جذب مشتری برای کسب‌وکارهای خدماتی" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={htmlTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data: Organization + WebSite identity (Spec §43) -->
    <script type="application/ld+json" set:html={organizationJsonLd}></script>
    <script type="application/ld+json" set:html={websiteJsonLd}></script>

    {cfAnalyticsToken !== "" && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfAnalyticsToken })}>
      </script>
    )}

    <!-- No wrong-theme flash (DESIGN §7.3): read the persisted override
         before first paint; no stored value = media-query default. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("noveno-theme");
          if (t === "light" || t === "dark") {
            document.documentElement.setAttribute("data-theme", t);
          }
        } catch (e) {}
      })();
    </script>

    <!-- LCP text is the hero headline → preload its face only (§5.3).
         Vazirmatn stays CSS-discovered (font-display: swap with the
         metric-matched fallback): preloading it competed with the LCP
         image on throttled mobile and regressed LCP (measured). -->
    <link rel="preload" href="/fonts/estedad-arabic-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  // Acquisition telemetry: declarative data-event clicks + attribution
  // capture (plan §5.8). Non-blocking; never contains lead PII.
  import { initAnalytics } from "../scripts/analytics";
  // Motion layer: one shared observer drives all entrance reveals;
  // below-the-fold content only, reduced-motion aware (motion.ts).
  import { initReveal, initStagger } from "../scripts/motion";
  initAnalytics();
  initReveal();
  initStagger();
</script>
