---
/**
 * PageLayout — shared shell: BaseLayout + skip link + Header +
 * MobileMenu + main + Footer. All Slice 1 pages use this.
 */

import BaseLayout from "./BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
  title: string;
  description: string;
  path: string;
}

const { title, description, path } = Astro.props;
---

<BaseLayout title={title} description={description} path={path}>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:start-3 focus:z-50 focus:rounded-[4px] focus:bg-primary focus:px-4 focus:py-2 focus:text-on-primary focus:shadow-panel"
  >
    رفتن به محتوای اصلی
  </a>
  <Header />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer />
</BaseLayout>
