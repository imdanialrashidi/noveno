---
/**
 * Process page (Spec §24; 2026-08-14 founder redesign).
 * Five-stage cycle rendered as an editorial numbered sequence —
 * typography carries the process; no loop diagram.
 */

import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/layout/PageHero.astro";
import SectionHeader from "../components/layout/SectionHeader.astro";
import CTASection from "../components/layout/CTASection.astro";
import { PROCESS_STAGES, CTA_URL, PRIMARY_CTA_LABEL, toFaDigits } from "../data/site";
import Button from "../components/ui/Button.astro";

const faIndex = (i: number) => toFaDigits(String(i + 1).padStart(2, "0"));
---

<PageLayout
  title="فرآیند کار نوونو — یک چرخه، نه تحویل و خداحافظی"
  description="فرآیند نوونو در پنج مرحله: بررسی، طراحی، اجرا، اندازه‌گیری و بهبود — به صورت چرخه‌ای که بر اساس داده واقعی بهتر می‌شود."
  path="/process"
>
  <PageHero
    id="process-hero-title"
    eyebrow="فرآیند نوونو"
    title="بررسی، طراحی، اجرا، اندازه‌گیری، بهبود — و دوباره از اول"
    lead="این چرخه همان چیزی است که برای کسب‌وکار شما طراحی می‌شود. هر دور بر اساس داده‌ای که دور قبل جمع شده، مسیر را دقیق‌تر می‌کند."
  >
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href={CTA_URL} size="lg">{PRIMARY_CTA_LABEL}</Button>
      <Button href="/work" variant="secondary" size="lg">دیدن پروژه‌ها</Button>
    </div>
  </PageHero>

  <!-- The cycle — typography-led sequence -->
  <section class="border-t border-line" aria-labelledby="loop-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <SectionHeader
        id="loop-title"
        kicker="چرخه پنج مرحله‌ای"
        title="هر دور، از داده دور قبل بهتر می‌شود"
        lead="ترتیب دقیقاً همین است: بررسی، طراحی، اجرا، اندازه‌گیری، بهبود — و بازگشت به بررسی. هیچ مرحله‌ای حذف یا جابه‌جا نمی‌شود."
      />

      <ol class="flex flex-col">
        {
          PROCESS_STAGES.map((stage, index) => (
            <li class="grid grid-cols-[auto_1fr] items-baseline gap-x-6 gap-y-2 border-t border-line py-8 sm:gap-x-12">
              <span class="editorial-num">{faIndex(index)}</span>
              <div class="flex flex-col gap-2">
                <h2 class="text-h3 text-text">{stage.label}</h2>
                <p class="text-body text-text-muted measure-prose">{stage.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="border-t border-line pt-6 text-meta text-text-faint">
        چرخه‌ای که بعد از هر دور، بر اساس داده‌ای که همان دور جمع شده، دقیق‌تر می‌شود.
      </p>
    </div>
  </section>

  <!-- Why a cycle -->
  <section class="border-t border-line" aria-labelledby="cycle-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeader
            id="cycle-title"
            kicker="چرا چرخه؟"
            title="چرا چرخه، نه پروژه خطی؟"
            lead="«ساخت → تحویل → خداحافظی» با واقعیت جذب مشتری نمی‌خواند؛ مسیر باید بعد از داده اصلاح شود."
          />
        </div>
        <ul class="flex flex-col gap-6 lg:col-span-7">
          {
            [
              {
                title: "داده حرف می‌زند",
                text: "اولین دور، فرضیه‌های طراحی را با داده واقعی جایگزین می‌کند: کدام CTA، کدام فرم، کدام کانال.",
              },
              {
                title: "تغییر کوچک، اثر بزرگ",
                text: "بهبودها بر اساس شواهد اولویت‌بندی می‌شوند؛ نه سلیقه و نه «همه چیز را عوض کنیم».",
              },
              {
                title: "هزینه قابل پیش‌بینی",
                text: "هر دور بهبود در محدوده تعریف‌شده انجام می‌شود؛ بدون Scope پنهان و بدون کار بی‌پایان.",
              },
              {
                title: "مسئولیت نتیجه",
                text: "اگر چیزی بهتر نشد، اندازه‌گیری همان را نشان می‌دهد — و مسیر اصلاح می‌شود.",
              },
            ].map((item) => (
              <li class="border-t border-line pt-5">
                <h3 class="text-ui font-semibold text-text">{item.title}</h3>
                <p class="mt-2 text-body text-text-muted measure-prose">{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CTASection />
</PageLayout>
