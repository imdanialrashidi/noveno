---
/**
 * Thank-you page (Spec §33, DESIGN §11 — matrix screen 9).
 * The JourneyLine extends: the six audit stations are complete and the
 * route continues as dashed future stations «بررسی ← تماس ← گفتگو ←
 * پیشنهاد» with a «شما اینجا هستید» marker between them (solid =
 * done, dashed = recommended/future — the honesty grammar §4.3).
 * NextStepsRail explains what happens next; direct contact stays
 * available; a pointer to a real work item appears only when the
 * collection has non-concept entries. Copy never implies guaranteed
 * acceptance or sales.
 */

import PageLayout from "../../layouts/PageLayout.astro";
import PageHero from "../../components/layout/PageHero.astro";
import NextStepsRail from "../../components/business/NextStepsRail.astro";
import { getCollection } from "astro:content";
import { AUDIT_STATIONS, CONTACT } from "../../data/site";

const completed = AUDIT_STATIONS;
const future = [
  { label: "بررسی" },
  { label: "تماس" },
  { label: "گفتگو" },
  { label: "پیشنهاد" },
] as const;

const realWork = (await getCollection("work"))
  .filter((entry) => entry.data.type !== "concept")
  .sort((a, b) => (a.data.featured === b.data.featured ? 0 : a.data.featured ? -1 : 1));
const pointer = realWork[0] ?? null;

const nodeClass = "flex-none rounded-[1px] h-3.5 w-3.5";
const labelClass = "text-caption font-medium leading-tight";
---

<PageLayout
  title="درخواست شما ثبت شد"
  description="درخواست بررسی مسیر جذب شما ثبت شد. اگر همکاری مناسب باشد، نوونو برای گفتگوی کوتاه تماس می‌گیرد."
  path="/audit/thank-you"
  robots="noindex"
>
  <PageHero
    id="thanks-title"
    title="درخواست شما ثبت شد."
    lead="اطلاعات به‌صورت امن ثبت شد و مسیر شما در اینجا ادامه پیدا می‌کند. اگر همکاری مناسب باشد، نوونو برای یک گفت‌وگوی کوتاه با شما تماس می‌گیرد."
  >
    <!-- Direct visitors (no submission in this session) get an honest note.
         The head script sets data-audit-done before first paint, so the
         guard is hidden by CSS with zero layout shift on the submit path. -->
    <div id="thankyou-guard" class="mt-6 flex flex-col items-start gap-3 rounded-[4px] border border-line bg-surface-soft p-4">
      <p class="text-body text-text-muted">
        اگر در این نشست درخواستی ثبت نکرده‌اید، می‌توانید بررسی را از ابتدا شروع کنید.
      </p>
      <a href="/audit" class="inline-flex min-h-11 items-center rounded-[4px] bg-primary px-5 text-ui font-medium text-on-primary transition-colors duration-150 hover:bg-primary-hover">
        شروع بررسی مسیر جذب
      </a>
    </div>
  </PageHero>

  <!-- The extended JourneyLine: completed stations + future dashed route -->
  <section class="border-t border-line" aria-labelledby="route-title">
    <div class="mx-auto max-w-[1200px] px-5 py-12 sm:px-8 lg:py-16">
      <h2 id="route-title" class="sr-only">مسیر شما: ایستگاه‌های تکمیل‌شده و مراحل بعد</h2>

      <div class="panel p-6 sm:p-8">
        <ol class="sr-only">
          {completed.map((s) => (
            <li>تکمیل‌شده: {s.label}</li>
          ))}
          <li>شما اینجا هستید</li>
          {future.map((s) => (
            <li>مرحله بعد: {s.label}</li>
          ))}
        </ol>

        <!-- Desktop: horizontal route (RTL: solid right→marker, dashed marker→left) -->
        <div class="hidden lg:block" aria-hidden="true">
          <div class="relative pt-2">
            <span class="absolute top-[10px] right-1 h-0 w-[calc(60%-4px)] border-t-2 border-solid border-primary"></span>
            <span class="absolute top-[10px] left-1 h-0 w-[calc(40%-4px)] border-t-2 border-dashed border-line-strong"></span>
            <div class="relative flex items-start justify-between gap-2">
              {completed.map((station, index) => (
                <span class="flex max-w-24 flex-1 flex-col items-center gap-1.5 text-center">
                  <span class:list={[nodeClass, "bg-primary"]}></span>
                  <span class:list={[labelClass, "font-semibold text-text-action"]}>{station.label}</span>
                </span>
              ))}
              {/* «شما اینجا هستید» marker */}
              <span class="relative flex flex-col items-center gap-1.5 text-center">
                <span class="flex h-3 w-3 items-center justify-center rounded-[1px] border-2 border-primary bg-surface" >
                  <span class="h-1 w-1 rounded-[1px] bg-primary"></span>
                </span>
                <span class:list={[labelClass, "whitespace-nowrap font-semibold text-text"]}>شما اینجا هستید</span>
              </span>
              {future.map((station) => (
                <span class="flex max-w-24 flex-1 flex-col items-center gap-1.5 text-center">
                  <span class:list={[nodeClass, "border border-dashed border-line-strong"]}></span>
                  <span class:list={[labelClass, "text-text-muted"]}>{station.label}</span>
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Mobile: vertical spine -->
        <div class="lg:hidden" aria-hidden="true">
          <div class="flex flex-col items-start">
            {completed.map((station, index) => (
              <div class="contents">
                <span class="flex items-center gap-2">
                  <span class:list={[nodeClass, "bg-primary"]}></span>
                  <span class:list={[labelClass, "font-semibold text-text-action"]}>{station.label}</span>
                </span>
                {index < completed.length - 1 && <span class="ms-[3px] my-1 h-5 w-0 border-s-2 border-solid border-primary"></span>}
              </div>
            ))}
            <span class="ms-[3px] my-1 h-5 w-0 border-s-2 border-dashed border-line-strong"></span>
            <span class="flex items-center gap-2">
              <span class="flex h-3 w-3 items-center justify-center rounded-[1px] border-2 border-primary bg-surface">
                <span class="h-1 w-1 rounded-[1px] bg-primary"></span>
              </span>
              <span class:list={[labelClass, "font-semibold text-text"]}>شما اینجا هستید</span>
            </span>
            {future.map((station, index) => (
              <div class="contents">
                <span class="ms-[3px] my-1 h-5 w-0 border-s-2 border-dashed border-line-strong"></span>
                <span class="flex items-center gap-2">
                  <span class:list={[nodeClass, "border border-dashed border-line-strong"]}></span>
                  <span class:list={[labelClass, "text-text-muted"]}>{station.label}</span>
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What happens next -->
  <section class="border-t border-line" aria-labelledby="next-title">
    <div class="mx-auto max-w-[1200px] px-5 py-12 sm:px-8 lg:py-16">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <h2 id="next-title" class="text-h3 text-text">حالا چه اتفاقی می‌افتد؟</h2>
          <p class="mt-4 text-body text-text-muted measure-prose">
            مسیر کوتاه و مشخص است: درخواست بررسی می‌شود و اگر همکاری مناسب باشد،
            گفت‌وگو شروع می‌شود. هیچ وعده فروش تضمینی‌ای در کار نیست.
          </p>
          <div class="mt-6 flex flex-col gap-3 border-t border-line pt-6">
            <p class="text-ui font-medium text-text">سؤال فوری دارید؟</p>
            <div class="flex flex-wrap gap-x-5 gap-y-2">
              <a href={CONTACT.phoneHref} class="inline-flex min-h-11 items-center text-ui font-medium text-accent-strong hover:text-text-action" data-event="phone_click" data-event-payload='{"section":"thank-you"}'>
                تماس <span class="tnum" dir="ltr">{CONTACT.phone}</span>
              </a>
              <a href={CONTACT.whatsappHref} class="inline-flex min-h-11 items-center text-ui font-medium text-accent-strong hover:text-text-action" target="_blank" rel="noopener noreferrer" data-event="messaging_click" data-event-payload='{"section":"thank-you","channel":"whatsapp"}'>
                واتساپ
              </a>
              <a href={CONTACT.telegramHref} class="inline-flex min-h-11 items-center text-ui font-medium text-accent-strong hover:text-text-action" target="_blank" rel="noopener noreferrer" data-event="messaging_click" data-event-payload='{"section":"thank-you","channel":"telegram"}'>
                تلگرام
              </a>
              <a href={CONTACT.emailHref} class="inline-flex min-h-11 items-center text-ui font-medium text-accent-strong hover:text-text-action">{CONTACT.email}</a>
            </div>
          </div>

          {pointer && (
            <div class="mt-6 flex flex-col gap-3 border-t border-line pt-6">
              <p class="text-ui font-medium text-text">نمونه‌ای واقعی از کار نوونو</p>
              <a href={`/work/${pointer.id}`} class="group inline-flex min-h-11 w-fit items-center gap-2 text-ui font-medium text-accent-strong hover:text-text-action" data-event="project_opened" data-event-payload={`{"slug":"${pointer.id}"}`}>
                <span class="h-2 w-2 flex-none rounded-[1px] border border-line-strong transition-colors duration-150 group-hover:bg-primary" aria-hidden="true"></span>
                {pointer.data.title}
                <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform duration-150 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M19 12H5" />
                  <path d="m12 19-7-7 7-7" />
                </svg>
              </a>
            </div>
          )}
        </div>
        <div class="lg:col-span-7">
          <p class="mb-4 text-ui font-medium text-text-muted">چهار قدم بعدی</p>
          <NextStepsRail />
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="head">
    <script is:inline>
      (function () {
        try {
          if (sessionStorage.getItem("noveno:audit:done")) {
            document.documentElement.setAttribute("data-audit-done", "true");
          }
        } catch (e) {}
      })();
    </script>
  </Fragment>
</PageLayout>
