---
/**
 * Thank-you page (Spec §33; 2026-08-14 founder redesign).
 * The extended route diagram was removed with the flowchart grammar;
 * «what happens next» is a clean numbered sequence (1/2/3/4) with
 * concise copy. Direct contact stays available; a pointer to a real
 * work item appears only when the collection has non-concept entries.
 * Copy never implies guaranteed acceptance or sales.
 */

import PageLayout from "../../layouts/PageLayout.astro";
import PageHero from "../../components/layout/PageHero.astro";
import ChannelLink from "../../components/ui/ChannelLink.astro";
import NextStepsRail from "../../components/business/NextStepsRail.astro";
import { getCollection } from "astro:content";
import { CONTACT } from "../../data/site";

const realWork = (await getCollection("work"))
  .filter((entry) => entry.data.type !== "concept")
  .sort((a, b) => (a.data.featured === b.data.featured ? 0 : a.data.featured ? -1 : 1));
const pointer = realWork[0] ?? null;
---

<PageLayout
  title="درخواست شما دریافت شد"
  description="درخواست بررسی مسیر جذب شما دریافت شد. اگر همکاری مناسب باشد، نوونو برای گفتگوی کوتاه تماس می‌گیرد."
  path="/audit/thank-you"
  robots="noindex"
>
  <PageHero
    id="thanks-title"
    title="درخواست شما دریافت شد."
    lead="اطلاعات به‌صورت امن ارسال شد. اگر همکاری مناسب باشد، نوونو برای یک گفت‌وگوی کوتاه با شما تماس می‌گیرد."
  >
    <!-- Direct visitors (no submission in this session) get an honest note.
         The head script sets data-audit-done before first paint, so the
         guard is hidden by CSS with zero layout shift on the submit path. -->
    <div
      id="thankyou-guard"
      class="mt-6 flex flex-col items-start gap-3 rounded-[4px] border border-line bg-surface-soft p-4"
    >
      <p class="text-body text-text-muted">
        اگر در این نشست درخواستی ارسال نکرده‌اید، می‌توانید بررسی را از ابتدا شروع کنید.
      </p>
      <a
        href="/audit"
        class="inline-flex min-h-11 items-center rounded-[4px] bg-primary px-5 text-ui font-medium text-on-primary transition-colors duration-150 hover:bg-primary-hover"
      >
        شروع بررسی مسیر جذب
      </a>
    </div>
  </PageHero>

  <!-- What happens next — numbered sequence, no graph -->
  <section class="border-t border-line" aria-labelledby="next-title">
    <div class="mx-auto max-w-[1200px] px-5 py-12 sm:px-8 lg:py-16">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <h2 id="next-title" class="text-h3 text-text">حالا چه اتفاقی می‌افتد؟</h2>
          <p class="mt-4 text-body text-text-muted measure-prose">
            مسیر کوتاه و مشخص است: درخواست بررسی می‌شود و اگر همکاری مناسب باشد، گفت‌وگو شروع می‌شود. هیچ وعده
            فروش تضمینی‌ای در کار نیست.
          </p>
          <div class="mt-6 flex flex-col gap-3 border-t border-line pt-6">
            <p class="text-ui font-medium text-text">سؤال فوری دارید؟</p>
            <div class="flex flex-wrap gap-x-5 gap-y-1">
              <ChannelLink
                icon="phone"
                label={CONTACT.phone}
                value="تماس"
                href={CONTACT.phoneHref}
                event={{ name: "phone_click", payload: { section: "thank-you" } }}
              />
              <ChannelLink
                icon="whatsapp"
                label="واتساپ"
                href={CONTACT.whatsappHref}
                external
                event={{ name: "messaging_click", payload: { section: "thank-you", channel: "whatsapp" } }}
              />
              <ChannelLink
                icon="telegram"
                label="تلگرام"
                href={CONTACT.telegramHref}
                external
                event={{ name: "messaging_click", payload: { section: "thank-you", channel: "telegram" } }}
              />
              <ChannelLink icon="email" label={CONTACT.email} href={CONTACT.emailHref} />
            </div>
          </div>

          {
            pointer && (
              <div class="mt-6 flex flex-col gap-3 border-t border-line pt-6">
                <p class="text-ui font-medium text-text">نمونه‌ای واقعی از کار نوونو</p>
                <a
                  href={`/work/${pointer.id}`}
                  class="group inline-flex min-h-11 w-fit items-center gap-2 text-ui font-medium text-accent-strong hover:text-text-action"
                  data-event="project_opened"
                  data-event-payload={`{"slug":"${pointer.id}"}`}
                >
                  {pointer.data.title}
                  <svg
                    viewBox="0 0 24 24"
                    class="h-4 w-4 transition-transform duration-150 group-hover:-translate-x-0.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M19 12H5" />
                    <path d="m12 19-7-7 7-7" />
                  </svg>
                </a>
              </div>
            )
          }
        </div>
        <div class="lg:col-span-7">
          <p class="mb-4 text-ui font-medium text-text-muted">چهار قدم بعدی</p>
          <NextStepsRail />
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="head">
    <script is:inline>
      (function () {
        try {
          if (sessionStorage.getItem("noveno:audit:done")) {
            document.documentElement.setAttribute("data-audit-done", "true");
          }
        } catch (e) {}
      })();
    </script>
  </Fragment>
</PageLayout>
