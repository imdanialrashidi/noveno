---
/**
 * Blog article page (/blog/[slug]) — the reading surface.
 * - Exceptionally readable Persian: RTL, ~70ch measure, strong heading
 *   rhythm, blockquotes, lists, tables, figures, captions.
 * - SEO: unique title/description, canonical (optional override),
 *   og:type article + social card, Article/BlogPosting JSON-LD with
 *   truthful author/publisher/dates, breadcrumbs.
 * - Navigation: related-by-category + previous/next + contextual
 *   service/audit CTA. Related content is never fabricated: empty
 *   when there is no real same-category article.
 * - Drafts never reach this page (getStaticPaths filters them) and
 *   internal recommendations only ever point at published entries.
 *
 * Canonical URL: /blog/[slug]. The former /insights/[slug] URLs are
 * permanently redirected here (public/_redirects) — exactly one
 * canonical article URL exists.
 */

import PageLayout from "../../layouts/PageLayout.astro";
import Button from "../../components/ui/Button.astro";
import { getCollection, render } from "astro:content";
import { isPublished, relatedEntries, neighbours, formatFaDate, readingMinutes } from "../../data/blog";
import { toFaDigits } from "../../data/site";

export async function getStaticPaths() {
  const all = await getCollection("blog");
  const published = all.filter(isPublished);
  return published.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, all },
  }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const site = Astro.site ?? new URL("https://noveno.ir/");
const origin = site.toString().replace(/\/$/, "");
const canonicalUrl = data.canonical ?? `${origin}/blog/${entry.id}`;
const ogImage = data.ogImage ?? `/og/blog/${entry.id}.png`;

const related = relatedEntries(all, entry, 2);
const { older, newer } = neighbours(all, entry);

const pageTitle = `${data.title} | نوونو`;
const publishedIso = data.published_at.toISOString();
const updatedIso = data.updated_at?.toISOString();

/* BreadcrumbList — truthful hierarchy for the blog section. */
const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "نوونو", item: `${origin}/` },
    { "@type": "ListItem", position: 2, name: "وبلاگ", item: `${origin}/blog` },
    { "@type": "ListItem", position: 3, name: data.title, item: canonicalUrl },
  ],
});

/* Article schema — only real fields: title, dates, author (default = the
   truthful publisher), publisher identity, description. No ratings,
   no invented metrics, no fake reviewers. */
const articleJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.description,
  inLanguage: "fa-IR",
  datePublished: publishedIso,
  ...(updatedIso ? { dateModified: updatedIso } : {}),
  author: { "@type": "Person", name: data.author },
  publisher: {
    "@type": "Organization",
    name: "نوونو",
    alternateName: "NOVENO",
    url: origin,
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  ...(data.tags.length > 0 ? { keywords: data.tags.join("، ") } : {}),
  ...(data.category ? { articleSection: data.category } : {}),
});

const readingLabel = `${toFaDigits(readingMinutes(entry.body ?? ""))} دقیقه مطالعه`;
---

<PageLayout
  title={pageTitle}
  description={data.description}
  path={`/blog/${entry.id}`}
  ogImage={ogImage}
  ogType="article"
  ogImageAlt={data.title}
>
  <script slot="head" type="application/ld+json" set:html={breadcrumbJsonLd} />
  <script slot="head" type="application/ld+json" set:html={articleJsonLd} />

  <!-- Breadcrumbs: خانه / وبلاگ / عنوان -->
  <nav aria-label="مسیر صفحه" class="border-b border-line">
    <div class="mx-auto max-w-[1200px] px-5 py-3 sm:px-8">
      <ol class="flex flex-wrap items-center gap-1.5 text-meta text-text-faint">
        <li>
          <a href="/" class="rounded-[2px] transition-colors duration-150 hover:text-text-action">خانه</a>
        </li>
        <li aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            class="h-3.5 w-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
          >
        </li>
        <li>
          <a href="/blog/" class="rounded-[2px] transition-colors duration-150 hover:text-text-action"
            >وبلاگ</a
          >
        </li>
        <li aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            class="h-3.5 w-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
          >
        </li>
        <li aria-current="page" class="text-text-muted">{data.title}</li>
      </ol>
    </div>
  </nav>

  <!-- Article header -->
  <header aria-labelledby="article-title">
    <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:py-20">
      <div class="flex flex-wrap items-center gap-3">
        <a
          href="/blog/"
          class="inline-flex items-center rounded-[4px] border border-line bg-surface px-2.5 py-1 text-caption text-text-muted transition-colors duration-150 hover:border-primary hover:text-text-action"
        >
          {data.category}
        </a>
        <span class="text-meta text-text-faint">— {formatFaDate(data.published_at)}</span>
        <span class="text-meta text-text-faint">· {readingLabel}</span>
      </div>
      <h1 id="article-title" class="mt-6 max-w-3xl text-h1-page text-text">{data.title}</h1>
      <p class="mt-5 max-w-2xl text-lead text-text-muted">{data.description}</p>
      <p class="mt-6 text-meta text-text-faint">
        نوشتهٔ {data.author}
        {
          updatedIso && (
            <span class="text-text-faint"> — آخرین بازبینی: {formatFaDate(data.updated_at as Date)}</span>
          )
        }
      </p>
    </div>
  </header>

  <!-- Article body — the reading surface -->
  <section class="border-t border-line" aria-label="متن نوشته">
    <div class="mx-auto max-w-[1200px] px-5 py-10 sm:px-8 lg:py-14">
      <article class="article-prose mx-auto">
        <Content />
      </article>
    </div>
  </section>

  <!-- Further reading: previous/next + related by topic (never fabricated) -->
  <section class="border-t border-line" aria-label="نوشته‌های مرتبط">
    <div class="mx-auto max-w-[1200px] px-5 py-12 sm:px-8 lg:py-16">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="flex flex-col gap-4 lg:col-span-7">
          {
            (older || newer) && (
              <>
                <h2 class="text-h3 text-text">ادامهٔ خواندن</h2>
                <div class="flex flex-col">
                  {older && (
                    <a
                      href={`/blog/${older.id}`}
                      class="group flex flex-col gap-1 border-t border-line py-5 transition-colors duration-150 hover:bg-surface-soft/40 sm:px-3"
                    >
                      <span class="text-meta text-text-faint">نوشتهٔ قبلی</span>
                      <span class="text-h3 text-text transition-colors duration-150 group-hover:text-text-action">
                        {older.data.title}
                      </span>
                      <span class="text-meta text-text-faint">{formatFaDate(older.data.published_at)}</span>
                    </a>
                  )}
                  {newer && (
                    <a
                      href={`/blog/${newer.id}`}
                      class="group flex flex-col gap-1 border-t border-line py-5 transition-colors duration-150 hover:bg-surface-soft/40 sm:px-3"
                    >
                      <span class="text-meta text-text-faint">نوشتهٔ بعدی</span>
                      <span class="text-h3 text-text transition-colors duration-150 group-hover:text-text-action">
                        {newer.data.title}
                      </span>
                      <span class="text-meta text-text-faint">{formatFaDate(newer.data.published_at)}</span>
                    </a>
                  )}
                </div>
              </>
            )
          }
        </div>

        <div class="flex flex-col gap-4 lg:col-span-5">
          {
            related.length > 0 && (
              <>
                <h2 class="text-h3 text-text">هم‌موضوع‌ها</h2>
                <ul class="flex flex-col">
                  {related.map((item) => (
                    <li class="border-t border-line">
                      <a
                        href={`/blog/${item.id}`}
                        class="group flex flex-col gap-1 py-5 transition-colors duration-150 hover:bg-surface-soft/40 sm:px-3"
                      >
                        <span class="text-meta text-text-faint">{item.data.category}</span>
                        <span class="text-body font-medium text-text transition-colors duration-150 group-hover:text-text-action">
                          {item.data.title}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )
          }

          <div class="mt-2 flex flex-col gap-3 border-t border-line pt-6">
            <p class="text-ui font-medium text-text">این نوشته به درد کسب‌وکار شما خورد؟</p>
            <p class="text-body text-text-muted measure-prose">
              قدم بعدی بررسی مسیر جذب است: چند سؤال کوتاه تا تصویر دقیق‌تری از وضعیت فعلی داشته باشیم.
            </p>
            <div class="flex flex-wrap items-center gap-4">
              <Button
                href="/audit"
                data={{
                  "data-event": "primary_cta_click",
                  "data-event-payload": '{"section":"blog-article"}',
                }}>درخواست بررسی مسیر جذب</Button
              >
              <Button href="/services" variant="secondary">دیدن خدمات</Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
