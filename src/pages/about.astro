---
/**
 * About page (2026-10 focus pass) — shorter and founder-led: the
 * problem in a few lines → what Noveno believes (5 items, not 8) →
 * how the work runs → what Noveno does not do → the founder, with only
 * verified identity. No invented team, credentials, or biography.
 */

import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/layout/PageHero.astro";
import ChannelLink from "../components/ui/ChannelLink.astro";
import SectionHeader from "../components/layout/SectionHeader.astro";
import CTASection from "../components/layout/CTASection.astro";
import Button from "../components/ui/Button.astro";
import { CONTACT, CTA_URL, FOUNDER, toFaDigits } from "../data/site";

const faIndex = (i: number) => toFaDigits(String(i + 1).padStart(2, "0"));
---

<PageLayout
  title="درباره نوونو — چرا وجود دارد و چه باوری دارد"
  description="چرا نوونو وجود دارد، چه باوری دارد، چگونه کار می‌کند و چه کاری نمی‌کند: سیستمی برای جذب مشتری که خودش هم با همین اصول ساخته شده است."
  path="/about"
  ogImage="/og/about.png"
  ogImageAlt="درباره نوونو — چرا وجود دارد و چه باوری دارد"
>
  <PageHero
    id="about-hero-title"
    eyebrow="درباره نوونو"
    title="نوونو چرا وجود دارد"
    lead="خیلی از کسب‌وکارهای خدماتی مشکل «نداشتن مشتری» ندارند؛ مشکل «ندیدن مسیر» دارند. درخواست می‌آید، اما در پیام‌ها گم می‌شود؛ کانال نتیجه می‌دهد، اما کسی نمی‌داند کدام کانال."
  >
    <p class="mt-4 max-w-2xl text-body text-text-muted">
      نوونو برای همین به وجود آمد: تبدیل توجه پراکنده به درخواست‌هایی که ثبت و پیگیری می‌شوند. این وب‌سایت هم
      با همین اصول ساخته شده است.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href={CTA_URL} size="lg">درخواست بررسی مسیر جذب</Button>
      <Button href="/process" variant="secondary" size="lg">دیدن فرآیند</Button>
    </div>
  </PageHero>

  <!-- The problem — why Noveno exists -->
  <section class="border-t border-line" aria-labelledby="problem-title">
    <div class="mx-auto grid max-w-[1200px] gap-12 px-5 py-14 sm:px-8 lg:grid-cols-12 lg:gap-16 lg:py-20">
      <div class="lg:col-span-5">
        <SectionHeader
          id="problem-title"
          kicker="مسئله"
          title="ابزار دارید؛ مسیر ندارید"
          lead="کسب‌وکارها معمولاً کمبودِ ابزار ندارند. ابزارها را جمع کرده‌اند، اما هیچ‌کدام به هم وصل نیستند."
        />
      </div>
      <div class="flex flex-col gap-4 lg:col-span-7" data-reveal>
        <p class="text-body text-text-muted measure-prose">
          یک آرایشگاه یا آموزشگاه معمولی در طول یک هفته از چند جا درخواست می‌گیرد: دایرکت، تماس، پیام‌رسان،
          معرفی مشتری قبلی، شاید یک فرم روی سایت. هر درخواست در همان کانال خودش می‌ماند، پیگیری‌اش به حافظه
          وابسته است و هیچ‌کس نمی‌تواند بگوید کدام کانال واقعاً مشتری آورده.
        </p>
        <p class="text-body text-text-muted measure-prose">
          این «پراکندگی» است — و پراکندگی با یک ابزار بیشتر حل نمی‌شود؛ با یک <strong class="text-text"
            >نقطه ثبت واحد</strong
          > حل می‌شود که همه کانال‌ها به آن می‌رسند.
        </p>
        <ul class="mt-4 flex flex-col">
          {
            [
              "درخواست‌ها پراکنده‌اند و جای مشخصی برای ثبت ندارند",
              "منبع ورودی معلوم نیست؛ بودجهٔ تبلیغ کور خرج می‌شود",
              "پیگیری به حافظه وابسته است؛ درخواست‌ها بی‌صدا از دست می‌روند",
            ].map((item, i) => (
              <li class="grid grid-cols-[auto_1fr] items-baseline gap-4 border-t border-line py-4">
                <span class="text-xl font-extrabold text-text-action tnum">{faIndex(i)}</span>
                <span class="text-body font-medium text-text">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- What Noveno believes -->
  <section class="border-t border-line" aria-labelledby="beliefs-title">
    <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:py-20">
      <SectionHeader
        id="beliefs-title"
        kicker="باورها"
        title="معیار تصمیم ما"
        lead="این‌ها شعار نیستند؛ معیار تصمیم‌گیری‌اند — هم در همکاری با مشتری، هم در ساختن همین وب‌سایت."
      />
      <ol class="grid gap-x-14 gap-y-8 sm:grid-cols-2">
        {
          [
            {
              title: "مسئلهٔ کسب‌وکار، قبل از فناوری",
              text: "«درخواست‌های شما کجا گم می‌شود؟» قبل از «چه ابزاری استفاده می‌کنیم؟» جواب داده می‌شود.",
            },
            {
              title: "کوچک‌ترین سیستم قابل اعتماد",
              text: "هر چیزی که لازم نیست ساخته نمی‌شود؛ پیچیدگی برای کسب‌وکار کوچک هزینه است، نه ارزش.",
            },
            {
              title: "قابل اندازه‌گیری، بر جلوه",
              text: "هر تغییری باید در داده دیده شود. نتیجه‌ای که اندازه‌گیری نشده، گزارش نمی‌شود.",
            },
            {
              title: "شواهد واقعی، بر ادعا",
              text: "هر کاری یا واقعی است یا صریحاً «نمونه نمایشی» نام دارد. عدد بدون داده منتشر نمی‌شود.",
            },
            {
              title: "ساخته‌شده برای شرایط واقعی ایران",
              text: "موبایل، اینترنت ناپایدار، ابزارهای در دسترس و قابلیت جایگزینی.",
            },
          ].map((item, i) => (
            <li class="border-t border-line py-6">
              <span class="text-xl font-extrabold text-text-action tnum">{faIndex(i)}</span>
              <h3 class="mt-2 text-ui font-semibold text-text">{item.title}</h3>
              <p class="mt-2 text-body text-text-muted">{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- How Noveno works — the four moves, connected to the offer -->
  <section class="border-t border-line" aria-labelledby="how-title">
    <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeader
            id="how-title"
            kicker="روش کار"
            title="چگونه کار می‌کنیم"
            lead="هر همکاری با بررسی مسیر فعلی شروع می‌شود؛ هیچ چیزی بدون دیدن وضعیت واقعی ساخته یا پیشنهاد نمی‌شود."
          />
          <Button href="/process" variant="secondary">دیدن فرآیند کامل</Button>
        </div>
        <ol class="flex flex-col lg:col-span-7">
          {
            [
              {
                title: "بررسی",
                text: "مسیر فعلی جذب شما کجاست و کجا درخواست گم می‌شود — با چند سؤال کوتاه و یک گفت‌وگو.",
              },
              {
                title: "طراحی و اجرا",
                text: "کوچک‌ترین سیستمی که مسئله را حل می‌کند: صفحه، فرم، مسیر پیام، ثبت لید — فقط آنچه لازم است.",
              },
              {
                title: "اندازه‌گیری",
                text: "اقدام‌های مهم ثبت و قابل مقایسه می‌شوند: درخواست از کدام کانال، با چه وضعیتی، به چه نتیجه‌ای رسید.",
              },
              {
                title: "بهبود",
                text: "تغییرها بر اساس شواهد اولویت‌بندی می‌شوند — نه سلیقه و نه «همه چیز را عوض کنیم».",
              },
            ].map((stage, i) => (
              <li class="grid grid-cols-[auto_1fr] items-baseline gap-x-6 gap-y-2 border-t border-line py-6 sm:gap-x-10">
                <span class="editorial-num">{faIndex(i)}</span>
                <div class="flex flex-col gap-1.5">
                  <h3 class="text-h3 text-text">{stage.title}</h3>
                  <p class="text-body text-text-muted measure-prose">{stage.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- What Noveno does not do -->
  <section class="border-t border-line" aria-labelledby="not-title">
    <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:py-20">
      <SectionHeader
        id="not-title"
        kicker="صراحت"
        title="چه کاری نمی‌کنیم"
        lead="مشخص کردن مرزها، هم برای شما و هم برای ما وقت ذخیره می‌کند."
      />
      <ul class="grid gap-x-14 gap-y-8 sm:grid-cols-2">
        {
          [
            {
              title: "کارخانهٔ طراحی وب عمومی",
              text: "سایت‌سازی انبوه بدون نگاه به مسیر جذب، مشکل شما را حل نمی‌کند.",
            },
            { title: "فروشندهٔ فالوور", text: "تعداد دنبال‌کننده یا بازدید نمایشی، معیار موفقیت ما نیست." },
            {
              title: "خدمت تضمین فروش",
              text: "هیچ‌کس نمی‌تواند فروش را تضمین کند؛ ما چنین وعده‌ای نمی‌دهیم.",
            },
            {
              title: "نرم‌افزار سازمانی پیچیده",
              text: "برای کسب‌وکار خدماتی کوچک، پیچیدگی هزینه است، نه ارزش.",
            },
          ].map((item) => (
            <li class="flex items-start gap-3 border-t border-line py-5">
              <svg
                viewBox="0 0 24 24"
                class="mt-1.5 h-4 w-4 flex-none text-text-faint"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M18 6 6 18M6 6l12 12" />
              </svg>
              <span class="flex flex-col gap-1">
                <span class="text-ui font-semibold text-text">{item.title}</span>
                <span class="text-body text-text-muted">{item.text}</span>
              </span>
            </li>
          ))
        }
      </ul>
      <p class="mt-10 border-t border-line pt-6 text-body text-text-muted">
        ببینید <a href="/work" class="text-link">چه کارهایی ساخته شده</a> و قیمت شروع هر بسته در صفحه
        <a href="/pricing" class="text-link">قیمت</a> چقدر است.
      </p>
    </div>
  </section>

  <!-- Founder — verified identity only. The portrait slot stays empty on
       purpose until a real photograph exists; no generated face. -->
  <section class="border-t border-line" aria-labelledby="founder-title">
    <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:py-20">
      <SectionHeader
        id="founder-title"
        kicker="بنیان‌گذار"
        title="چه کسی پشت نوونو است"
        lead="نوونو تک‌نفره اداره می‌شود؛ تیم بزرگ‌تر و سابقه‌ای که اینجا ثبت نشده ادعا نمی‌کنیم."
      />
      <div class="grid gap-10 border-t-2 border-line pt-8 lg:grid-cols-12 lg:gap-16">
        <div class="flex flex-col gap-4 lg:col-span-7">
          <p class="text-h3 text-text">{FOUNDER.name}</p>
          <p class="text-meta text-text-faint">{FOUNDER.role}</p>
          <p class="text-body text-text-muted measure-prose">{FOUNDER.bio}</p>
          <p class="text-body text-text-muted measure-prose">
            همین وب‌سایت، اجرای عملی همان چیزی است که برای مشتریان طراحی می‌شود: مسیر مشخص، ثبت درخواست،
            اندازه‌گیری و پیگیری.
          </p>
        </div>
        <div
          class="flex flex-col gap-3 border-t border-line pt-6 lg:col-span-5 lg:border-s lg:border-t-0 lg:ps-10 lg:pt-0"
        >
          <p class="text-meta text-text-faint">تماس مستقیم با بنیان‌گذار</p>
          <ul class="flex flex-col gap-0.5">
            <li>
              <ChannelLink
                icon="phone"
                label={CONTACT.phone}
                href={CONTACT.phoneHref}
                event={{ name: "phone_click", payload: { section: "about" } }}
              />
            </li>
            <li>
              <ChannelLink
                icon="whatsapp"
                label="واتساپ"
                href={CONTACT.whatsappHref}
                external
                event={{ name: "messaging_click", payload: { section: "about", channel: "whatsapp" } }}
              />
            </li>
            <li>
              <ChannelLink
                icon="telegram"
                label="تلگرام"
                href={CONTACT.telegramHref}
                external
                event={{ name: "messaging_click", payload: { section: "about", channel: "telegram" } }}
              />
            </li>
            <li>
              <ChannelLink icon="email" label={CONTACT.email} href={CONTACT.emailHref} />
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</PageLayout>
