---
/**
 * About page (Spec §40; 2026-08-14 founder redesign): Why Noveno Exists
 * → What Noveno Believes → How Noveno Works (editorial sequence) →
 * Founder → CTA. No invented team, no fabricated biography.
 */

import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/layout/PageHero.astro";
import SectionHeader from "../components/layout/SectionHeader.astro";
import CTASection from "../components/layout/CTASection.astro";
import Button from "../components/ui/Button.astro";
import { PROCESS_STAGES, CONTACT, toFaDigits } from "../data/site";

const faIndex = (i: number) => toFaDigits(String(i + 1).padStart(2, "0"));
---

<PageLayout
  title="درباره نوونو"
  description="چرا نوونو وجود دارد، چه باوری دارد و چگونه کار می‌کند: سیستمی برای جذب مشتری که خودش هم با همین اصول ساخته شده است."
  path="/about"
>
  <PageHero
    id="about-hero-title"
    eyebrow="درباره نوونو"
    title="نوونو چرا وجود دارد"
    lead="خیلی از کسب‌وکارهای خدماتی مشکل «نداشتن مشتری» ندارند؛ مشکل «ندیدن مسیر» دارند. درخواست می‌آید، اما در پیام‌ها گم می‌شود؛ کانال نتیجه می‌دهد، اما کسی نمی‌داند کدام کانال."
  >
    <p class="mt-4 max-w-2xl text-body text-text-muted">
      نوونو برای همین به وجود آمد: تبدیل توجه پراکنده به یک مسیر قابل‌پیگیری — از دیدن شما تا تماس، ثبت درخواست، پیگیری و نتیجه. این وب‌سایت هم با همین اصول ساخته شده است.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href="/audit" size="lg">درخواست بررسی مسیر جذب</Button>
      <Button href="/process" variant="secondary" size="lg">دیدن فرآیند</Button>
    </div>
  </PageHero>

  <!-- What Noveno believes -->
  <section class="border-t border-line" aria-labelledby="beliefs-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <SectionHeader id="beliefs-title" kicker="باورها" title="چه چیزی را باور داریم" />
      <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {[
          { title: "وضوح بر جلوه", text: "کسب‌وکار به سیستمی که می‌فهمد اعتماد می‌کند، نه به جلوه‌ای که نمی‌فهمد." },
          { title: "شواهد بر نظر", text: "هر تغییری باید در داده دیده شود؛ نظر مهم است اما جای داده را نمی‌گیرد." },
          { title: "سادگی بر پیچیدگی", text: "سیستمی که فقط یک نفر بلد است کار کند، برای کسب‌وکار کوچک بدهی است." },
          { title: "صداقت بر خوش‌قولی", text: "نتیجه‌ای که اندازه‌گیری نشده، گزارش نمی‌شود — حتی اگر گزارشش خوشایندتر باشد." },
        ].map((item) => (
          <div class="border-t border-line pt-4">
            <h3 class="text-ui font-semibold text-text">{item.title}</h3>
            <p class="mt-2 text-body text-text-muted">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How Noveno works — editorial sequence -->
  <section class="border-t border-line" aria-labelledby="how-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeader
            id="how-title"
            kicker="روش کار"
            title="چگونه کار می‌کنیم"
            lead="یک چرخه مشخص، نه وعده‌های پراکنده. هر همکاری با بررسی مسیر فعلی شروع می‌شود."
          />
          <Button href="/process" variant="secondary">دیدن فرآیند کامل</Button>
        </div>
        <ol class="flex flex-col lg:col-span-7">
          {PROCESS_STAGES.map((stage, i) => (
            <li class="grid grid-cols-[auto_1fr] items-baseline gap-x-6 gap-y-2 border-t border-line py-6 sm:gap-x-10">
              <span class="editorial-num">{faIndex(i)}</span>
              <div class="flex flex-col gap-1.5">
                <h3 class="text-ui font-semibold text-text">{stage.label}</h3>
                <p class="text-body text-text-muted">{stage.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Founder -->
  <section class="border-t border-line" aria-labelledby="founder-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-28">
      <SectionHeader
        id="founder-title"
        kicker="بنیان‌گذار"
        title="چه کسی پشت نوونو است"
        lead="نوونو در حال حاضر توسط یک نفر اداره می‌شود؛ تیم بزرگ‌تر را ادعا نمی‌کنیم."
      />
      <div class="panel p-6 sm:p-10 lg:p-12">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,4fr)] lg:gap-16">
          <div class="flex flex-col gap-5">
            <p class="text-h3 text-text">دانیال رشیدی</p>
            <p class="text-body text-text-muted measure-prose">
              بنیان‌گذار نوونو. پیش‌زمینه کار بر روی وب، محصول و سیستم‌های کوچک برای کسب‌وکارها؛ با این باور که مشکل بیشتر کسب‌وکارهای خدماتی، نبودِ مسیر است، نه نبودِ ابزار.
            </p>
            <p class="text-body text-text-muted measure-prose">
              همین وب‌سایت، اجرای عملی همان چیزی است که برای مشتریان طراحی می‌شود: مسیر مشخص، ثبت درخواست، اندازه‌گیری و پیگیری.
            </p>
          </div>
          <div class="flex flex-col gap-3 border-t border-line pt-6 lg:border-s lg:border-t-0 lg:ps-10 lg:pt-0">
            <p class="text-meta text-text-faint">تماس مستقیم با بنیان‌گذار</p>
            <ul class="flex flex-col">
              <li>
                <a href={CONTACT.phoneHref} class="inline-flex min-h-11 items-center text-ui font-medium text-accent-strong transition-colors duration-150 hover:text-text-action" data-event="phone_click" data-event-payload='{"section":"about"}'>
                  <span class="tnum" dir="ltr">{CONTACT.phone}</span>
                </a>
              </li>
              <li>
                <a href={CONTACT.whatsappHref} class="inline-flex min-h-11 items-center text-ui text-accent-strong transition-colors duration-150 hover:text-text-action" target="_blank" rel="noopener noreferrer" data-event="messaging_click" data-event-payload='{"section":"about","channel":"whatsapp"}'>واتساپ</a>
              </li>
              <li>
                <a href={CONTACT.telegramHref} class="inline-flex min-h-11 items-center text-ui text-accent-strong transition-colors duration-150 hover:text-text-action" target="_blank" rel="noopener noreferrer" data-event="messaging_click" data-event-payload='{"section":"about","channel":"telegram"}'>تلگرام</a>
              </li>
              <li>
                <a href={CONTACT.emailHref} class="inline-flex min-h-11 items-center text-ui text-accent-strong transition-colors duration-150 hover:text-text-action">{CONTACT.email}</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</PageLayout>
