---
/**
 * Contact page (Spec §41, DESIGN §15 screen 11).
 * Contact redundancy is a resilience requirement (§64.1): phone
 * (click-to-call), WhatsApp, Telegram, email, Instagram — all always
 * visible. No dead-end generic contact form (Spec §41); the request
 * path with next steps is explained instead.
 */

import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/layout/PageHero.astro";
import CTASection from "../components/layout/CTASection.astro";
import Button from "../components/ui/Button.astro";
import Icon, { type IconName } from "../components/ui/Icon.astro";
import NextStepsRail from "../components/business/NextStepsRail.astro";
import { CONTACT } from "../data/site";

interface Channel {
  icon: IconName;
  title: string;
  detail: string;
  href: string;
  value: string;
  ltr?: boolean;
  external?: boolean;
  event?: { name: string; payload: Record<string, string> };
}

const channels: Channel[] = [
  {
    icon: "phone",
    title: "تماس تلفنی",
    detail: "پاسخ‌گویی در ساعات کاری",
    href: CONTACT.phoneHref,
    value: CONTACT.phone,
    ltr: true,
    event: { name: "phone_click", payload: { section: "contact" } },
  },
  {
    icon: "whatsapp",
    title: "واتساپ",
    detail: "برای ارسال پیام و فایل",
    href: CONTACT.whatsappHref,
    value: "واتساپ",
    external: true,
    event: { name: "messaging_click", payload: { section: "contact", channel: "whatsapp" } },
  },
  {
    icon: "telegram",
    title: "تلگرام",
    detail: "برای ارسال پیام",
    href: CONTACT.telegramHref,
    value: "تلگرام",
    external: true,
    event: { name: "messaging_click", payload: { section: "contact", channel: "telegram" } },
  },
  {
    icon: "email",
    title: "ایمیل",
    detail: "برای توضیحات و مدارک",
    href: CONTACT.emailHref,
    value: CONTACT.email,
    ltr: true,
  },
  {
    icon: "instagram",
    title: "اینستاگرام",
    detail: "دیدن نمونه‌کارها و گفتگو",
    href: CONTACT.instagramHref,
    value: CONTACT.instagramHandle,
    external: true,
  },
];
---

<PageLayout
  title="تماس با نوونو"
  description="راه‌های تماس با نوونو: تلفن ۰۹۳۵۳۵۹۸۶۲۰، واتساپ، تلگرام، ایمیل و اینستاگرام. یا درخواست بررسی مسیر جذب را ثبت کنید."
  path="/contact"
>
  <PageHero
    id="contact-hero-title"
    eyebrow="تماس با نوونو"
    title="تماس مستقیم؛ هر کانالی که برای شما راحت‌تر است"
    lead="چند کانال مستقل در دسترس است تا مسیر تماس هیچ‌وقت به یک نقطه وابسته نباشد. اگر سؤال کوتاهی دارید، مستقیم بپرسید."
  />

  <!-- Channels -->
  <section class="border-t border-line" aria-label="راه‌های تماس">
    <div class="mx-auto max-w-[1200px] px-5 py-12 sm:px-8 lg:py-16">
      <ul class="flex flex-col">
        {
          channels.map((channel) => (
            <li class="border-t border-line first:border-t-0">
              <a
                href={channel.href}
                class="group grid grid-cols-[auto_1fr] items-center gap-x-4 gap-y-2 rounded-[4px] py-5 transition-colors duration-150 hover:bg-surface-soft/50 sm:grid-cols-[56px_1fr_auto] sm:gap-x-6 sm:px-3 sm:py-4"
                {...(channel.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                {...(channel.event
                  ? {
                      "data-event": channel.event.name,
                      "data-event-payload": JSON.stringify(channel.event.payload),
                    }
                  : {})}
              >
                <span
                  class="flex h-12 w-12 items-center justify-center rounded-[4px] border border-line bg-surface text-text-muted transition-colors duration-150 group-hover:border-primary group-hover:bg-primary-soft group-hover:text-accent-strong sm:h-14 sm:w-14"
                  aria-hidden="true"
                >
                  <Icon name={channel.icon} class="h-5.5 w-5.5 sm:h-6 sm:w-6" />
                </span>
                <span class="flex min-w-0 flex-col gap-0.5">
                  <span class="text-h3 text-text transition-colors duration-150 group-hover:text-text-action">
                    {channel.title}
                  </span>
                  <span class="text-body text-text-muted">{channel.detail}</span>
                </span>
                <span class="col-start-2 flex items-center gap-1.5 text-ui font-medium text-accent-strong sm:col-start-auto sm:justify-self-end">
                  <span class={channel.ltr ? "tnum" : ""} dir={channel.ltr ? "ltr" : undefined}>
                    {channel.value}
                  </span>
                  <svg
                    viewBox="0 0 24 24"
                    class="h-4 w-4 transition-transform duration-150 group-hover:-translate-x-0.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M19 12H5" />
                    <path d="m12 19-7-7 7-7" />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- What happens next -->
  <section class="border-t border-line" aria-labelledby="next-title">
    <div class="mx-auto max-w-[1200px] px-5 py-12 sm:px-8 lg:py-16">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <h2 id="next-title" class="text-h3 text-text">پس از تماس یا درخواست، چه اتفاقی می‌افتد؟</h2>
          <p class="mt-4 text-body text-text-muted measure-prose">
            گفتگو کوتاه و مشخص است: اول وضعیت فعلی جذب شما فهمیده می‌شود، بعد پیشنهاد. اگر همکاری مناسب نباشد،
            همان‌جا گفته می‌شود.
          </p>
          <div class="mt-6">
            <Button href={CONTACT.phoneHref} size="lg">
              <Icon name="phone" class="h-4.5 w-4.5" />
              تماس تلفنی
              <span class="text-caption tnum" dir="ltr">{CONTACT.phone}</span>
            </Button>
          </div>
        </div>
        <div class="lg:col-span-7">
          <NextStepsRail />
        </div>
      </div>
    </div>
  </section>

  <CTASection primaryHref={CONTACT.phoneHref} primaryLabel="تماس تلفنی برای شروع" hideRail />
</PageLayout>
