---
/**
 * Work detail page (DESIGN §15 screens 6–7, Spec §21 template).
 * Proof-type treatment is mechanical (DESIGN §4.3):
 *  case-study → solid/filled + metrics with source+limitation footnotes
 *  project    → solid/hollow + honest outcome marker
 *  concept    → dashed + «نمونه نمایشی» + «هدف طراحی»/«KPI پیشنهادی»
 * Long content: 66ch measure with a desktop sticky rail (meta + outcome
 * summary), single column on mobile.
 */

import PageLayout from "../../layouts/PageLayout.astro";
import CTASection from "../../components/layout/CTASection.astro";
import ProofTag, { type ProofKind } from "../../components/ui/ProofTag.astro";
import Metric from "../../components/ui/Metric.astro";
import LeadStatusStrip from "../../components/business/LeadStatusStrip.astro";
import SystemArchitectureDiagram from "../../components/business/SystemArchitectureDiagram.astro";
import { getCollection, render } from "astro:content";
import { CONCEPT_DISCLAIMER, PROOF_LABELS } from "../../data/site";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const jalali = (date: Date) =>
  new Intl.DateTimeFormat("fa-IR", { year: "numeric", month: "long" }).format(date);

const kind = data.type as ProofKind;
const isConcept = data.type === "concept";
const isProject = data.type === "project";
const isCaseStudy = data.type === "case-study";

const pageTitle = `${data.title} — ${PROOF_LABELS[kind]}`;
---

<PageLayout title={pageTitle} description={data.summary} path={`/work/${entry.id}`}>
  <!-- Project hero (§21.1) -->
  <section aria-labelledby="work-title">
    <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:py-20">
      <div class="flex flex-wrap items-center gap-3">
        <ProofTag kind={kind} />
        <span class="text-caption text-text-faint">{data.industry}</span>
        <span class="text-caption text-text-faint">— {jalali(data.published_at)}</span>
        {data.timeline && <span class="text-caption text-text-faint">— {data.timeline}</span>}
      </div>
      <h1 id="work-title" class="mt-6 max-w-3xl text-h2 text-text">{data.title}</h1>
      <p class="mt-5 max-w-2xl text-lead text-text-muted">{data.summary}</p>

      {isConcept && (
        <p class="mt-6 inline-flex items-center gap-2 border border-dashed border-line-strong px-3 py-2 text-caption text-text-faint">
          <span class="h-2 w-2 flex-none border border-dashed border-line-strong" aria-hidden="true"></span>
          {CONCEPT_DISCLAIMER} — این صفحه قصد ندارد شبیه یک نتیجه واقعی باشد.
        </p>
      )}
      {isProject && (
        <p class="mt-6 inline-flex items-center gap-2 border border-line px-3 py-2 text-caption text-text-muted">
          <span class="h-2 w-2 flex-none border border-line-strong" aria-hidden="true"></span>
          نتیجه: در دست اندازه‌گیری — بدون داده، عددی گزارش نمی‌شود.
        </p>
      )}
    </div>
  </section>

  <!-- Long content + sticky rail -->
  <section class="border-t border-line" aria-label="جزئیات کار">
    <div class="mx-auto grid max-w-[1200px] gap-12 px-5 py-12 sm:px-8 lg:grid-cols-[minmax(0,1fr)_300px] lg:py-16">
      <article class="work-prose min-w-0">
        <Content />
      </article>

      <aside class="flex flex-col gap-8 self-start lg:sticky lg:top-10">
        <!-- meta rail -->
        <div class="flex flex-col gap-4 border-t border-line pt-5">
          <h2 class="text-ui font-semibold text-text">اطلاعات کار</h2>
          <dl class="flex flex-col gap-3 text-body">
            {data.client && (
              <div>
                <dt class="text-caption text-text-faint">مشتری</dt>
                <dd class="text-text">{data.client.name}</dd>
              </div>
            )}
            {data.timeline && (
              <div>
                <dt class="text-caption text-text-faint">زمان</dt>
                <dd class="text-text">{data.timeline}</dd>
              </div>
            )}
            {data.scope && (
              <div>
                <dt class="text-caption text-text-faint">Scope</dt>
                <dd class="text-text">{data.scope}</dd>
              </div>
            )}
            {data.components.length > 0 && (
              <div>
                <dt class="text-caption text-text-faint">اجزا</dt>
                <dd class="flex flex-wrap gap-x-3 gap-y-1">
                  {data.components.map((component) => (
                    <span class="flex items-center gap-1.5 text-text">
                      <span class="h-1 w-1 flex-none rounded-[1px] bg-line-strong" aria-hidden="true"></span>
                      {component}
                    </span>
                  ))}
                </dd>
              </div>
            )}
          </dl>
        </div>

        <!-- outcome summary -->
        {isCaseStudy && data.metrics.length > 0 && (
          <div class="flex flex-col gap-3 border-t border-line pt-5">
            <h2 class="text-ui font-semibold text-text">خلاصه نتیجه</h2>
            <LeadStatusStrip active={2} label="جایگاه نتیجه در وضعیت لید" />
            {data.metrics.slice(0, 3).map((metric) => (
              <div class="flex items-baseline justify-between gap-4 border-t border-line pt-3">
                <span class="text-caption text-text-muted">{metric.name}</span>
                <span class="text-data text-lg text-text tnum">{metric.value}{metric.unit ? ` ${metric.unit}` : ""}</span>
              </div>
            ))}
          </div>
        )}
        {isProject && (
          <div class="flex flex-col gap-3 border-t border-line pt-5">
            <h2 class="text-ui font-semibold text-text">وضعیت نتیجه</h2>
            <p class="text-body text-text-muted">در دست اندازه‌گیری</p>
            <p class="text-caption text-text-faint">شاخص‌ها پس از جمع‌آوری داده واقعی در همین بخش گزارش می‌شوند.</p>
          </div>
        )}
        {isConcept && (
          <div class="flex flex-col gap-3 border-t border-line pt-5">
            <h2 class="text-ui font-semibold text-text">ماهیت کار</h2>
            <p class="text-body text-text-muted">نمونه نمایشی — سناریوی مفهومی</p>
            <p class="text-caption text-text-faint">اهداف و KPIها پیشنهاد طراحی‌اند؛ هیچ داده‌ای از اجرای واقعی وجود ندارد.</p>
          </div>
        )}
      </aside>
    </div>
  </section>

  <!-- Concept: design goals + proposed KPIs (Spec §19 language) -->
  {isConcept && (
    <section class="border-t border-line" aria-labelledby="concept-goals-title">
      <div class="mx-auto grid max-w-[1200px] gap-10 px-5 py-12 sm:px-8 lg:grid-cols-2 lg:gap-16 lg:py-16">
        <div>
          <h2 id="concept-goals-title" class="flex items-center gap-2 text-h3 text-text">
            <span class="h-2 w-2 flex-none rounded-[1px] border border-dashed border-line-strong" aria-hidden="true"></span>
            هدف طراحی
          </h2>
          <ul class="mt-5 flex flex-col gap-3">
            {data.goals.map((goal) => (
              <li class="flex items-start gap-2.5 text-body text-text-muted">
                <span class="mt-2.5 h-1.5 w-1.5 flex-none rounded-[1px] border border-dashed border-line-strong" aria-hidden="true"></span>
                {goal}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="flex items-center gap-2 text-h3 text-text">
            <span class="h-2 w-2 flex-none rounded-[1px] border border-dashed border-line-strong" aria-hidden="true"></span>
            KPI پیشنهادی
          </h2>
          <ul class="mt-5 flex flex-col gap-3">
            {data.kpis.map((kpi) => (
              <li class="flex items-start gap-2.5 text-body text-text-muted">
                <span class="mt-2.5 h-1.5 w-1.5 flex-none rounded-[1px] border border-dashed border-line-strong" aria-hidden="true"></span>
                {kpi}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- Case study / project: measured metrics with sources + limitations -->
  {!isConcept && data.metrics.length > 0 && (
    <section class="border-t border-line" aria-labelledby="metrics-title">
      <div class="mx-auto max-w-[1200px] px-5 py-12 sm:px-8 lg:py-16">
        <h2 id="metrics-title" class="text-h2 text-text">نتیجه‌های اندازه‌گیری‌شده</h2>
        <p class="mt-4 text-caption text-text-faint">هر عدد با منبع و محدودیت تفسیر آن همراه است؛ بدون داده، عددی نیست.</p>
        <div class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
          {data.metrics.map((metric) => (
            <Metric
              value={`${metric.value}${metric.unit ? ` ${metric.unit}` : ""}`}
              name={metric.name}
              source={metric.source}
              limitation={metric.note ?? metric.period ?? undefined}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Mandatory limitations (§21.8) -->
  {data.limitations && data.limitations.length > 0 && (
    <section class="border-t border-line" aria-labelledby="limitations-title">
      <div class="mx-auto max-w-[1200px] px-5 py-12 sm:px-8 lg:py-16">
        <h2 id="limitations-title" class="text-h3 text-text">محدودیت‌های تفسیر</h2>
        <ul class="mt-5 flex max-w-2xl flex-col gap-3">
          {data.limitations.map((limitation) => (
            <li class="flex items-start gap-2.5 text-body text-text-muted">
              <span class="mt-2.5 h-1.5 w-1.5 flex-none rounded-[1px] bg-line-strong" aria-hidden="true"></span>
              {limitation}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- System architecture (§21.6) -->
  <section class="border-t border-line" aria-labelledby="architecture-title">
    <div class="mx-auto max-w-[1200px] px-5 py-12 sm:px-8 lg:py-16">
      <h2 id="architecture-title" class="text-h3 text-text">معماری سیستم</h2>
      <p class="mt-3 mb-8 max-w-2xl text-body text-text-muted">
        {isConcept
          ? "نمایش ساختاری مسیر پیشنهادی این سناریو — نه یک سیستم اجراشده."
          : "نمایش ساختاری اجزای این سیستم و اتصال آن‌ها."}
      </p>
      <SystemArchitectureDiagram
        id={`arch-${entry.id}`}
        channels={["اینستاگرام", "گوگل", "معرفی"]}
        stations={isConcept ? ["ثبت درخواست", "پیگیری", "گزارش"] : ["ثبت لید", "پیگیری", "گزارش"]}
      />
    </div>
  </section>

  <CTASection />
</PageLayout>
