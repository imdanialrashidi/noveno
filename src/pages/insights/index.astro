---
/**
 * Insights index (/insights) — the editorial knowledge hub.
 * Editorial rather than a card wall: a strong introduction, one
 * featured (latest) article treatment when content exists, then a
 * clean typographic listing with date + category context, and a clear
 * route into Noveno's services/audit. Drafts are never listed.
 * Empty state is designed, not accidental.
 */

import PageLayout from "../../layouts/PageLayout.astro";
import Button from "../../components/ui/Button.astro";
import SectionHeader from "../../components/layout/SectionHeader.astro";
import { getCollection } from "astro:content";
import { isPublished, sortByDate, formatFaDate } from "../../data/insights";
import { toFaDigits } from "../../data/site";

const all = await getCollection("insights");
const published = sortByDate(all.filter(isPublished));
const featured = published[0] ?? null;
const rest = published.slice(1);

const totalLabel = toFaDigits(published.length);
---

<PageLayout
  title="دیدگاه‌های نوونو — نوشته‌هایی درباره جذب و پیگیری مشتری"
  description="نوشته‌های کاربردی نوونو برای کسب‌وکارهای خدماتی: جذب مشتری، پیگیری لید، ثبت درخواست و تبدیل بازدید به درخواست — با مثال و بدون وعده تضمینی."
  path="/insights"
  ogImage="/og/insights.png"
  ogImageAlt="دیدگاه‌های نوونو — نوشته‌هایی درباره جذب و پیگیری مشتری"
>
  <!-- Editorial page head -->
  <section aria-labelledby="insights-title">
    <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:py-20">
      <p class="text-ui font-medium text-text-faint">نوونو · دیدگاه‌ها</p>
      <h1 id="insights-title" class="mt-4 max-w-3xl text-h1-page text-text">
        نوشته‌هایی درباره مسیر جذب مشتری
      </h1>
      <p class="mt-6 max-w-2xl text-lead text-text-muted">
        آنچه اینجا می‌خوانید از تجربهٔ ساختن سیستم‌های جذب برای کسب‌وکارهای خدماتی نوشته می‌شود:
        جذب، پیگیری لید، ثبت درخواست و تبدیل بازدید به اقدام. بدون وعدهٔ تضمینی — با مثال و روش.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href="/audit" data={{ "data-event": "primary_cta_click", "data-event-payload": '{"section":"insights-hero"}' }}>بررسی مسیر جذب کسب‌وکارتان</Button>
        <Button href="/services" variant="secondary">دیدن خدمات</Button>
      </div>
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="insights-list-title">
    <div class="mx-auto max-w-[1200px] px-5 py-12 sm:px-8 lg:py-16">
      <h2 id="insights-list-title" class="sr-only">نوشته‌ها</h2>

      {published.length === 0 && (
        <div class="flex flex-col items-start gap-6 border-t border-line py-16">
          <h3 class="text-h2 text-text">اولین نوشته به‌زودی منتشر می‌شود</h3>
          <p class="max-w-xl text-body text-text-muted">
            این بخش تازه راه افتاده است. اولین نوشته دربارهٔ یکی از موضوع‌های جذب و پیگیری مشتری برای
            کسب‌وکارهای خدماتی منتشر می‌شود — بدون پرکردن صفحه با محتوای کم‌ارزش.
          </p>
          <p class="text-meta text-text-faint">
            اگر موضوعی ذهن شما را مشغول کرده، مستقیم بپرسید؛ پاسخ همین‌جا نوشته می‌شود.
          </p>
          <Button href="/contact" variant="secondary">پرسیدن مستقیم</Button>
        </div>
      )}

      {featured && (
        <article class="group border-b border-line py-10 lg:py-14" data-reveal>
          <a href={`/insights/${featured.id}`} class="grid gap-8 lg:grid-cols-12 lg:gap-16">
            <div class="flex flex-col items-start gap-4 lg:col-span-7">
              <div class="flex flex-wrap items-center gap-3">
                <span class="inline-flex items-center rounded-[4px] border border-line bg-surface px-2.5 py-1 text-caption text-accent-strong">
                  تازه‌ترین نوشته
                </span>
                <span class="text-meta text-text-faint">{featured.data.category}</span>
                <span class="text-meta text-text-faint">— {formatFaDate(featured.data.published_at)}</span>
              </div>
              <h3 class="text-h2 text-text transition-colors duration-150 group-hover:text-text-action">
                {featured.data.title}
              </h3>
              <p class="text-body text-text-muted measure-prose">{featured.data.description}</p>
              <span class="mt-2 inline-flex min-h-11 items-center gap-1.5 text-ui font-medium text-accent-strong transition-colors duration-150 group-hover:text-text-action">
                خواندن نوشته
                <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform duration-150 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M19 12H5" />
                  <path d="m12 19-7-7 7-7" />
                </svg>
              </span>
            </div>
            <div class="lg:col-span-5">
              <!-- Restrained brand geometry: the article index numeral panel -->
              <div class="flex h-full min-h-40 flex-col justify-between rounded-[4px] border border-line bg-surface-soft p-6 lg:min-h-52" aria-hidden="true">
                <span class="editorial-num">۰۱</span>
                <div class="flex items-center justify-between border-t border-line pt-4">
                  <span class="text-meta text-text-faint">نوونو · دیدگاه‌ها</span>
                  <svg viewBox="0 0 24 24" class="h-4 w-4 text-line-strong" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 12H5" />
                    <path d="m12 19-7-7 7-7" />
                  </svg>
                </div>
              </div>
            </div>
          </a>
        </article>
      )}

      {rest.length > 0 && (
        <ol class="flex flex-col" data-reveal-stagger>
          {rest.map((entry, i) => (
            <li class="border-b border-line" data-reveal-item={i}>
              <a
                href={`/insights/${entry.id}`}
                class="group grid gap-3 rounded-[4px] py-8 transition-colors duration-150 hover:bg-surface-soft/40 sm:grid-cols-[minmax(0,7fr)_minmax(0,3fr)] sm:gap-10 sm:px-3"
              >
                <span class="flex min-w-0 flex-col gap-2">
                  <span class="flex flex-wrap items-center gap-2 text-meta text-text-faint">
                    <span class="inline-flex rounded-[4px] border border-line bg-surface px-2 py-0.5 text-caption text-text-muted">{entry.data.category}</span>
                    <span>{formatFaDate(entry.data.published_at)}</span>
                  </span>
                  <span class="text-h3 text-text transition-colors duration-150 group-hover:text-text-action">{entry.data.title}</span>
                  <span class="text-body text-text-muted measure-prose">{entry.data.description}</span>
                </span>
                <span class="flex items-start justify-between gap-4 sm:justify-end">
                  <span class="editorial-num text-line-strong/70" aria-hidden="true">
                    {toFaDigits(String(i + 2).padStart(2, "0"))}
                  </span>
                  <svg viewBox="0 0 24 24" class="mt-2 h-4 w-4 flex-none text-line-strong transition-transform duration-150 group-hover:-translate-x-0.5 group-hover:text-text-action" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M19 12H5" />
                    <path d="m12 19-7-7 7-7" />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ol>
      )}

      <p class="mt-8 text-meta text-text-faint">
        {published.length > 0
          ? `${totalLabel} نوشتهٔ منتشرشده — هر نوشته یک مسئلهٔ واقعی از مسیر جذب مشتری را بررسی می‌کند.`
          : "هنوز نوشته‌ای منتشر نشده است."}
      </p>
    </div>
  </section>

  <!-- Route into services -->
  <section class="border-t border-line" aria-labelledby="insights-services-title">
    <div class="mx-auto grid max-w-[1200px] gap-10 px-5 py-14 sm:px-8 lg:grid-cols-12 lg:gap-16 lg:py-20">
      <div class="lg:col-span-5">
        <SectionHeader
          id="insights-services-title"
          kicker="بعد از خواندن"
          title="نوشته‌ها یک مسئله را روشن می‌کنند؛ حل آن با بررسی شروع می‌شود"
          lead="هر نوشته به یک نقطهٔ عملی ختم می‌شود. اگر مسئله‌ای که خواندید شبیه وضعیت کسب‌وکار شماست، قدم بعدی یک بررسی کوتاه است."
        />
      </div>
      <div class="flex flex-col justify-center gap-4 lg:col-span-7">
        <div class="border-t border-line pt-6">
          <h3 class="text-h3 text-text">از کجا شروع کنیم؟</h3>
          <p class="mt-3 text-body text-text-muted measure-prose">
            چند سؤال کوتاه درباره کسب‌وکارتان؛ بدون وعده فروش تضمینی. اگر همکاری مناسب نباشد، همان‌جا گفته می‌شود.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-4">
          <Button href="/audit" size="lg">درخواست بررسی مسیر جذب</Button>
          <Button href="/work" variant="secondary">دیدن کارهای واقعی</Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
