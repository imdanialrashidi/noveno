---
/**
 * 404 — calm, typographic, actionable (2026-08-14 redesign).
 * The broken-path motif was removed with the flowchart grammar.
 */

import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/ui/Button.astro";
import { CTA_URL, PRIMARY_CTA_LABEL } from "../data/site";
---

<PageLayout
  title="این نشانی پیدا نشد"
  description="صفحه موردنظر پیدا نشد؛ از اینجا به مسیر اصلی برگردید."
  path="/404"
>
  <section aria-labelledby="notfound-title">
    <div class="mx-auto flex max-w-[1200px] flex-col items-start gap-8 px-5 py-20 sm:px-8 lg:py-28">
      <p class="editorial-num" aria-hidden="true">۴۰۴</p>

      <h1 id="notfound-title" class="text-h1-page max-w-2xl text-text">
        این نشانی پیدا نشد.
      </h1>
      <p class="max-w-xl text-lead text-text-muted">
        صفحه‌ای که دنبالش بودید وجود ندارد یا جابه‌جا شده است. از این‌جا می‌توانید به صفحه اصلی برگردید.
      </p>

      <div class="flex flex-wrap gap-4">
        <Button href="/">صفحه اصلی</Button>
        <Button href="/work" variant="secondary">دیدن پروژه‌ها</Button>
        <Button href={CTA_URL} variant="secondary">{PRIMARY_CTA_LABEL}</Button>
      </div>
    </div>
  </section>
</PageLayout>
