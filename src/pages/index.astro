---
/**
 * Homepage (DESIGN §15 screens 1–5, Spec §10 sequence).
 * Hero → Problem Recognition → System Model → Core Offers → Proof →
 * System Components → Ideal Fit → Process → Measurement → Why Noveno →
 * FAQ → Final CTA.
 */

import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/ui/Button.astro";
import SectionHeader from "../components/layout/SectionHeader.astro";
import CTASection from "../components/layout/CTASection.astro";
import ChannelMap from "../components/business/ChannelMap.astro";
import BeforeAfterJourney from "../components/business/BeforeAfterJourney.astro";
import JourneyLine from "../components/business/JourneyLine.astro";
import OfferRow from "../components/business/OfferRow.astro";
import ProofRow from "../components/business/ProofRow.astro";
import FAQItem from "../components/ui/FAQItem.astro";
import { getCollection } from "astro:content";
import {
  HERO_HEADLINE,
  PRIMARY_CTA_LABEL,
  SECONDARY_CTA_LABEL,
  CTA_URL,
  CONTACT,
  OFFERS,
  SYSTEM_STAGES,
  PROCESS_STAGES,
  SYSTEM_COMPONENTS,
  GOOD_FIT,
  BAD_FIT,
  MEASURED_ACTIONS,
  FAQ_ITEMS,
} from "../data/site";

const proofEntries = (await getCollection("work"))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.published_at.valueOf() - a.data.published_at.valueOf());

const homeFaq = FAQ_ITEMS.slice(0, 6);

const jalali = (date: Date) => {
  return new Intl.DateTimeFormat("fa-IR", { year: "numeric", month: "long" }).format(date);
};
---

<PageLayout
  title="نوونو — سیستم جذب مشتری برای کسب‌وکارهای خدماتی"
  description="نوونو مسیر مشتری را از دیدن شما تا تماس، ثبت درخواست و پیگیری طراحی و اجرا می‌کند؛ بدون وعده فروش تضمینی. درخواست بررسی مسیر جذب را ثبت کنید."
  path="/"
>
  <!-- ============ Hero (screen 1) ============ -->
  <section aria-labelledby="hero-title">
    <div class="mx-auto grid max-w-[1200px] items-center gap-12 px-5 py-14 sm:px-8 lg:grid-cols-12 lg:gap-10 lg:py-20">
      <div class="flex flex-col items-start gap-6 lg:col-span-7">
        <p class="flex items-center gap-2 text-caption font-medium text-text-faint">
          <span class="h-1.5 w-1.5 rounded-[1px] bg-primary" aria-hidden="true"></span>
          سیستم جذب مشتری برای کسب‌وکارهای خدماتی
        </p>
        <h1 id="hero-title" class="text-display text-text">{HERO_HEADLINE}</h1>
        <p class="text-lead text-text-muted measure-prose">
          نوونو برای کسب‌وکارهای خدماتی، مسیر مشتری را از دیدن شما تا تماس، ثبت درخواست و پیگیری طراحی و اجرا می‌کند.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <Button href={CTA_URL} size="lg">{PRIMARY_CTA_LABEL}</Button>
          <Button href="/work" variant="secondary" size="lg">{SECONDARY_CTA_LABEL}</Button>
        </div>
        <p class="text-caption text-text-faint">
          بدون وعده فروش تضمینی؛ ابتدا مسیر فعلی کسب‌وکار بررسی می‌شود.
        </p>
      </div>

      <div class="lg:col-span-5">
        <div class="diagram-well rounded-[4px] p-6 sm:p-8">
          <ChannelMap
            id="hero-map"
            channels={["اینستاگرام", "گوگل", "معرفی", "تبلیغ"]}
            gate="صفحه / سایت"
            stations={["اقدام", "ثبت", "پیگیری", "نتیجه"]}
            description="کانال‌های پراکنده توجه (اینستاگرام، گوگل، معرفی، تبلیغ) از یک صفحه عبور می‌کنند و به یک مسیر قابل‌پیگیری می‌رسند: اقدام، ثبت، پیگیری و نتیجه."
            animate
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Problem Recognition (screen 2) ============ -->
  <section class="border-t border-line" aria-labelledby="problem-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeader
            id="problem-title"
            title="مشکل همیشه کمبود بازدید نیست؛ گاهی مسیر بعد از بازدید خراب است."
            lead="بازدید دارید، اما درخواست گم می‌شود: پیام در دایرکت می‌ماند، تماس ثبت نمی‌شود، پیگیری منظم نیست و هیچ‌کس نمی‌داند کدام کانال نتیجه داده است."
          />
          <ul class="flex flex-col gap-3">
            {[
              "درخواست‌ها در چند مسیر پراکنده می‌آیند (دایرکت، تماس، پیام، معرفی)",
              "ثبت منظمی وجود ندارد؛ منبع ورودی معلوم نیست",
              "پیگیری به حافظه وابسته است و نامنظم می‌شود",
              "نتیجه نهایی برای هیچ‌کس مشخص نیست",
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-body text-text-muted">
                <span class="mt-2.5 h-1.5 w-1.5 flex-none rounded-[1px] border border-line-strong" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="lg:col-span-7">
          <BeforeAfterJourney />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ System Model (screen 3) ============ -->
  <section class="border-t border-line" aria-labelledby="system-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <SectionHeader
        id="system-title"
        title="سیستم جذب: از پراکندگی به یک مسیر"
        lead="شش مرحله‌ای که هر کانال ورودی از آن عبور می‌کند تا توجه به یک درخواست ثبت‌شده و قابل‌پیگیری تبدیل شود."
      />

      <div class="diagram-well rounded-[4px] p-6 sm:p-10">
        <JourneyLine
          stations={SYSTEM_STAGES.map((stage) => ({ label: stage.label }))}
          label="شش مرحله سیستم جذب: جذب، متقاعدسازی، اقدام، ثبت، پیگیری، یادگیری"
        />
      </div>

      <dl class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {SYSTEM_STAGES.map((stage) => (
          <div class="border-t border-line pt-4">
            <dt class="flex items-center gap-2 text-ui font-semibold text-text">
              <span class="h-1.5 w-1.5 flex-none rounded-[1px] bg-primary" aria-hidden="true"></span>
              {stage.label}
            </dt>
            <dd class="mt-2 text-body text-text-muted">{stage.description}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-14 grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h3 class="text-h3 text-text">همه کانال‌ها از یک نقطه ثبت عبور می‌کنند</h3>
          <p class="mt-4 text-body text-text-muted measure-prose">
            اینستاگرام، گوگل، معرفی یا تبلیغ — فرقی ندارد از کجا آمده‌اید. مسیر طوری طراحی می‌شود که هر توجهی به یک نقطه واحد برسد: صفحه‌ای که درخواست را ثبت می‌کند و منبع ورودی را نگه می‌دارد.
          </p>
        </div>
        <div class="lg:col-span-7">
          <ChannelMap
            id="system-map"
            channels={["اینستاگرام", "گوگل", "معرفی"]}
            gate="فرم / تماس / واتساپ"
            stations={["لید ثبت‌شده", "پیگیری", "نتیجه"]}
            description="کانال‌های ورودی از یک درگاه واحد (فرم، تماس یا واتساپ) به مسیر ثبت، پیگیری و نتیجه می‌رسند."
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Core Offers (screen 4) ============ -->
  <section class="border-t border-line" aria-labelledby="offers-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <SectionHeader
        id="offers-title"
        title="سه شکل همکاری"
        lead="نه فهرست بلندبالای خدمات؛ سه مسیر مشخص که بسته به وضعیت کسب‌وکار انتخاب می‌شوند."
      />
      <div>
        {OFFERS.map((offer) => (
          <OfferRow offer={offer} href={offer.id === "audit" ? CTA_URL : "/services#offers"} />
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Proof (screen 5) ============ -->
  <section class="border-t border-line" aria-labelledby="proof-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <SectionHeader
        id="proof-title"
        title="کارهایی که می‌سازیم"
        lead="هر آنچه اینجا نشان داده می‌شود یا واقعاً ساخته شده است یا صریحاً «نمونه نمایشی» نام دارد. هیچ عددی بدون داده واقعی منتشر نمی‌شود."
      />
      <div class="flex flex-col">
        {proofEntries.map((entry) => (
          <ProofRow
            kind={entry.data.type}
            title={entry.data.title}
            summary={entry.data.summary}
            meta={`${entry.data.industry} — ${jalali(entry.data.published_at)}`}
            href={`/work/${entry.id}`}
            outcome={
              entry.data.type === "project"
                ? "نتیجه: در دست اندازه‌گیری"
                : entry.data.type === "concept"
                  ? "نمونه نمایشی — بدون داده عملکردی"
                  : undefined
            }
          />
        ))}
        <div class="flex items-center justify-between gap-4 border-t border-line pt-6">
          <p class="text-body text-text-muted">
            مطالعه موردی واقعی، به محض در دسترس بودن داده قابل انتشار، اضافه می‌شود.
          </p>
          <Button href="/work" variant="secondary">همه پروژه‌ها</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ System Components ============ -->
  <section class="border-t border-line" aria-labelledby="components-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeader
            id="components-title"
            title="اجزایی که یک سیستم می‌سازند"
            lead="این‌ها محصول‌های جدا نیستند؛ بلوک‌های ساختمانی‌اند. Noveno فقط اجزایی را انتخاب می‌کند که مشکل واقعی کسب‌وکار به آن‌ها نیاز دارد."
          />
        </div>
        <div class="lg:col-span-7">
          <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-[4px] border border-line bg-line sm:grid-cols-3">
            {SYSTEM_COMPONENTS.map((component) => (
              <li class="flex items-center gap-2.5 bg-canvas p-4">
                <span class="h-1.5 w-1.5 flex-none rounded-[1px] border border-line-strong" aria-hidden="true"></span>
                <span class="text-ui font-medium text-text">{component}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Ideal Fit (Spec §23) ============ -->
  <section class="border-t border-line" aria-labelledby="fit-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <SectionHeader id="fit-title" title="Noveno برای همه مناسب نیست." />
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="mb-5 flex items-center gap-2 text-ui font-semibold text-text">
            <span class="h-2 w-2 rounded-[1px] bg-primary" aria-hidden="true"></span>
            اگر این‌ها شبیه شماست
          </p>
          <ul class="flex flex-col gap-3">
            {GOOD_FIT.map((item) => (
              <li class="flex items-start gap-2.5 text-body text-text-muted">
                <span class="mt-2.5 h-2 w-2 flex-none rounded-[1px] bg-primary" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="mb-5 flex items-center gap-2 text-ui font-semibold text-text">
            <span class="h-2 w-2 rounded-[1px] border border-dashed border-line-strong" aria-hidden="true"></span>
            اگر دنبال این‌ها هستید
          </p>
          <ul class="flex flex-col gap-3">
            {BAD_FIT.map((item) => (
              <li class="flex items-start gap-2.5 text-body text-text-muted">
                <span class="mt-2.5 h-2 w-2 flex-none rounded-[1px] border border-dashed border-line-strong" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Process (screen 4) ============ -->
  <section class="border-t border-line" aria-labelledby="process-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeader
            id="process-title"
            title="یک چرخه، نه تحویل و خداحافظی"
            lead="بررسی ← طراحی ← اجرا ← اندازه‌گیری ← بهبود؛ و دوباره از اول. هر دور، بر اساس داده واقعی، مسیر را بهتر می‌کند."
          />
          <Button href="/process" variant="secondary">فرآیند کامل</Button>
        </div>
        <div class="lg:col-span-7">
          <div class="diagram-well rounded-[4px] p-6 sm:p-10">
            <JourneyLine
              stations={PROCESS_STAGES.map((stage) => ({ label: stage.label }))}
              label="فرآیند پنج مرحله‌ای: بررسی، طراحی، اجرا، اندازه‌گیری، بهبود — به صورت چرخه"
              loop
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Measurement ============ -->
  <section class="border-t border-line" aria-labelledby="measure-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeader
            id="measure-title"
            title="اگر اندازه نگیریم، نمی‌دانیم چه چیزی بهتر شده است."
            lead="شاخص‌های هر پروژه بر اساس مدل کسب‌وکار و مسیر مشتری تعیین می‌شوند؛ معیارهای نمایشی معیار نیستند."
          />
        </div>
        <div class="lg:col-span-7">
          <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-[4px] border border-line bg-line sm:grid-cols-3">
            {MEASURED_ACTIONS.map((action) => (
              <li class="flex items-center gap-2.5 bg-canvas p-4">
                <span class="h-1.5 w-1.5 flex-none rounded-[1px] bg-primary" aria-hidden="true"></span>
                <span class="text-ui font-medium text-text">{action}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Why Noveno ============ -->
  <section class="border-t border-line" aria-labelledby="why-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <SectionHeader id="why-title" title="چرا نوونو" lead="اصل‌هایی که جای ادعای بزرگ می‌نشینند." />
      <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { title: "کسب‌وکار اول", text: "فناوری در خدمت مسئله کسب‌وکار است، نه برعکس." },
          { title: "سیستم ساده", text: "پیچیدگی غیرضروری هزینه دارد؛ فقط آنچه لازم است ساخته می‌شود." },
          { title: "ساخته‌شده برای شرایط واقعی ایران", text: "موبایل، اینترنت ناپایدار، ابزارهای در دسترس و قابلیت جایگزینی." },
          { title: "اندازه‌گیری‌محور", text: "اقدام‌های مهم مشتری تا جایی که عملی باشد قابل ثبت و مقایسه می‌شوند." },
          { title: "AI کمک می‌کند، انسان تصمیم می‌گیرد", text: "از AI برای تحلیل و سرعت استفاده می‌کنیم؛ خروجی‌های مهم قبل از استفاده بررسی می‌شوند." },
          { title: "بدون تضمین دروغین", text: "فروش تضمین نمی‌شود؛ نتیجه تا جایی که داده اجازه دهد اندازه‌گیری و گزارش می‌شود." },
        ].map((item) => (
          <div class="border-t border-line pt-4">
            <h3 class="flex items-center gap-2 text-ui font-semibold text-text">
              <span class="h-1.5 w-1.5 flex-none rounded-[1px] bg-primary" aria-hidden="true"></span>
              {item.title}
            </h3>
            <p class="mt-2 text-body text-text-muted">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="border-t border-line" aria-labelledby="faq-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeader
            id="faq-title"
            title="سؤال‌هایی که معمولاً پیش می‌آید"
            lead="اگر سؤال دیگری دارید، مستقیم بپرسید — بدون فرم‌های واسطه."
          />
          <Button href={CONTACT.phoneHref} variant="secondary">
            تماس مستقیم
            <span class="text-caption tnum" dir="ltr">{CONTACT.phone}</span>
          </Button>
        </div>
        <div class="lg:col-span-7">
          <div class="border-t border-line">
            {homeFaq.map((item) => (
              <FAQItem question={item.q} answer={item.a} />
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Final CTA ============ -->
  <CTASection />
</PageLayout>
