---
/**
 * Homepage (2026-10 focus pass — fifth review, docs/DESIGN.md §0/§3.7).
 *
 * The page is deliberately short. The first viewport answers: what
 * Noveno does, who it is for, what outcome it serves, what to do next.
 * Structure (each section earns its place):
 *   hero      → the thesis line + one primary action + brand artwork
 *   problem   → the leak, in three lines
 *   how       → three steps + the real audit-UI surface (real proof)
 *   proof     → two real project previews with honest labels
 *   offers    → three tiers, تومان starting prices, validity note
 *   founder   → دانیال رشیدی, founder-led trust, no invented bio
 *   faq       → the five real objections, short answers
 *   CTA       → brand-led finish
 *
 * Removed in this pass (their substance lives on the page that owns it):
 * a separate process section, the six-principles grid, the fit list, and
 * the blog teaser band. No unverified metric, dashboard, or percentage
 * appears anywhere; there is no measured client data behind one.
 */

import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/ui/Button.astro";
import SectionHeader from "../components/layout/SectionHeader.astro";
import CTASection from "../components/layout/CTASection.astro";
import OfferRow from "../components/business/OfferRow.astro";
import WorkCard from "../components/business/WorkCard.astro";
import FAQItem from "../components/ui/FAQItem.astro";
import ChannelLink from "../components/ui/ChannelLink.astro";
import HeroArtwork from "../components/brand/HeroArtwork.astro";
import { getCollection } from "astro:content";
import { previewFor } from "../data/work-previews";
import { imageUrl } from "../generated/image-manifest";
import {
  HERO_HEADLINE,
  HERO_KICKER,
  HERO_LEAD,
  HERO_MICROCOPY,
  PRIMARY_CTA_LABEL,
  SECONDARY_CTA_LABEL,
  CTA_URL,
  CONTACT,
  OFFERS,
  HOW_IT_WORKS,
  HOME_FAQ,
  PRIORITY_SEGMENTS,
  PRICING_NOTE,
  FOUNDER,
  toFaDigits,
} from "../data/site";

/**
 * The two homepage proof entries are an editorial choice, not a sort
 * order: Noveno's own site (the same process, self-hosted) plus one
 * service-business project in a priority segment. A slug that is not
 * published falls back to the newest published entry, so the section
 * can never render empty.
 */
const published = (await getCollection("work")).filter(({ data }) => !data.draft);
const HOMEPAGE_PROOF = ["noveno-website", "php-ielts-house"];
const proofEntries = HOMEPAGE_PROOF.map((id) => published.find((e) => e.id === id)).filter(
  (entry): entry is NonNullable<typeof entry> => Boolean(entry),
);
if (proofEntries.length < 2) {
  proofEntries.push(...published.filter((e) => !proofEntries.includes(e)).slice(0, 2 - proofEntries.length));
}

const jalali = (date: Date) =>
  new Intl.DateTimeFormat("fa-IR", { year: "numeric", month: "long" }).format(date);

/* Editorial numerals ۰۱ … */
const faIndex = (i: number) => toFaDigits(String(i + 1).padStart(2, "0"));

/* Real product surface — the lead form, captured from this site's own
   production build (docs/IMAGERY.md). Content-hashed URLs via the image
   manifest — never hard-coded paths. */
const FORM_SHOT = {
  w1440: imageUrl("work/noveno-website-audit.webp"),
  w720: imageUrl("work/noveno-website-audit-800.webp"),
  alt: "فرم درخواست بررسی در وب‌سایت نوونو — نام، شماره تماس، نوع کسب‌وکار و نشانی سایت یا اینستاگرام",
  caption: "نمونه واقعی از فرم نوونو: پنج سؤال کوتاه، بعد تماس.",
};
const FORM_SRCSET = `${FORM_SHOT.w1440} 1440w, ${FORM_SHOT.w720} 720w`;

/* The four hero stage words — typography + geometry, never a diagram. */
const HERO_STAGES = ["توجه", "درخواست", "ثبت", "پیگیری"];
---

<PageLayout
  title="سیستم جذب مشتری برای کسب‌وکارهای خدماتی | نوونو"
  description="نوونو برای کسب‌وکارهای خدماتی ایرانی مسیر جذب مشتری را می‌سازد؛ از بازدید تا ثبت درخواست و پیگیری. بررسی اولیه رایگان است."
  path="/"
  ogImage="/og.png"
  ogImageAlt="نوونو — سیستم جذب مشتری برای کسب‌وکارهای خدماتی"
>
  <!-- LCP is the hero headline text (Estedad is preloaded in BaseLayout);
       the hero carries NO raster media — the brand artwork is one
       inline SVG. Real product screenshots below the fold stay lazy. -->

  <!-- ============ Hero — thesis, audience, action ============ -->
  <section aria-labelledby="hero-title" data-hero-parallax>
    <div class="mx-auto max-w-[1200px] px-5 pb-12 pt-12 sm:px-8 lg:pb-16 lg:pt-20">
      <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-8">
        <!-- Primary side: kicker + thesis + one primary action (right, RTL-first) -->
        <div class="flex flex-col items-start lg:col-span-6">
          <p class="text-ui font-medium text-text-faint">{HERO_KICKER}</p>
          <span data-hero-accent class="mt-3 block h-0.5 w-8 rounded-full bg-primary" aria-hidden="true"
          ></span>
          <h1 id="hero-title" class="mt-4 text-display text-text">{HERO_HEADLINE}</h1>
          <p class="mt-6 max-w-xl text-lead text-text-muted">{HERO_LEAD}</p>
          {
            /* One primary action per section: on mobile both actions take
              the full column width so the tap targets read as a pair. */
          }
          <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:items-center sm:gap-4">
            <Button
              href={CTA_URL}
              size="lg"
              class="w-full sm:w-auto"
              data={{ "data-event": "primary_cta_click", "data-event-payload": '{"section":"hero"}' }}
              >{PRIMARY_CTA_LABEL}</Button
            >
            <Button
              href="/work"
              variant="secondary"
              size="lg"
              class="w-full sm:w-auto"
              data={{ "data-event": "secondary_cta_click", "data-event-payload": '{"section":"hero"}' }}
              >{SECONDARY_CTA_LABEL}</Button
            >
          </div>
          <p class="mt-4 text-meta text-text-faint">{HERO_MICROCOPY}</p>
        </div>

        <!-- Visual side: the brand artwork — scattered signals finding
             structure. The square field hangs below the headline block
             and bleeds out of its column toward the page edge (a
             controlled 32px escape; no overflow at ≥1024px). The
             4-stage strip beneath is typography + small squares, not a
             diagram (motion §12.2). -->
        <div class="lg:col-span-6">
          <div class="lg:-me-6 lg:mt-8">
            <HeroArtwork />
            <div
              class="hero-stages mt-6"
              data-hero-stages
              aria-label="چهار گام مسیر: توجه، درخواست، ثبت، پیگیری"
            >
              <span class="sr-only">توجه، درخواست، ثبت، پیگیری</span>
              {
                HERO_STAGES.map((stage, i) => (
                  <Fragment>
                    <span class="hero-stage" aria-hidden="true">
                      <span class="text-meta font-semibold text-text-action tnum">{faIndex(i)}</span>
                      <span class="text-ui font-medium text-text-muted">{stage}</span>
                    </span>
                    {i < HERO_STAGES.length - 1 && (
                      <span class="h-1 w-1 flex-none rounded-[1px] bg-line-strong" aria-hidden="true" />
                    )}
                  </Fragment>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Problem — three lines, no image, no repeated explanation ============ -->
  <section class="border-t border-line" aria-labelledby="problem-title">
    <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:py-20">
      <SectionHeader
        id="problem-title"
        title="بازدید دارید، ولی درخواست گم می‌شود."
        lead="توجه پخش است و ثبت نیست. هر درخواست در کانال خودش می‌ماند، پیگیری به حافظه وابسته می‌شود و هیچ‌کس نمی‌گوید کدام کانال مشتری آورده."
      />
      <ol class="grid gap-x-12 gap-y-6 sm:grid-cols-3" data-reveal-stagger>
        {
          [
            "درخواست‌ها در دایرکت، تماس و پیام پراکنده می‌مانند و جای مشخصی برای ثبت ندارند.",
            "منبع ورودی معلوم نیست؛ بودجهٔ تبلیغ بدون داده خرج می‌شود.",
            "پیگیری منظم نیست، پس بخشی از درخواست‌ها بی‌صدا از دست می‌رود.",
          ].map((item, i) => (
            <li
              class="border-t-2 border-line pt-5"
              style="--sweep-weight: 2px"
              data-reveal-item={i}
              data-sweep
            >
              <span class="text-xl font-extrabold text-text-action tnum">{faIndex(i)}</span>
              <p class="mt-3 text-body font-medium text-text">{item}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ How it works — three steps + the real form ============ -->
  <section class="border-t border-line" aria-labelledby="how-title">
    <div class="mx-auto grid max-w-[1200px] gap-12 px-5 py-14 sm:px-8 lg:grid-cols-12 lg:gap-16 lg:py-20">
      <!-- The section's accessible name: the three steps below are the
           argument, so the heading is carried visually by them. -->
      <h2 id="how-title" class="sr-only">مسیر جذب، مرحله به مرحله</h2>
      <ol class="flex flex-col lg:col-span-6" data-reveal-stagger>
        {
          HOW_IT_WORKS.map((step, i) => (
            <li
              class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 border-t border-line py-7"
              data-reveal-item={i}
              data-sweep
            >
              <span class="editorial-num">{faIndex(i)}</span>
              <div class="flex flex-col gap-2">
                <h3 class="text-h3 text-text">{step.title}</h3>
                <p class="text-body text-text-muted measure-prose">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <!-- Real product surface: this site's own lead form -->
      <div class="lg:col-span-6" data-reveal>
        <figure class="media-figure">
          <div class="media-frame aspect-[16/10]">
            <img
              src={FORM_SHOT.w1440}
              srcset={FORM_SRCSET}
              sizes="(min-width: 1024px) 560px, 92vw"
              width="1440"
              height="900"
              loading="lazy"
              decoding="async"
              alt={FORM_SHOT.alt}
            />
          </div>
          <figcaption class="media-caption">{FORM_SHOT.caption}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ Proof — real projects, honest labels ============ -->
  <section class="border-t border-line" aria-labelledby="proof-title">
    <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:py-20">
      <div data-reveal>
        <SectionHeader
          id="proof-title"
          kicker="نمونه‌کار"
          title="کاری که ساخته شده"
          lead="پیش‌نمایش‌ها واقعی‌اند. جایی که هنوز داده‌ای برای نتیجه نداریم، ننویسیم."
        />
      </div>
      <div class="flex flex-col">
        {
          proofEntries.map((entry, index) => (
            <WorkCard
              kind={entry.data.type}
              title={entry.data.title}
              summary={entry.data.summary}
              meta={`${entry.data.industry} — ${jalali(entry.data.published_at)}`}
              href={`/work/${entry.id}`}
              outcome={
                entry.data.type === "project"
                  ? "نتیجه: در دست اندازه‌گیری"
                  : entry.data.type === "concept"
                    ? "نمونه نمایشی — بدون داده عملکردی"
                    : undefined
              }
              preview={previewFor(entry.id)}
              featured={index === 0}
              flip={index % 2 === 1}
            />
          ))
        }
        <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
          <p class="text-body text-text-muted">
            مطالعه موردی با داده واقعی، به محض در دسترس بودن منتشر می‌شود.
          </p>
          <Button href="/work" variant="secondary">همه نمونه‌کارها</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Offers — three tiers, تومان starting prices ============ -->
  <section class="border-t border-line" aria-labelledby="offers-title">
    <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:py-20">
      <SectionHeader
        id="offers-title"
        kicker="همکاری"
        title="سه بسته، با قیمت شروع مشخص"
        lead="هر بسته برای یک وضعیت مشخص است. اگر نمی‌دانید کدام لازم دارید، در بررسی اولیه با هم مشخص می‌کنیم."
      />
      <div class="border-b border-line" data-reveal-stagger>
        {
          OFFERS.map((offer, index) => (
            <OfferRow offer={offer} index={index} href={offer.id === "landing" ? CTA_URL : "/pricing"} />
          ))
        }
      </div>
      <p class="mt-6 max-w-3xl text-meta text-text-faint">{PRICING_NOTE}</p>
    </div>
  </section>

  <!-- ============ Priority segments — the problem each one brings ============ -->
  <section class="border-t border-line" aria-labelledby="segments-title">
    <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:py-20">
      <SectionHeader
        id="segments-title"
        title="بیشتر با این مسائل روبه‌رو هستیم"
        lead="نه ادعای تخصص در یک صنعت؛ مسئله‌ای که در هر سه یکسان است: درخواست هست، ولی مسیر ندارد."
      />
      <ul class="grid gap-x-12 gap-y-8 sm:grid-cols-3" data-reveal>
        {
          PRIORITY_SEGMENTS.map((segment) => (
            <li
              class="flex flex-col gap-3 border-t-2 border-line pt-5"
              style="--sweep-weight: 2px"
              data-sweep
            >
              <h3 class="text-h3 text-text">{segment.name}</h3>
              <p class="text-body text-text-muted">{segment.problem}</p>
              <p class="border-t border-line pt-3 text-meta text-text-faint">
                <span class="font-semibold text-text-muted">پاسخ نوونو: </span>
                {segment.approach}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ Founder — founder-led trust, no invented biography ============ -->
  <section class="border-t border-line" aria-labelledby="founder-title">
    <div class="mx-auto grid max-w-[1200px] gap-10 px-5 py-14 sm:px-8 lg:grid-cols-12 lg:gap-16 lg:py-20">
      <div class="flex flex-col items-start gap-5 lg:col-span-7">
        <p class="text-ui font-medium text-text-faint">بنیان‌گذار</p>
        <h2 id="founder-title" class="text-h2 text-text">
          {FOUNDER.name} — {FOUNDER.role}
        </h2>
        <p class="max-w-2xl text-body text-text-muted">{FOUNDER.bio}</p>
        <p class="max-w-2xl text-body text-text-muted">
          همین وب‌سایت با همان روالی ساخته شده که برای مشتری اجرا می‌شود: مسیر روشن، ثبت درخواست، اندازه‌گیری
          و پیگیری.
        </p>
        <Button href="/about" variant="secondary">درباره نوونو</Button>
      </div>
      <div class="flex flex-col gap-3 lg:col-span-5">
        <p class="text-meta text-text-faint">اگر ترجیح می‌دهید صحبت کنید</p>
        <ul class="flex flex-col border-t border-line pt-1">
          <li>
            <ChannelLink
              icon="phone"
              label={CONTACT.phone}
              value="تماس"
              href={CONTACT.phoneHref}
              event={{ name: "phone_click", payload: { section: "founder" } }}
            />
          </li>
          <li>
            <ChannelLink
              icon="whatsapp"
              label="واتساپ"
              href={CONTACT.whatsappHref}
              external
              event={{ name: "messaging_click", payload: { section: "founder", channel: "whatsapp" } }}
            />
          </li>
          <li>
            <ChannelLink
              icon="telegram"
              label="تلگرام"
              href={CONTACT.telegramHref}
              external
              event={{ name: "messaging_click", payload: { section: "founder", channel: "telegram" } }}
            />
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ FAQ — the real objections, short answers ============ -->
  <section class="border-t border-line" aria-labelledby="faq-title">
    <div class="mx-auto grid max-w-[1200px] gap-10 px-5 py-14 sm:px-8 lg:grid-cols-12 lg:gap-16 lg:py-20">
      <div class="flex flex-col items-start gap-5 lg:col-span-4">
        <SectionHeader id="faq-title" kicker="پرسش‌ها" title="چیزهایی که معمولاً پرسیده می‌شود" />
        <Button href={CTA_URL} variant="secondary">{PRIMARY_CTA_LABEL}</Button>
      </div>
      <div class="lg:col-span-8" data-reveal>
        <div class="border-t border-line" data-sweep>
          {HOME_FAQ.map((item) => <FAQItem question={item.q} answer={item.a} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Final CTA — brand-led finish ============ -->
  <CTASection brand />
</PageLayout>
