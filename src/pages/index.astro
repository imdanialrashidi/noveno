---
/**
 * Homepage (2026-08-14 founder redesign — image-led editorial system).
 * The flowchart/route grammar is removed from the public design;
 * the page is built from Typography + Photography + Real Product
 * Screens + Editorial Numbers.
 *
 * Media rhythm (≈6 visual moments, no decorative filler):
 *   hero      → one strong photograph of a real working environment
 *   problem   → contextual photograph + two large textual states
 *   system    → real screenshot of the audit channel step (real UI)
 *   work      → large real screenshots (proof section)
 *   process   → typography-led numbered sequence
 *   final CTA → strong cropped photograph finish
 *
 * Photography: Wikimedia Commons CC0 (Mostafa Meraji — Iranian service
 * businesses), stored locally, right-sized AVIF/WebP, captioned with
 * provenance. Real product screenshots are captured from this site's
 * own production build.
 */

import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/ui/Button.astro";
import SectionHeader from "../components/layout/SectionHeader.astro";
import CTASection from "../components/layout/CTASection.astro";
import OfferRow from "../components/business/OfferRow.astro";
import WorkCard from "../components/business/WorkCard.astro";
import FAQItem from "../components/ui/FAQItem.astro";
import { getCollection } from "astro:content";
import { previewFor } from "../data/work-previews";
import {
  HERO_HEADLINE,
  PRIMARY_CTA_LABEL,
  SECONDARY_CTA_LABEL,
  CTA_URL,
  CONTACT,
  OFFERS,
  SYSTEM_STAGES,
  PROCESS_STAGES,
  GOOD_FIT,
  BAD_FIT,
  FAQ_ITEMS,
  toFaDigits,
} from "../data/site";

const proofEntries = (await getCollection("work"))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.published_at.valueOf() - a.data.published_at.valueOf());

const homeFaq = FAQ_ITEMS.slice(0, 6);

const jalali = (date: Date) => {
  return new Intl.DateTimeFormat("fa-IR", { year: "numeric", month: "long" }).format(date);
};

/* Editorial numerals ۰۱ … */
const faIndex = (i: number) => toFaDigits(String(i + 1).padStart(2, "0"));

/* Real, captioned photography — CC0 (Mostafa Meraji, Wikimedia Commons). */
const HERO_PHOTO = {
  alt: "آرایشگاه مردانه در مشهد — محیط واقعی کار یک کسب‌وکار خدماتی",
  caption: "محیط واقعی کار یک کسب‌وکار خدماتی — عکس: Mostafa Meraji (CC0)",
};
const PROBLEM_PHOTO = {
  alt: "سالن زیبایی در مشهد — کسب‌وکار خدماتی که درخواست مشتری دریافت می‌کند",
  caption: "سالن زیبایی در مشهد — عکس: Mostafa Meraji (CC0)",
};
---

<PageLayout
  title="سیستم جذب مشتری برای کسب‌وکارهای خدماتی | نوونو"
  description="نوونو مسیر مشتری را از دیدن شما تا تماس، ثبت درخواست و پیگیری طراحی و اجرا می‌کند؛ بدون وعده فروش تضمینی. درخواست بررسی مسیر جذب را ثبت کنید."
  path="/"
>
  <!-- LCP media: preload the hero photograph (AVIF first). -->
  <link
    rel="preload"
    as="image"
    href="/images/photography/barbershop-workday-1600.avif"
    imagesrcset="/images/photography/barbershop-workday-1600.avif 1600w, /images/photography/barbershop-workday-800.avif 800w"
    imagesizes="(min-width: 1024px) 560px, 92vw"
    type="image/avif"
    slot="head"
  />

  <!-- ============ Hero — one strong visual composition ============ -->
  <section aria-labelledby="hero-title" class="border-b border-line">
    <div class="mx-auto max-w-[1200px] px-5 pb-16 pt-14 sm:px-8 lg:pb-24 lg:pt-20">
      <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
        <!-- Primary side: headline + support + CTAs (right, RTL-first) -->
        <div class="flex flex-col items-start lg:col-span-6">
          <p class="text-ui font-medium text-text-faint">
            سیستم جذب مشتری برای کسب‌وکارهای خدماتی
          </p>
          <h1 id="hero-title" class="mt-4 text-display text-text">{HERO_HEADLINE}</h1>
          <p class="mt-6 text-lead text-text-muted measure-prose">
            نوونو برای کسب‌وکارهای خدماتی، مسیر مشتری را از دیدن شما تا تماس، ثبت درخواست و پیگیری طراحی و اجرا می‌کند.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <Button
              href={CTA_URL}
              size="lg"
              data={{ "data-event": "primary_cta_click", "data-event-payload": '{"section":"hero"}' }}
            >{PRIMARY_CTA_LABEL}</Button>
            <Button
              href="/work"
              variant="secondary"
              size="lg"
              data={{ "data-event": "secondary_cta_click", "data-event-payload": '{"section":"hero"}' }}
            >{SECONDARY_CTA_LABEL}</Button>
          </div>
          <p class="mt-4 text-meta text-text-faint">
            بدون وعده فروش تضمینی؛ ابتدا مسیر فعلی کسب‌وکار بررسی می‌شود.
          </p>
        </div>

        <!-- Visual side: one large editorial photograph -->
        <div class="lg:col-span-6">
          <figure class="media-figure">
            <div class="media-frame aspect-[3/2]">
              <picture>
                <source
                  type="image/avif"
                  srcset="/images/photography/barbershop-workday-1600.avif 1600w, /images/photography/barbershop-workday-800.avif 800w"
                  sizes="(min-width: 1024px) 560px, 92vw"
                />
                <img
                  src="/images/photography/barbershop-workday-1600.webp"
                  srcset="/images/photography/barbershop-workday-1600.webp 1600w, /images/photography/barbershop-workday-800.webp 800w"
                  sizes="(min-width: 1024px) 560px, 92vw"
                  width="1600"
                  height="1067"
                  fetchpriority="high"
                  decoding="async"
                  alt={HERO_PHOTO.alt}
                />
              </picture>
            </div>
            <figcaption class="media-caption">{HERO_PHOTO.caption}</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Problem — photograph + editorial states ============ -->
  <section class="border-t border-line" aria-labelledby="problem-title">
    <div class="mx-auto grid max-w-[1200px] gap-12 px-5 py-16 sm:px-8 lg:grid-cols-12 lg:gap-16 lg:py-28">
      <div class="flex flex-col items-start gap-8 lg:col-span-5">
        <SectionHeader
          id="problem-title"
          title="مشکل همیشه کمبود بازدید نیست؛ گاهی مسیر بعد از بازدید خراب است."
          lead="بازدید دارید، اما درخواست گم می‌شود: پیام در دایرکت می‌ماند، تماس ثبت نمی‌شود، پیگیری منظم نیست و هیچ‌کس نمی‌داند کدام کانال نتیجه داده است."
        />
        <ol class="flex w-full flex-col">
          {[
            "درخواست‌ها در چند مسیر پراکنده می‌آیند (دایرکت، تماس، پیام، معرفی)",
            "ثبت منظمی وجود ندارد؛ منبع ورودی معلوم نیست",
            "پیگیری به حافظه وابسته است و نامنظم می‌شود",
            "نتیجه نهایی برای هیچ‌کس مشخص نیست",
          ].map((item, i) => (
            <li class="grid grid-cols-[auto_1fr] items-baseline gap-4 border-t border-line py-4">
              <span class="text-xl font-extrabold text-text-action tnum">{faIndex(i)}</span>
              <span class="text-body font-medium text-text">{item}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="flex flex-col gap-10 lg:col-span-7">
        <figure class="media-figure">
          <div class="media-frame aspect-[16/10]">
            <img
              src="/images/photography/salon-workday-1600.webp"
              srcset="/images/photography/salon-workday-1600.webp 1600w, /images/photography/salon-workday-800.webp 800w"
              sizes="(min-width: 1024px) 660px, 92vw"
              width="1600"
              height="1000"
              loading="lazy"
              decoding="async"
              alt={PROBLEM_PHOTO.alt}
            />
          </div>
          <figcaption class="media-caption">{PROBLEM_PHOTO.caption}</figcaption>
        </figure>

        <!-- Two large textual states — comparison without a graph -->
        <div class="grid gap-8 sm:grid-cols-2">
          <div class="border-t-2 border-line pt-5">
            <p class="text-h3 text-text">امروز</p>
            <p class="mt-3 text-body text-text-muted">
              درخواست‌ها در دایرکت، تماس و پیام پراکنده‌اند؛ منبع ورودی معلوم نیست و پیگیری به حافظه وابسته است.
            </p>
          </div>
          <div class="border-t-2 border-line pt-5">
            <p class="text-h3 text-text-action">با نوونو</p>
            <p class="mt-3 text-body text-text-muted">
              هر درخواست با منبع، وضعیت و پیگیری مشخص ثبت می‌شود؛ نتیجه برای کسب‌وکار قابل اندازه‌گیری است.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ System — editorial sequence + real UI preview ============ -->
  <section class="border-t border-line" aria-labelledby="system-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-28">
      <SectionHeader
        id="system-title"
        kicker="سیستم جذب"
        title="از پراکندگی به یک نقطه ثبت واحد"
        lead="شش مرحله‌ای که هر کانال ورودی از آن عبور می‌کند تا توجه به یک درخواست ثبت‌شده و قابل‌پیگیری تبدیل شود — ترتیب، پیگیری و اندازه‌گیری؛ بدون نیاز به رسم یک نمودار."
      />

      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <ol class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:col-span-7">
          {SYSTEM_STAGES.map((stage, i) => (
            <li class="border-t-2 border-line pt-6">
              <span class="editorial-num">{faIndex(i)}</span>
              <h3 class="mt-3 text-h3 text-text">{stage.label}</h3>
              <p class="mt-2 text-body text-text-muted">{stage.description}</p>
            </li>
          ))}
        </ol>

        <!-- Real product surface: the audit channel step (real UI) -->
        <div class="lg:col-span-5">
          <figure class="media-figure">
            <div class="media-frame aspect-[16/10]">
              <img
                src="/images/work/noveno-website-audit.webp"
                srcset="/images/work/noveno-website-audit.webp 1440w, /images/work/noveno-website-audit-800.webp 720w"
                sizes="(min-width: 1024px) 480px, 92vw"
                width="1440"
                height="900"
                loading="lazy"
                decoding="async"
                alt="فرم بررسی مسیر جذب در وب‌سایت نوونو — مرحله انتخاب کانال‌های ورودی"
              />
            </div>
            <figcaption class="media-caption">
              نمونه واقعی از رابط نوونو: درخواست‌ها با منبع ورودی‌شان ثبت می‌شوند.
            </figcaption>
          </figure>
        </div>
      </div>

      <!-- Channel → single registration point, as a text row -->
      <div class="mt-14 flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-line pt-6 text-ui">
        <span class="font-medium text-text">همه کانال‌ها</span>
        <span class="text-text-muted">— اینستاگرام، گوگل، معرفی، تبلیغ —</span>
        <span class="font-semibold text-text-action">به یک نقطه ثبت واحد می‌رسند</span>
        <span class="text-text-muted">و پس از آن، پیگیری و اندازه‌گیری.</span>
      </div>
    </div>
  </section>

  <!-- ============ Core Offers (screen 4) ============ -->
  <section class="border-t border-line" aria-labelledby="offers-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-28">
      <SectionHeader
        id="offers-title"
        kicker="همکاری"
        title="سه شکل همکاری"
        lead="نه فهرست بلندبالای خدمات؛ سه مسیر مشخص که بسته به وضعیت کسب‌وکار انتخاب می‌شوند."
      />
      <div class="border-b border-line">
        {OFFERS.map((offer, index) => (
          <OfferRow offer={offer} index={index} href={offer.id === "audit" ? CTA_URL : "/services#offers"} />
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Proof — work with large real previews ============ -->
  <section class="border-t border-line" aria-labelledby="proof-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-28">
      <SectionHeader
        id="proof-title"
        kicker="کارها"
        title="کارهایی که می‌سازیم"
        lead="هر آنچه اینجا نشان داده می‌شود یا واقعاً ساخته شده است یا صریحاً «نمونه نمایشی» نام دارد. هیچ عددی بدون داده واقعی منتشر نمی‌شود."
      />
      <div class="flex flex-col">
        {proofEntries.map((entry, index) => (
          <WorkCard
            kind={entry.data.type}
            title={entry.data.title}
            summary={entry.data.summary}
            meta={`${entry.data.industry} — ${jalali(entry.data.published_at)}`}
            href={`/work/${entry.id}`}
            outcome={
              entry.data.type === "project"
                ? "نتیجه: در دست اندازه‌گیری"
                : entry.data.type === "concept"
                  ? "نمونه نمایشی — بدون داده عملکردی"
                  : undefined
            }
            preview={previewFor(entry.id)}
            featured={index === 0}
            flip={index % 2 === 1}
          />
        ))}
        <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
          <p class="text-body text-text-muted">
            مطالعه موردی واقعی، به محض در دسترس بودن داده قابل انتشار، اضافه می‌شود.
          </p>
          <Button href="/work" variant="secondary">همه پروژه‌ها</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Process — typography-led sequence ============ -->
  <section class="border-t border-line" aria-labelledby="process-title">
    <div class="mx-auto grid max-w-[1200px] gap-12 px-5 py-16 sm:px-8 lg:grid-cols-12 lg:gap-16 lg:py-28">
      <div class="flex flex-col items-start gap-6 lg:col-span-5">
        <SectionHeader
          id="process-title"
          kicker="فرآیند"
          title="یک چرخه، نه تحویل و خداحافظی"
          lead="بررسی، طراحی، اجرا، اندازه‌گیری، بهبود — و دوباره از اول. هر دور، بر اساس داده واقعی، مسیر را بهتر می‌کند."
        />
        <Button href="/process" variant="secondary">فرآیند کامل</Button>
      </div>
      <ol class="flex flex-col lg:col-span-7">
        {PROCESS_STAGES.map((stage, i) => (
          <li class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 border-t border-line py-7 sm:gap-x-10">
            <span class="editorial-num">{faIndex(i)}</span>
            <div class="flex flex-col gap-2">
              <h3 class="text-h3 text-text">{stage.label}</h3>
              <p class="text-body text-text-muted measure-prose">{stage.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ Ideal Fit (Spec §23) ============ -->
  <section class="border-t border-line" aria-labelledby="fit-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-28">
      <SectionHeader id="fit-title" kicker="همکاری" title="Noveno برای همه مناسب نیست." lead="این صراحت به نفع هر دو طرف است؛ همکاری نامناسب برای هیچ‌کس ارزش نمی‌سازد." />
      <div class="grid gap-6 lg:grid-cols-2 lg:gap-10">
        <div class="panel p-6 sm:p-8 lg:p-10">
          <p class="mb-6 text-h3 text-text">اگر این‌ها شبیه شماست</p>
          <ul class="flex flex-col">
            {GOOD_FIT.map((item) => (
              <li class="flex items-start gap-3 border-t border-line py-3 text-body text-text-muted">
                <svg viewBox="0 0 24 24" class="mt-2 h-4 w-4 flex-none text-success" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="panel p-6 sm:p-8 lg:p-10">
          <p class="mb-6 text-h3 text-text">اگر دنبال این‌ها هستید</p>
          <ul class="flex flex-col">
            {BAD_FIT.map((item) => (
              <li class="flex items-start gap-3 border-t border-line py-3 text-body text-text-muted">
                <svg viewBox="0 0 24 24" class="mt-2 h-4 w-4 flex-none text-text-faint" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 6 6 18M6 6l12 12" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Why Noveno ============ -->
  <section class="border-t border-line" aria-labelledby="why-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-28">
      <SectionHeader id="why-title" kicker="اصول" title="چرا نوونو" lead="اصل‌هایی که جای ادعای بزرگ می‌نشینند." />
      <ol class="grid gap-x-14 sm:grid-cols-2">
        {[
          { title: "کسب‌وکار اول", text: "فناوری در خدمت مسئله کسب‌وکار است، نه برعکس." },
          { title: "سیستم ساده", text: "پیچیدگی غیرضروری هزینه دارد؛ فقط آنچه لازم است ساخته می‌شود." },
          { title: "ساخته‌شده برای شرایط واقعی ایران", text: "موبایل، اینترنت ناپایدار، ابزارهای در دسترس و قابلیت جایگزینی." },
          { title: "اندازه‌گیری‌محور", text: "اقدام‌های مهم مشتری تا جایی که عملی باشد قابل ثبت و مقایسه می‌شوند." },
          { title: "AI کمک می‌کند، انسان تصمیم می‌گیرد", text: "از AI برای تحلیل و سرعت استفاده می‌کنیم؛ خروجی‌های مهم قبل از استفاده بررسی می‌شوند." },
          { title: "بدون تضمین دروغین", text: "فروش تضمین نمی‌شود؛ نتیجه تا جایی که داده اجازه دهد اندازه‌گیری و گزارش می‌شود." },
        ].map((item, i) => (
          <li class="border-t border-line py-6">
            <span class="text-xl font-extrabold text-text-action tnum">{faIndex(i)}</span>
            <h3 class="mt-2 text-ui font-semibold text-text">{item.title}</h3>
            <p class="mt-2 text-body text-text-muted">{item.text}</p>
          </li>
        ))}
      </ol>
      <p class="mt-10 border-t border-line pt-6 text-body text-text-muted">
        <a href="/about" class="text-link">بخوانید چرا نوونو وجود دارد و چگونه کار می‌کند</a> — و این وب‌سایت چطور با همین اصول ساخته شده است.
      </p>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="border-t border-line" aria-labelledby="faq-title">
    <div class="mx-auto grid max-w-[1200px] gap-10 px-5 py-16 sm:px-8 lg:grid-cols-12 lg:gap-16 lg:py-28">
      <div class="flex flex-col items-start gap-6 lg:col-span-5">
        <SectionHeader
          id="faq-title"
          kicker="پرسش‌ها"
          title="سؤال‌هایی که معمولاً پیش می‌آید"
          lead="اگر سؤال دیگری دارید، مستقیم بپرسید — بدون فرم‌های واسطه."
        />
        <Button href={CONTACT.phoneHref} variant="secondary">
          تماس مستقیم
          <span class="text-caption tnum" dir="ltr">{CONTACT.phone}</span>
        </Button>
      </div>
      <div class="lg:col-span-7">
        <div class="border-t border-line">
          {homeFaq.map((item) => (
            <FAQItem question={item.q} answer={item.a} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Final CTA — memorable photographic finish ============ -->
  <CTASection
    media={{
      src: "/images/photography/workday-close-1600.webp",
      srcset:
        "/images/photography/workday-close-1600.webp 1600w, /images/photography/workday-close-800.webp 800w",
      alt: "لحظه‌ای از کار واقعی در یک آرایشگاه مردانه در مشهد",
      caption: "کار واقعی، در محیط واقعی — عکس: Mostafa Meraji (CC0)",
      width: 1600,
      height: 900,
    }}
  />
</PageLayout>
