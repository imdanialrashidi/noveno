---
/**
 * Audit page (Spec §30–32, DESIGN §11 — matrix screens 8) — the primary
 * conversion surface. Six stations, framework-free; the state machine
 * lives in src/scripts/audit.ts and this page is its static shell:
 * - two-column desktop (right: step content; left: explainer + rail),
 *   single-column mobile (rail above the card),
 * - form card: surface panel, 8px radius, 560px measure, line-strong
 *   field borders, one shadow (light theme) per DESIGN §6.3,
 * - error banner (role=alert) with DESIGN §11 copy + retry, offline
 *   variant with emphasized contact fallback,
 * - Turnstile explicit render inside the contact station,
 * - no-JS: submit disabled + noscript contact fallback (Turnstile and
 *   the journey require JavaScript by design).
 */

import PageLayout from "../layouts/PageLayout.astro";
import StepperLine from "../components/business/StepperLine.astro";
import FormField from "../components/ui/FormField.astro";
import Select from "../components/ui/Select.astro";
import MultiSelect from "../components/ui/MultiSelect.astro";
import { AUDIT_STEPS } from "../data/audit";
import { AUDIT_STATIONS, CONTACT } from "../data/site";

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
const web3formsUrl = import.meta.env.PUBLIC_WEB3FORMS_URL ?? "https://api.web3forms.com/submit";
const auditConfig = { turnstileSiteKey, web3formsKey, web3formsUrl };
---

<PageLayout
  title="بررسی مسیر جذب"
  description="چند سؤال کوتاه درباره کسب‌وکارتان تا مسیر فعلی جذب مشتری بررسی شود؛ بدون وعده فروش تضمینی. ثبت درخواست چند دقیقه وقت می‌گیرد."
  path="/audit"
>
  <section aria-labelledby="audit-title">
    <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:py-20">
      <div class="relative border-b border-line">
        <span class="section-node absolute -bottom-[3px] start-0" aria-hidden="true"></span>
        <h1 id="audit-title" class="text-h2 max-w-3xl pb-6">بررسی مسیر جذب</h1>
      </div>
      <p class="mt-6 max-w-2xl text-lead text-text-muted">
        شش ایستگاه کوتاه؛ هر چه دقیق‌تر پاسخ دهید، گفت‌وگوی اول کوتاه‌تر می‌شود.
        بدون وعده فروش تضمینی؛ ابتدا مسیر فعلی کسب‌وکار بررسی می‌شود.
      </p>
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="audit-journey-title">
    <div class="mx-auto max-w-[1200px] px-5 py-12 sm:px-8 lg:py-16">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <!-- Left rail (desktop) — explainer + StepperLine; above the card on mobile -->
        <aside class="lg:order-2 lg:col-span-5" aria-label="راهنمای بررسی">
          <div class="flex flex-col gap-8">
            <div>
              <h2 id="audit-journey-title" class="text-h3 text-text">مسیر بررسی</h2>
              <p class="mt-3 text-body text-text-muted measure-prose">
                هر ایستگاه یک سؤال کوتاه است؛ می‌توانید وسط کار بگذارید و بعداً از همان‌جا ادامه دهید.
              </p>
            </div>

            <div class="rounded-[4px] border border-line bg-surface-soft p-5">
              <StepperLine steps={AUDIT_STATIONS} current={1} />
            </div>

            <div class="flex flex-col gap-3 border-t border-line pt-6">
              <p class="text-ui font-medium text-text">ترجیح می‌دهید مستقیم صحبت کنید؟</p>
              <div class="flex flex-wrap gap-x-5 gap-y-2">
                <a href={CONTACT.phoneHref} class="inline-flex min-h-11 items-center text-ui font-medium text-accent-strong hover:text-text-action" data-event="phone_click" data-event-payload='{"section":"audit-rail"}'>
                  تماس
                  <span class="tnum" dir="ltr">{CONTACT.phone}</span>
                </a>
                <a href={CONTACT.whatsappHref} class="inline-flex min-h-11 items-center text-ui font-medium text-accent-strong hover:text-text-action" target="_blank" rel="noopener noreferrer" data-event="messaging_click" data-event-payload='{"section":"audit-rail","channel":"whatsapp"}'>
                  واتساپ
                </a>
                <a href={CONTACT.telegramHref} class="inline-flex min-h-11 items-center text-ui font-medium text-accent-strong hover:text-text-action" target="_blank" rel="noopener noreferrer" data-event="messaging_click" data-event-payload='{"section":"audit-rail","channel":"telegram"}'>
                  تلگرام
                </a>
              </div>
              <p class="text-caption text-text-faint">
                اگر همکاری مناسب نباشد، همان‌جا گفته می‌شود؛ بدون پیگیری اذیت‌کننده.
              </p>
            </div>
          </div>
        </aside>

        <!-- Form card (right on desktop, first interaction surface) -->
        <div class="lg:col-span-7">
          <div
            class="mx-auto w-full max-w-[560px] rounded-[8px] border border-line bg-surface p-6 shadow-panel sm:p-8"
            data-audit-config={JSON.stringify(auditConfig)}
          >
            <p class="sr-only" id="step-announce" aria-live="polite"></p>

            <!-- Recoverable error / offline banner (DESIGN §11) -->
            <div id="audit-banner" role="alert" hidden>
              <div data-banner="network" hidden>
                <div class="flex items-start gap-3 rounded-[4px] border border-danger/40 bg-surface p-4">
                  <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 flex-none text-danger" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 8v5" />
                    <path d="M12 16.5v.01" />
                  </svg>
                  <div class="flex flex-col gap-3">
                    <p class="text-body font-medium text-danger">ارسال نشد؛ اتصال را بررسی کنید و دوباره تلاش کنید.</p>
                    <button type="button" data-retry class="inline-flex min-h-11 w-fit items-center justify-center rounded-[4px] border border-line-strong px-5 text-ui font-medium text-text transition-colors duration-150 hover:border-primary hover:text-text-action">
                      تلاش دوباره
                    </button>
                  </div>
                </div>
              </div>

              <div data-banner="offline" hidden>
                <div class="flex items-start gap-3 rounded-[4px] border border-danger/40 bg-surface p-4">
                  <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 flex-none text-danger" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 8v5" />
                    <path d="M12 16.5v.01" />
                  </svg>
                  <div class="flex flex-col gap-3">
                    <p class="text-body font-medium text-danger">ارسال نشد؛ به اینترنت وصل نیستید. پاسخ‌ها ذخیره شده‌اند و با اتصال دوباره می‌توانید ادامه دهید.</p>
                    <p class="text-caption text-text-muted">یا مستقیم در تماس باشید:</p>
                    <div class="flex flex-wrap gap-x-5 gap-y-2">
                      <a href={CONTACT.phoneHref} class="inline-flex min-h-11 items-center text-ui font-medium text-accent-strong hover:text-text-action" data-event="phone_click" data-event-payload='{"section":"audit-banner"}'>
                        تماس <span class="tnum" dir="ltr">{CONTACT.phone}</span>
                      </a>
                      <a href={CONTACT.whatsappHref} class="inline-flex min-h-11 items-center text-ui font-medium text-accent-strong hover:text-text-action" target="_blank" rel="noopener noreferrer" data-event="messaging_click" data-event-payload='{"section":"audit-banner","channel":"whatsapp"}'>
                        واتساپ
                      </a>
                      <a href={CONTACT.telegramHref} class="inline-flex min-h-11 items-center text-ui font-medium text-accent-strong hover:text-text-action" target="_blank" rel="noopener noreferrer" data-event="messaging_click" data-event-payload='{"section":"audit-banner","channel":"telegram"}'>
                        تلگرام
                      </a>
                    </div>
                    <button type="button" data-retry class="inline-flex min-h-11 w-fit items-center justify-center rounded-[4px] border border-line-strong px-5 text-ui font-medium text-text transition-colors duration-150 hover:border-primary hover:text-text-action">
                      تلاش دوباره
                    </button>
                  </div>
                </div>
              </div>

              <div data-banner="turnstile" hidden>
                <div class="flex items-start gap-3 rounded-[4px] border border-danger/40 bg-surface p-4">
                  <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 flex-none text-danger" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 8v5" />
                    <path d="M12 16.5v.01" />
                  </svg>
                  <div class="flex flex-col gap-3">
                    <p class="text-body font-medium text-danger">بررسی امنیتی ناموفق بود؛ دوباره تلاش کنید.</p>
                    <button type="button" data-retry class="inline-flex min-h-11 w-fit items-center justify-center rounded-[4px] border border-line-strong px-5 text-ui font-medium text-text transition-colors duration-150 hover:border-primary hover:text-text-action">
                      تلاش دوباره
                    </button>
                  </div>
                </div>
              </div>

              <div data-banner="rate" hidden>
                <div class="flex items-start gap-3 rounded-[4px] border border-danger/40 bg-surface p-4">
                  <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 flex-none text-danger" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 8v5" />
                    <path d="M12 16.5v.01" />
                  </svg>
                  <p class="text-body font-medium text-danger">تعداد درخواست‌ها زیاد است؛ چند لحظه بعد دوباره تلاش کنید.</p>
                </div>
              </div>

              <div data-banner="validation" hidden>
                <div class="flex items-start gap-3 rounded-[4px] border border-danger/40 bg-surface p-4">
                  <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 flex-none text-danger" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 8v5" />
                    <path d="M12 16.5v.01" />
                  </svg>
                  <p class="text-body font-medium text-danger">یک مورد را کامل کنید.</p>
                </div>
              </div>

              <div data-banner="unconfigured" hidden>
                <div class="flex items-start gap-3 rounded-[4px] border border-danger/40 bg-surface p-4">
                  <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 flex-none text-danger" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 8v5" />
                    <path d="M12 16.5v.01" />
                  </svg>
                  <div class="flex flex-col gap-3">
                    <p class="text-body font-medium text-danger">ثبت درخواست در این لحظه در دسترس نیست؛ از راه‌های تماس مستقیم استفاده کنید.</p>
                    <div class="flex flex-wrap gap-x-5 gap-y-2">
                      <a href={CONTACT.phoneHref} class="inline-flex min-h-11 items-center text-ui font-medium text-accent-strong hover:text-text-action">
                        تماس <span class="tnum" dir="ltr">{CONTACT.phone}</span>
                      </a>
                      <a href={CONTACT.whatsappHref} class="inline-flex min-h-11 items-center text-ui font-medium text-accent-strong hover:text-text-action" target="_blank" rel="noopener noreferrer">واتساپ</a>
                      <a href={CONTACT.telegramHref} class="inline-flex min-h-11 items-center text-ui font-medium text-accent-strong hover:text-text-action" target="_blank" rel="noopener noreferrer">تلگرام</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <form id="audit-form" class="mt-6" novalidate>
              <!-- Honeypot: visually-hidden trap for form-scraping bots.
                   Humans never see or fill it; the audit script echoes its
                   (normally empty) value with the payload so the server
                   check sees real bot traffic (security review MAJOR-1). -->
              <input
                type="text"
                name="company_website"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
                class="absolute h-px w-px overflow-hidden opacity-0"
                data-honeypot
              />
              <div class="flex flex-col gap-8">
                {AUDIT_STEPS.map((step, index) => (
                  <section
                    data-step-section={step.id}
                    aria-labelledby={`step-${step.id}-title`}
                    hidden={index !== 0}
                  >
                    <h2 id={`step-${step.id}-title`} tabindex="-1" class="text-h3 text-text">
                      {step.question}
                    </h2>
                    <p class="mt-2 text-body text-text-muted">{step.description}</p>
                    <div class="mt-6 flex flex-col gap-5">
                      {step.fields.map((field) =>
                        field.kind === "select" ? (
                          <Select
                            id={field.id}
                            label={field.label}
                            options={field.options ?? []}
                            placeholder={field.placeholder}
                            optional={field.optional}
                            hint={field.hint}
                          />
                        ) : field.kind === "multiselect" ? (
                          <MultiSelect
                            id={field.id}
                            label={field.label}
                            options={field.options ?? []}
                            hint={field.hint}
                          />
                        ) : (
                          <FormField
                            id={field.id}
                            label={field.label}
                            type={field.id === "phone" ? "tel" : field.id === "email" ? "email" : field.id === "website" ? "url" : "text"}
                            placeholder={field.placeholder}
                            hint={field.hint}
                            optional={field.optional}
                            autocomplete={field.autocomplete}
                            inputmode={field.inputmode}
                            maxlength={field.maxlength}
                          />
                        ),
                      )}
                    </div>
                  </section>
                ))}
              </div>

              <!-- Turnstile renders here when the contact station is reached -->
              <div id="turnstile-container" class="mt-6"></div>

              <div class="mt-8 flex items-center justify-between gap-4">
                <button
                  type="button"
                  id="audit-back"
                  hidden
                  class="inline-flex min-h-12 items-center justify-center rounded-[4px] border border-line-strong bg-transparent px-6 font-display text-ui font-medium text-text transition-colors duration-150 hover:border-primary hover:text-text-action"
                >
                  قبلی
                </button>
                <button
                  type="button"
                  id="audit-next"
                  disabled
                  class="inline-flex min-h-12 items-center justify-center gap-2 rounded-[4px] bg-primary px-6 font-display text-ui font-medium text-on-primary transition-colors duration-150 hover:bg-primary-hover active:bg-primary-active disabled:cursor-not-allowed disabled:opacity-45"
                >
                  بعدی
                </button>
              </div>

              <p class="mt-6 text-caption text-text-faint">
                پاسخ‌ها فقط برای بررسی درخواست استفاده می‌شود.{" "}
                <a href="/privacy" class="text-link">سیاست حفظ حریم خصوصی</a>
              </p>
            </form>

            <noscript>
              <div class="mt-6 rounded-[4px] border border-line bg-surface-soft p-4">
                <p class="text-body text-text-muted">
                  برای ثبت درخواست بررسی، جاوااسکریپت لازم است. می‌توانید مستقیم تماس بگیرید:
                </p>
                <div class="mt-2 flex flex-wrap gap-x-5 gap-y-2">
                  <a href={CONTACT.phoneHref} class="inline-flex min-h-11 items-center text-ui font-medium text-accent-strong hover:text-text-action">
                    تماس <span class="tnum" dir="ltr">{CONTACT.phone}</span>
                  </a>
                  <a href={CONTACT.whatsappHref} class="inline-flex min-h-11 items-center text-ui font-medium text-accent-strong hover:text-text-action" target="_blank" rel="noopener noreferrer">واتساپ</a>
                  <a href={CONTACT.telegramHref} class="inline-flex min-h-11 items-center text-ui font-medium text-accent-strong hover:text-text-action" target="_blank" rel="noopener noreferrer">تلگرام</a>
                  <a href={CONTACT.emailHref} class="inline-flex min-h-11 items-center text-ui font-medium text-accent-strong hover:text-text-action">{CONTACT.email}</a>
                </div>
              </div>
            </noscript>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { initAudit, type AuditConfig } from "../scripts/audit";

    const card = document.querySelector<HTMLElement>("[data-audit-config]");
    let config: AuditConfig = { turnstileSiteKey: "", web3formsKey: "", web3formsUrl: "https://api.web3forms.com/submit" };
    if (card) {
      try {
        config = JSON.parse(card.getAttribute("data-audit-config") ?? "{}") as AuditConfig;
      } catch {
        /* fall back to the empty config — the journey still validates locally */
      }
    }
    initAudit(config);
  </script>
</PageLayout>
