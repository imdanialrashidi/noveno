---
/**
 * First-contact form (2026-10 focus pass — one screen instead of six
 * steps; docs/DESIGN.md §3.7). The state machine is unchanged
 * (src/scripts/audit.ts) and still drives this markup through
 * `[data-step-section]`, so the delivery semantics are identical:
 *
 * - ONE card, five questions: name, phone, business type,
 *   site-or-instagram, one problem field,
 * - a real submit path: POST /api/audit (server validation + Turnstile)
 *   and only a confirmed Web3Forms delivery completes the journey —
 *   no step counter, no back button, no fabricated answers,
 * - error banners (role=alert) for network / delivery / offline /
 *   turnstile / rate / validation / unconfigured, with retry and an
 *   always-reachable direct-contact fallback,
 * - form card: surface panel, 8px radius, 560px measure, line-strong
 *   field borders, one shadow (light theme) per DESIGN §6.3,
 * - no-JS: submit disabled + noscript contact fallback (Turnstile and
 *   the journey require JavaScript by design).
 */

import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/layout/PageHero.astro";
import ChannelLink from "../components/ui/ChannelLink.astro";
import FormField from "../components/ui/FormField.astro";
import Select from "../components/ui/Select.astro";
import NextStepsRail from "../components/business/NextStepsRail.astro";
import { AUDIT_STEPS } from "../data/audit";
import { CONTACT } from "../data/site";

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
const web3formsUrl = import.meta.env.PUBLIC_WEB3FORMS_URL ?? "https://api.web3forms.com/submit";
const auditConfig = { turnstileSiteKey, web3formsKey, web3formsUrl };

const [step] = AUDIT_STEPS;
---

<PageLayout
  title="درخواست بررسی مسیر جذب | نوونو"
  description="پنج سؤال کوتاه درباره کسب‌وکارتان تا مسیر فعلی جذب مشتری بررسی شود. بررسی اولیه رایگان است و فروش تضمین نمی‌شود."
  path="/audit"
>
  <PageHero
    id="audit-title"
    title="بررسی مسیر جذب"
    lead="پنج سؤال کوتاه، حدود دو دقیقه وقت. اول وضعیت فعلی شما را می‌بینیم، بعد درباره مسیر و هزینه حرف می‌زنیم."
  />

  <section class="border-t border-line" aria-labelledby="audit-form-title">
    <div class="mx-auto max-w-[1200px] px-5 py-12 sm:px-8 lg:py-16">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <!-- Form card (right on desktop, first interaction surface) -->
        <div class="lg:col-span-7">
          <div
            class="w-full max-w-[560px] rounded-[8px] border border-line bg-surface p-6 shadow-panel sm:p-8"
            data-audit-config={JSON.stringify(auditConfig)}
          >
            <p class="sr-only" id="step-announce" aria-live="polite"></p>

            <!-- Recoverable error / offline banner (DESIGN §11) -->
            <div id="audit-banner" role="alert" hidden>
              <div data-banner="network" hidden>
                <div class="flex items-start gap-3 rounded-[4px] border border-danger/40 bg-surface p-4">
                  <svg
                    viewBox="0 0 24 24"
                    class="mt-0.5 h-5 w-5 flex-none text-danger"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 8v5"></path>
                    <path d="M12 16.5v.01"></path>
                  </svg>
                  <div class="flex flex-col gap-3">
                    <p class="text-body font-medium text-danger">
                      ارسال نشد؛ اتصال را بررسی کنید و دوباره تلاش کنید.
                    </p>
                    <button
                      type="button"
                      data-retry
                      class="inline-flex min-h-11 w-fit items-center justify-center rounded-[4px] border border-line-strong px-5 text-ui font-medium text-text transition-colors duration-150 hover:border-primary hover:text-text-action"
                    >
                      تلاش دوباره
                    </button>
                  </div>
                </div>
              </div>

              <div data-banner="delivery" hidden>
                <div class="flex items-start gap-3 rounded-[4px] border border-danger/40 bg-surface p-4">
                  <svg
                    viewBox="0 0 24 24"
                    class="mt-0.5 h-5 w-5 flex-none text-danger"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 8v5"></path>
                    <path d="M12 16.5v.01"></path>
                  </svg>
                  <div class="flex flex-col gap-3">
                    <p class="text-body font-medium text-danger">
                      دریافت درخواست ناموفق بود؛ پاسخ‌های شما ذخیره شده‌اند. دوباره تلاش کنید یا مستقیم در
                      تماس باشید.
                    </p>
                    <div class="flex flex-wrap gap-x-5 gap-y-1">
                      <ChannelLink
                        icon="phone"
                        label={CONTACT.phone}
                        value="تماس"
                        href={CONTACT.phoneHref}
                        event={{ name: "phone_click", payload: { section: "audit-banner" } }}
                      />
                      <ChannelLink
                        icon="whatsapp"
                        label="واتساپ"
                        href={CONTACT.whatsappHref}
                        external
                        event={{
                          name: "messaging_click",
                          payload: { section: "audit-banner", channel: "whatsapp" },
                        }}
                      />
                      <ChannelLink
                        icon="telegram"
                        label="تلگرام"
                        href={CONTACT.telegramHref}
                        external
                        event={{
                          name: "messaging_click",
                          payload: { section: "audit-banner", channel: "telegram" },
                        }}
                      />
                    </div>
                    <button
                      type="button"
                      data-retry
                      class="inline-flex min-h-11 w-fit items-center justify-center rounded-[4px] border border-line-strong px-5 text-ui font-medium text-text transition-colors duration-150 hover:border-primary hover:text-text-action"
                    >
                      تلاش دوباره
                    </button>
                  </div>
                </div>
              </div>

              <div data-banner="offline" hidden>
                <div class="flex items-start gap-3 rounded-[4px] border border-danger/40 bg-surface p-4">
                  <svg
                    viewBox="0 0 24 24"
                    class="mt-0.5 h-5 w-5 flex-none text-danger"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 8v5"></path>
                    <path d="M12 16.5v.01"></path>
                  </svg>
                  <div class="flex flex-col gap-3">
                    <p class="text-body font-medium text-danger">
                      ارسال نشد؛ به اینترنت وصل نیستید. پاسخ‌ها ذخیره شده‌اند و با اتصال دوباره می‌توانید
                      ادامه دهید.
                    </p>
                    <p class="text-caption text-text-muted">یا مستقیم در تماس باشید:</p>
                    <div class="flex flex-wrap gap-x-5 gap-y-1">
                      <ChannelLink
                        icon="phone"
                        label={CONTACT.phone}
                        value="تماس"
                        href={CONTACT.phoneHref}
                        event={{ name: "phone_click", payload: { section: "audit-banner" } }}
                      />
                      <ChannelLink
                        icon="whatsapp"
                        label="واتساپ"
                        href={CONTACT.whatsappHref}
                        external
                        event={{
                          name: "messaging_click",
                          payload: { section: "audit-banner", channel: "whatsapp" },
                        }}
                      />
                      <ChannelLink
                        icon="telegram"
                        label="تلگرام"
                        href={CONTACT.telegramHref}
                        external
                        event={{
                          name: "messaging_click",
                          payload: { section: "audit-banner", channel: "telegram" },
                        }}
                      />
                    </div>
                    <button
                      type="button"
                      data-retry
                      class="inline-flex min-h-11 w-fit items-center justify-center rounded-[4px] border border-line-strong px-5 text-ui font-medium text-text transition-colors duration-150 hover:border-primary hover:text-text-action"
                    >
                      تلاش دوباره
                    </button>
                  </div>
                </div>
              </div>

              <div data-banner="turnstile" hidden>
                <div class="flex items-start gap-3 rounded-[4px] border border-danger/40 bg-surface p-4">
                  <svg
                    viewBox="0 0 24 24"
                    class="mt-0.5 h-5 w-5 flex-none text-danger"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 8v5"></path>
                    <path d="M12 16.5v.01"></path>
                  </svg>
                  <div class="flex flex-col gap-3">
                    <p class="text-body font-medium text-danger">
                      بررسی امنیتی ناموفق بود؛ دوباره تلاش کنید.
                    </p>
                    <button
                      type="button"
                      data-retry
                      class="inline-flex min-h-11 w-fit items-center justify-center rounded-[4px] border border-line-strong px-5 text-ui font-medium text-text transition-colors duration-150 hover:border-primary hover:text-text-action"
                    >
                      تلاش دوباره
                    </button>
                  </div>
                </div>
              </div>

              <div data-banner="rate" hidden>
                <div class="flex items-start gap-3 rounded-[4px] border border-danger/40 bg-surface p-4">
                  <svg
                    viewBox="0 0 24 24"
                    class="mt-0.5 h-5 w-5 flex-none text-danger"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 8v5"></path>
                    <path d="M12 16.5v.01"></path>
                  </svg>
                  <p class="text-body font-medium text-danger">
                    تعداد درخواست‌ها زیاد است؛ چند لحظه بعد دوباره تلاش کنید.
                  </p>
                </div>
              </div>

              <div data-banner="validation" hidden>
                <div class="flex items-start gap-3 rounded-[4px] border border-danger/40 bg-surface p-4">
                  <svg
                    viewBox="0 0 24 24"
                    class="mt-0.5 h-5 w-5 flex-none text-danger"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 8v5"></path>
                    <path d="M12 16.5v.01"></path>
                  </svg>
                  <p class="text-body font-medium text-danger">یک مورد را کامل کنید.</p>
                </div>
              </div>

              <div data-banner="unconfigured" hidden>
                <div class="flex items-start gap-3 rounded-[4px] border border-danger/40 bg-surface p-4">
                  <svg
                    viewBox="0 0 24 24"
                    class="mt-0.5 h-5 w-5 flex-none text-danger"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 8v5"></path>
                    <path d="M12 16.5v.01"></path>
                  </svg>
                  <div class="flex flex-col gap-3">
                    <p class="text-body font-medium text-danger">
                      ثبت درخواست در این لحظه در دسترس نیست؛ از راه‌های تماس مستقیم استفاده کنید.
                    </p>
                    <div class="flex flex-wrap gap-x-5 gap-y-1">
                      <ChannelLink icon="phone" label={CONTACT.phone} value="تماس" href={CONTACT.phoneHref} />
                      <ChannelLink icon="whatsapp" label="واتساپ" href={CONTACT.whatsappHref} external />
                      <ChannelLink icon="telegram" label="تلگرام" href={CONTACT.telegramHref} external />
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <form id="audit-form" class="mt-6" novalidate>
              <!-- Honeypot: visually-hidden trap for form-scraping bots.
                   Humans never see or fill it; the audit script echoes its
                   (normally empty) value with the payload so the server
                   check sees real bot traffic (security review MAJOR-1). -->
              <input
                type="text"
                name="company_website"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
                class="absolute h-px w-px overflow-hidden opacity-0"
                data-honeypot
              />
              <div class="flex flex-col gap-8">
                {
                  (
                    <section data-step-section={step.id} aria-labelledby={`step-${step.id}-title`}>
                      <h2 id={`step-${step.id}-title`} tabindex="-1" class="text-h3 text-text">
                        {step.question}
                      </h2>
                      <p class="mt-2 text-body text-text-muted">{step.description}</p>
                      <div class="mt-6 flex flex-col gap-5">
                        {step.fields.map((field) =>
                          field.kind === "select" ? (
                            <Select
                              id={field.id}
                              label={field.label}
                              options={field.options ?? []}
                              placeholder={field.placeholder}
                              optional={field.optional}
                              hint={field.hint}
                            />
                          ) : (
                            <FormField
                              id={field.id}
                              label={field.label}
                              type={field.id === "phone" ? "tel" : field.id === "website" ? "url" : "text"}
                              placeholder={field.placeholder}
                              hint={field.hint}
                              optional={field.optional}
                              autocomplete={field.autocomplete}
                              inputmode={field.inputmode}
                              maxlength={field.maxlength}
                            />
                          ),
                        )}
                      </div>
                    </section>
                  )
                }
              </div>

              <!-- Turnstile renders here, immediately before submit -->
              <div id="turnstile-container" class="mt-6"></div>

              <div class="mt-8">
                <button
                  type="button"
                  id="audit-next"
                  disabled
                  class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-[4px] bg-primary px-6 font-display text-ui font-medium text-on-primary transition-colors duration-150 hover:bg-primary-hover active:bg-primary-active disabled:cursor-not-allowed disabled:opacity-45"
                >
                  ثبت درخواست بررسی
                </button>
              </div>

              <p class="mt-6 text-caption text-text-faint">
                بررسی اولیه رایگان است. اطلاعات شما فقط برای همین بررسی استفاده می‌شود.{" "}
                <a href="/privacy" class="text-link">سیاست حفظ حریم خصوصی</a>
              </p>
            </form>

            <noscript>
              <div class="mt-6 rounded-[4px] border border-line bg-surface-soft p-4">
                <p class="text-body text-text-muted">
                  برای ثبت درخواست بررسی، جاوااسکریپت لازم است. می‌توانید مستقیم تماس بگیرید:
                </p>
                <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1">
                  <ChannelLink icon="phone" label={CONTACT.phone} value="تماس" href={CONTACT.phoneHref} />
                  <ChannelLink icon="whatsapp" label="واتساپ" href={CONTACT.whatsappHref} external />
                  <ChannelLink icon="telegram" label="تلگرام" href={CONTACT.telegramHref} external />
                  <ChannelLink icon="email" label={CONTACT.email} href={CONTACT.emailHref} />
                </div>
              </div>
            </noscript>
          </div>
        </div>

        <!-- Quiet sidebar — what happens next + direct contact redundancy -->
        <aside class="lg:col-span-5" aria-label="راهنمای بررسی">
          <div class="flex flex-col gap-8">
            <div>
              <h2 id="audit-form-title" class="text-h3 text-text">بعد از ثبت چه اتفاقی می‌افتد؟</h2>
              <p class="mt-3 text-body text-text-muted measure-prose">
                درخواست شما با همین پاسخ‌ها ثبت می‌شود. اولین گفت‌وگو کوتاه است و فقط برای فهمیدن وضعیت فعلی؛
                اگر همکاری مناسب نباشد همان‌جا گفته می‌شود.
              </p>
            </div>
            <NextStepsRail />

            <div class="flex flex-col gap-3 border-t border-line pt-6">
              <p class="text-ui font-medium text-text">ترجیح می‌دهید مستقیم صحبت کنید؟</p>
              <div class="flex flex-wrap gap-x-5 gap-y-1">
                <ChannelLink
                  icon="phone"
                  label={CONTACT.phone}
                  value="تماس"
                  href={CONTACT.phoneHref}
                  event={{ name: "phone_click", payload: { section: "audit-rail" } }}
                />
                <ChannelLink
                  icon="whatsapp"
                  label="واتساپ"
                  href={CONTACT.whatsappHref}
                  external
                  event={{ name: "messaging_click", payload: { section: "audit-rail", channel: "whatsapp" } }}
                />
                <ChannelLink
                  icon="telegram"
                  label="تلگرام"
                  href={CONTACT.telegramHref}
                  external
                  event={{ name: "messaging_click", payload: { section: "audit-rail", channel: "telegram" } }}
                />
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <script>
    import { initAudit, type AuditConfig } from "../scripts/audit";

    const card = document.querySelector<HTMLElement>("[data-audit-config]");
    let config: AuditConfig = {
      turnstileSiteKey: "",
      web3formsKey: "",
      web3formsUrl: "https://api.web3forms.com/submit",
    };
    if (card) {
      try {
        config = JSON.parse(card.getAttribute("data-audit-config") ?? "{}") as AuditConfig;
      } catch {
        /* fall back to the empty config — the journey still validates locally */
      }
    }
    initAudit(config);
  </script>
</PageLayout>
