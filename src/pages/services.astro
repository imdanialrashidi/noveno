---
/**
 * Services page — now «راهکارها» (the 2026-10 focus pass kept the
 * `/services` URL and moved public prices to `/pricing`). The six-stage
 * system model and the engagement steps live here, so the homepage can
 * stay short. Prices and package scope live on /pricing only.
 */

import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/ui/Button.astro";
import PageHero from "../components/layout/PageHero.astro";
import SectionHeader from "../components/layout/SectionHeader.astro";
import CTASection from "../components/layout/CTASection.astro";
import FAQItem from "../components/ui/FAQItem.astro";
import {
  toFaDigits,
  SYSTEM_COMPONENTS,
  SYSTEM_STAGES,
  GOOD_FIT,
  BAD_FIT,
  CTA_URL,
  FAQ_ITEMS,
} from "../data/site";
---

<PageLayout
  title="راهکارهای نوونو — سیستم جذب برای کسب‌وکار خدماتی"
  description="اجزای یک سیستم جذب، سه بستهٔ همکاری نوونو، و اینکه هر همکاری چطور پیش می‌رود. قیمت شروع هر بسته در صفحه قیمت."
  path="/services"
>
  <!-- Hero -->
  <PageHero
    id="services-hero-title"
    eyebrow="راهکارها"
    title="یک سیستم جذب، نه فهرست بلند خدمات"
    lead="هر همکاری با یک بررسی شروع می‌شود: مسیر فعلی جذب شما کجاست، کجا درخواست گم می‌شود، و کدام اجزا واقعاً لازم‌اند."
  >
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href={CTA_URL} size="lg">درخواست بررسی مسیر جذب</Button>
      <Button href="/pricing" variant="secondary" size="lg">دیدن قیمت‌ها</Button>
    </div>
  </PageHero>

  <!-- The offers are NOT repeated here: /pricing owns prices and scope
       (DESIGN §16.1 item 6), and this page's own meta description says
       so. The hero button is the single entry to them. -->

  <!-- Possible components -->
  <section class="border-t border-line" aria-labelledby="components-title">
    <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeader
            id="components-title"
            title="اجزای ممکن یک سیستم"
            lead="Noveno اجزای موردنیاز سیستم جذب شما را انتخاب می‌کند — نه همه اجزا را برای همه."
          />
        </div>
        <div class="lg:col-span-7">
          <ul
            class="grid grid-cols-2 gap-px overflow-hidden rounded-[4px] border border-line bg-line sm:grid-cols-3"
          >
            {
              SYSTEM_COMPONENTS.map((component) => (
                <li class="flex items-center gap-2.5 bg-canvas p-4">
                  <span
                    class="h-1.5 w-1.5 flex-none rounded-full border border-line-strong"
                    aria-hidden="true"
                  />
                  <span class="text-ui font-medium text-text">{component}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Typical engagement -->
  <section class="border-t border-line" aria-labelledby="engagement-title">
    <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:py-20">
      <SectionHeader
        id="engagement-title"
        title="همکاری معمولاً چگونه پیش می‌رود؟"
        lead="یک مسیر مشخص با نقاط تصمیم روشن؛ بدون ابهام و بدون تعهد پنهان."
      />
      <ol class="grid gap-0 border-b border-line sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            {
              title: "بررسی مسیر جذب",
              text: "چند سؤال کوتاه + گفتگو؛ تصویر دقیق از وضعیت فعلی، گلوگاه‌ها و اولویت‌ها.",
            },
            {
              title: "پیشنهاد و قیمت",
              text: "بر اساس مشکل واقعی، اجزا و محدوده مشخص می‌شود؛ پیشنهاد رسمی ۷ روز اعتبار دارد.",
            },
            {
              title: "اجرا",
              text: "فقط آنچه در محدوده توافق شده ساخته می‌شود؛ با نقاط بازبینی در طول مسیر.",
            },
            {
              title: "اندازه‌گیری و بهبود",
              text: "شاخص‌های توافق‌شده اندازه‌گیری می‌شوند و بهبودها بر اساس داده اولویت می‌گیرند.",
            },
          ].map((step, index) => (
            <li class="border-t border-line pt-5 pb-6 sm:pe-6 lg:border-s lg:border-t-0 lg:pt-0 lg:ps-6 lg:first:border-s-0 lg:first:ps-0">
              <span class="text-lg font-extrabold text-text-action tnum">
                {toFaDigits(String(index + 1).padStart(2, "0"))}
              </span>
              <h3 class="mt-2 text-ui font-semibold text-text">{step.title}</h3>
              <p class="mt-2 text-body text-text-muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- The six-stage acquisition model (owns what the homepage dropped) -->
  <section class="border-t border-line" aria-labelledby="system-title">
    <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:py-20">
      <SectionHeader
        id="system-title"
        kicker="مدل کار"
        title="شش مرحله‌ای که هر کانال از آن عبور می‌کند"
        lead="از توجه تا یادگیری. هر درخواستی که وارد می‌شود باید منبع، وضعیت و قدم بعدی داشته باشد."
      />
      <ol class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          SYSTEM_STAGES.map((stage, i) => (
            <li class="border-t-2 border-line pt-5">
              <span class="text-xl font-extrabold text-text-action tnum">
                {toFaDigits(String(i + 1).padStart(2, "0"))}
              </span>
              <h3 class="mt-2 text-h3 text-text">{stage.label}</h3>
              <p class="mt-2 text-body text-text-muted">{stage.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Qualification -->
  <section class="border-t border-line" aria-labelledby="fit-title">
    <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:py-20">
      <SectionHeader
        id="fit-title"
        title="Noveno برای همه مناسب نیست."
        lead="این صراحت به نفع هر دو طرف است؛ همکاری نامناسب برای هیچ‌کس ارزش نمی‌سازد."
      />
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="mb-5 text-ui font-semibold text-text">اگر این‌ها شبیه شماست</p>
          <ul class="flex flex-col gap-3">
            {
              GOOD_FIT.map((item) => (
                <li class="flex items-start gap-2.5 text-body text-text-muted">
                  <svg
                    viewBox="0 0 24 24"
                    class="mt-2 h-4 w-4 flex-none text-success"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="mb-5 text-ui font-semibold text-text">اگر دنبال این‌ها هستید</p>
          <ul class="flex flex-col gap-3">
            {
              BAD_FIT.map((item) => (
                <li class="flex items-start gap-2.5 text-body text-text-muted">
                  <svg
                    viewBox="0 0 24 24"
                    class="mt-2 h-4 w-4 flex-none text-text-faint"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M18 6 6 18M6 6l12 12" />
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-line" aria-labelledby="faq-title">
    <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeader id="faq-title" title="سؤال‌های رایج" />
          <Button href="/pricing" variant="secondary">دیدن قیمت‌ها</Button>
        </div>
        <div class="lg:col-span-7">
          <div class="border-t border-line">
            {FAQ_ITEMS.map((item) => <FAQItem question={item.q} answer={item.a} />)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</PageLayout>
