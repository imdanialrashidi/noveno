---
/**
 * Services page (Spec §38 architecture): Hero → Problems We Solve →
 * Audit → Lead System → Growth → Possible Components → Typical
 * Engagement → Pricing Philosophy → FAQ → CTA.
 * Offers are editorial numbered rows (DESIGN §8), never cards; pricing
 * stays scoped-after-audit with no numbers (Spec §39, plan §11).
 */

import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/ui/Button.astro";
import PageHero from "../components/layout/PageHero.astro";
import SectionHeader from "../components/layout/SectionHeader.astro";
import CTASection from "../components/layout/CTASection.astro";
import OfferRow from "../components/business/OfferRow.astro";
import FAQItem from "../components/ui/FAQItem.astro";
import { getCollection } from "astro:content";
import { isPublished, sortByDate } from "../data/insights";
import {
  toFaDigits,
  OFFERS,
  SYSTEM_COMPONENTS,
  GOOD_FIT,
  BAD_FIT,
  CTA_URL,
  PRIMARY_CTA_LABEL,
  FAQ_ITEMS,
} from "../data/site";

const latestArticle = sortByDate((await getCollection("insights")).filter(isPublished))[0] ?? null;
---

<PageLayout
  title="خدمات نوونو — بررسی مسیر جذب و سیستم جذب مشتری"
  description="سه شکل همکاری نوونو: بررسی مسیر جذب، طراحی و اجرای سیستم جذب، بهبود و همراهی ماهانه. پروژه‌ها پس از بررسی مسیر، Scope می‌شوند."
  path="/services"
>
  <!-- Hero -->
  <PageHero
    id="services-hero-title"
    eyebrow="خدمات نوونو"
    title="نه فهرست خدمات؛ سه مسیر مشخص بر اساس مشکل واقعی شما"
    lead="هر همکاری با یک بررسی شروع می‌شود: مسیر فعلی جذب شما کجاست، کجا درخواست گم می‌شود، و کدام اجزا واقعاً لازم‌اند."
  >
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href={CTA_URL} size="lg">{PRIMARY_CTA_LABEL}</Button>
      <Button href="/work" variant="secondary" size="lg">دیدن پروژه‌ها</Button>
    </div>
  </PageHero>

  <!-- Three offers as route rows -->
  <section class="border-t border-line" id="offers" aria-labelledby="offers-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <SectionHeader id="offers-title" title="سه شکل همکاری" />
      <div class="border-b border-line">
        {OFFERS.map((offer, index) => (
          <OfferRow offer={offer} index={index} href={offer.id === "audit" ? CTA_URL : "/services#offers"} />
        ))}
      </div>
    </div>
  </section>

  <!-- Possible components -->
  <section class="border-t border-line" aria-labelledby="components-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeader
            id="components-title"
            title="اجزای ممکن یک سیستم"
            lead="Noveno اجزای موردنیاز سیستم جذب شما را انتخاب می‌کند — نه همه اجزا را برای همه."
          />
        </div>
        <div class="lg:col-span-7">
          <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-[4px] border border-line bg-line sm:grid-cols-3">
            {SYSTEM_COMPONENTS.map((component) => (
              <li class="flex items-center gap-2.5 bg-canvas p-4">
                <span class="h-1.5 w-1.5 flex-none rounded-full border border-line-strong" aria-hidden="true"></span>
                <span class="text-ui font-medium text-text">{component}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Typical engagement -->
  <section class="border-t border-line" aria-labelledby="engagement-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <SectionHeader
        id="engagement-title"
        title="همکاری معمولاً چگونه پیش می‌رود؟"
        lead="یک مسیر مشخص با نقاط تصمیم روشن؛ بدون ابهام و بدون تعهد پنهان."
      />
      <ol class="grid gap-0 border-b border-line sm:grid-cols-2 lg:grid-cols-4">
        {[
          { title: "بررسی مسیر جذب", text: "چند سؤال کوتاه + گفتگو؛ تصویر دقیق از وضعیت فعلی، گلوگاه‌ها و اولویت‌ها." },
          { title: "Scope و پیشنهاد", text: "بر اساس مشکل واقعی، اجزا و محدوده مشخص می‌شود؛ پیشنهاد شفاف با خروجی‌های روشن." },
          { title: "اجرا", text: "فقط آنچه در Scope است ساخته می‌شود؛ با نقاط بازبینی در طول مسیر." },
          { title: "اندازه‌گیری و بهبود", text: "شاخص‌های توافق‌شده اندازه‌گیری می‌شوند و بهبودها بر اساس داده اولویت می‌گیرند." },
        ].map((step, index) => (
          <li class="border-t border-line pt-5 pb-6 sm:pe-6 lg:border-s lg:border-t-0 lg:pt-0 lg:ps-6 lg:first:border-s-0 lg:first:ps-0">
            <span class="text-lg font-extrabold text-text-action tnum">{toFaDigits(String(index + 1).padStart(2, "0"))}</span>
            <h3 class="mt-2 text-ui font-semibold text-text">{step.title}</h3>
            <p class="mt-2 text-body text-text-muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Pricing philosophy -->
  <section class="border-t border-line" aria-labelledby="pricing-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeader
            id="pricing-title"
            title="هزینه چگونه تعیین می‌شود؟"
            lead="پروژه‌ها پس از بررسی مسیر جذب Scope می‌شوند؛ قیمت قبل از شناخت مسئله، حدس است."
          />
        </div>
        <div class="flex flex-col gap-6 lg:col-span-7">
          <p class="text-body text-text-muted measure-prose">
            دلیل این روش ساده است: دو کسب‌وکار با «سایت می‌خواهم» ممکن است دو مشکل کاملاً متفاوت داشته باشند. یکی به یک فرم ساده نیاز دارد، دیگری به بازطراحی کل مسیر پیام. قیمت منصفانه فقط بعد از مشخص‌شدن Scope معنا دارد.
          </p>
          <ul class="flex flex-col gap-3">
            {[
              "بررسی مسیر جذب: نقطه شروع هر همکاری — با خروجی مشخص",
              "سیستم جذب: بر اساس اجزای Scope‌شده قیمت‌گذاری می‌شود",
              "بهبود ماهانه: محدوده و محتوای مشخص، بدون پشتیبانی بی‌پایان",
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-body text-text-muted">
                <span class="mt-2.5 h-1.5 w-1.5 flex-none rounded-full bg-primary" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Qualification -->
  <section class="border-t border-line" aria-labelledby="fit-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <SectionHeader id="fit-title" title="Noveno برای همه مناسب نیست." lead="این صراحت به نفع هر دو طرف است؛ همکاری نامناسب برای هیچ‌کس ارزش نمی‌سازد." />
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="mb-5 text-ui font-semibold text-text">اگر این‌ها شبیه شماست</p>
          <ul class="flex flex-col gap-3">
            {GOOD_FIT.map((item) => (
              <li class="flex items-start gap-2.5 text-body text-text-muted">
                <svg viewBox="0 0 24 24" class="mt-2 h-4 w-4 flex-none text-success" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="mb-5 text-ui font-semibold text-text">اگر دنبال این‌ها هستید</p>
          <ul class="flex flex-col gap-3">
            {BAD_FIT.map((item) => (
              <li class="flex items-start gap-2.5 text-body text-text-muted">
                <svg viewBox="0 0 24 24" class="mt-2 h-4 w-4 flex-none text-text-faint" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 6 6 18M6 6l12 12" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-line" aria-labelledby="faq-title">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-8 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeader id="faq-title" title="سؤال‌های رایج" />
        </div>
        <div class="lg:col-span-7">
          <div class="border-t border-line">
            {FAQ_ITEMS.map((item) => (
              <FAQItem question={item.q} answer={item.a} />
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial route into Insights (contextual internal linking) -->
  {latestArticle && (
    <section class="border-t border-line" aria-labelledby="services-insights-title">
      <div class="mx-auto grid max-w-[1200px] gap-10 px-5 py-14 sm:px-8 lg:grid-cols-12 lg:gap-16 lg:py-20">
        <div class="lg:col-span-5">
          <SectionHeader
            id="services-insights-title"
            kicker="دیدگاه‌ها"
            title="بیشتر دربارهٔ مسئلهٔ خودتان بخوانید"
            lead="نوشته‌های نوونو یک موضوع را با مثال و روش بررسی می‌کنند — نه با وعده."
          />
        </div>
        <div class="flex flex-col justify-center lg:col-span-7">
          <a
            href={`/insights/${latestArticle.id}`}
            class="group flex flex-col gap-2 border-t border-line py-7 transition-colors duration-150 hover:bg-surface-soft/40 sm:px-3"
          >
            <span class="text-meta text-text-faint">{latestArticle.data.category} — تازه‌ترین نوشته</span>
            <span class="text-h3 text-text transition-colors duration-150 group-hover:text-text-action">{latestArticle.data.title}</span>
            <span class="inline-flex min-h-11 w-fit items-center gap-1.5 text-ui font-medium text-accent-strong transition-colors duration-150 group-hover:text-text-action">
              خواندن نوشته
              <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform duration-150 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 12H5" />
                <path d="m12 19-7-7 7-7" />
              </svg>
            </span>
          </a>
          <Button href="/insights" variant="ghost" class="w-fit">همه نوشته‌ها</Button>
        </div>
      </div>
    </section>
  )}

  <CTASection />
</PageLayout>
