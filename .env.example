# Document required variable names only. Never add real values.
# APP_ENV: development | test | staging | production (build context)
APP_ENV=development

# --- Build-time PUBLIC values (safe to expose to the browser; real values
# --- configured in the GitHub Actions repository variables, not committed) ---

# Public site URL used for canonical/metadata (e.g. https://noveno.ir)
PUBLIC_APP_URL=
# Web3Forms access key (public by design; the browser posts leads directly)
PUBLIC_WEB3FORMS_ACCESS_KEY=
# Optional override of the Web3Forms endpoint (local testing only)
PUBLIC_WEB3FORMS_URL=

# --- Hosting ---
# Static site on GitHub Pages: no server secrets, no Turnstile secret, no
# Analytics Engine binding. The browser validates the lead and posts it to
# Web3Forms; there is no /api/* runtime.
