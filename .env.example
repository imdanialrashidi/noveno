# Document required variable names only. Never add real values.
# APP_ENV: development | test | staging | production (build context)
APP_ENV=development

# --- Build-time PUBLIC values (safe to expose to the browser; real values
# --- configured in Cloudflare Pages project settings, not committed) ---

# Public site URL used for canonical/metadata (e.g. https://noveno.ir)
PUBLIC_APP_URL=
# Cloudflare Turnstile site key (client-side; secret is server-only)
PUBLIC_TURNSTILE_SITE_KEY=
# Web3Forms access key (public by design; posts happen client-side)
PUBLIC_WEB3FORMS_ACCESS_KEY=
# Optional override of the Web3Forms endpoint (local testing only)
PUBLIC_WEB3FORMS_URL=
# Cloudflare Web Analytics beacon token (public by design)
PUBLIC_CF_ANALYTICS_TOKEN=

# --- Cloudflare Pages SECRETS (server-only; never in repo or client) ---
# Supabase project URL (https://<project>.supabase.co)
SUPABASE_URL=
# Supabase service-role key — bypasses RLS; server-only, never shipped
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile secret key (server-side siteverify)
TURNSTILE_SECRET_KEY=

# --- Cloudflare Pages binding (not an env var) ---
# NOVENO_EVENTS — Analytics Engine dataset binding, configured in the
# Pages project (dashboard or wrangler). See docs/ops/setup-checklist.md.
